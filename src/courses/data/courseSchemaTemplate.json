{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SEED-IT Course JSON Schema Specification",
  "description": "Schema definition for real SEED-IT LMS courses with Text, Video, and Video+Text modes and 2-Section 90% Gated MSAs.",
  "courseStructure": {
    "courseId": "string (unique kebab-case e.g. python-mastery)",
    "title": "string (e.g. Complete Python for Systems & Web)",
    "slug": "string",
    "category": "string (e.g. Programming, Web Dev, DSA, Core CS)",
    "level": "Beginner | Intermediate | Advanced",
    "rating": "number (e.g. 4.9)",
    "description": "string",
    "thumbnail": "string (path or url)",
    "skills": ["string", "string"],
    "modules": [
      {
        "moduleId": "string (unique e.g. mod-01-basics)",
        "title": "string (e.g. Module 1: Python Essentials)",
        "description": "string",
        "estimatedMinutes": "number (optional, calculator will compute dynamically)",
        "topics": [
          {
            "topicId": "string (unique e.g. top-1-variables)",
            "title": "string (e.g. 1.1 Variables & Memory Layout)",
            "description": "string",
            "mode": "TEXT | VIDEO | VIDEO_AND_TEXT",
            "duration": "string (MM:SS e.g. 12:45)",
            "videoUrl": "string (URL to real MP4/WebM instructor video when mode is VIDEO or VIDEO_AND_TEXT)",
            "readingTimeMinutes": "number (optional estimated reading time)",
            "checkpoints": [
              {
                "checkpointId": "string (e.g. cp-01)",
                "timeSeconds": "number (video playback timestamp in seconds where video will auto-pause)",
                "title": "string",
                "question": "string (MCQ question text)",
                "options": ["string", "string", "string", "string"],
                "correctAnswer": "number (0-based index of correct option)",
                "explanation": "string (detailed learning feedback)",
                "pauseVideo": true,
                "blockSeek": true,
                "required": true
              }
            ],
            "pages": [
              {
                "pageId": "string",
                "title": "string (page header)",
                "content": "string (markdown or plain text explanation)",
                "callout": {
                  "type": "NOTE | TIP | WARNING | IMPORTANT",
                  "title": "string",
                  "text": "string"
                },
                "illustration": {
                  "type": "MEMORY_LAYOUT | ARCHITECTURE | FLOWCHART",
                  "title": "string",
                  "caption": "string"
                },
                "codeCard": {
                  "language": "cpp | java | python | c | javascript",
                  "code": "string (demonstration code block)"
                },
                "checkpoint": {
                  "checkpointId": "string (inline checkpoint blocking next page until passed)",
                  "question": "string",
                  "options": ["string", "string", "string", "string"],
                  "correctAnswer": "number (0-based index)",
                  "explanation": "string"
                }
              }
            ],
            "practiceProblems": [
              {
                "_comment": "QUESTION BANK MAPPING: Set problemId to any question ID from SEED-IT Question Bank (e.g. 'Q1001', 'Q1002'). The compiler will automatically fetch description, constraints, starter boilerplates, and test cases from the Question Bank! You can also provide inline overrides below.",
                "problemId": "string (e.g. 'Q1001' from Question Bank)",
                "questionId": "string (optional alias e.g. 'Q1001')",
                "title": "string (e.g. 'Two Sum')",
                "difficulty": "Easy | Medium | Hard",
                "description": "string (optional if mapped to Question Bank; or custom problem statement)",
                "inputFormat": "string (optional)",
                "outputFormat": "string (optional)",
                "constraints": "string (optional)",
                "starterCode": {
                  "cpp": "string (optional custom boilerplate)",
                  "java": "string (optional custom boilerplate)",
                  "python": "string (optional custom boilerplate)",
                  "c": "string (optional custom boilerplate)"
                },
                "sampleTestCases": [
                  {
                    "input": "string",
                    "expectedOutput": "string",
                    "explanation": "string (optional)"
                  }
                ]
              }
            ]
          }
        ],
        "msa": {
          "assessmentId": "string (e.g. msa-mod-01)",
          "title": "string (e.g. Module 1 Assessment (MSA))",
          "passPercent": 90,
          "mcqSection": {
            "totalQuestions": 10,
            "durationMinutes": 20,
            "passCutoffPercent": 90,
            "questions": [
              {
                "questionId": "string (e.g. 'Q_mcq_001')",
                "question": "string",
                "options": ["string", "string", "string", "string"],
                "correctAnswer": "number (0-based index)",
                "explanation": "string"
              }
            ]
          },
          "codingSection": {
            "totalQuestions": 2,
            "durationMinutes": 30,
            "passCutoffPercent": 90,
            "problems": [
              {
                "_comment": "Can reference Question Bank by ID ('problemId': 'Q1003') or provide custom inline problem with hidden test cases for the 90% exam gate.",
                "problemId": "string (e.g. 'Q1003' or custom 'p-code-1')",
                "title": "string (e.g. 'Reverse an Array In-Place')",
                "difficulty": "Easy | Medium | Hard",
                "description": "string (detailed problem statement)",
                "inputFormat": "string",
                "outputFormat": "string",
                "constraints": "string",
                "starterCode": {
                  "cpp": "string",
                  "java": "string",
                  "python": "string",
                  "c": "string"
                },
                "sampleTestCases": [
                  {
                    "input": "string",
                    "expectedOutput": "string"
                  }
                ],
                "hiddenTestCases": [
                  {
                    "input": "string",
                    "expectedOutput": "string"
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
