      },
      "optimal": {
        "description": "Backtracking with precomputed constraints using bitmasks / sets and pre-collected empty cell coordinates for rapid candidate pruning.",
        "complexity": "O(9^m) time, O(1) auxiliary space"
      }
    }
  },
