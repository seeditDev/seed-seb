{
  "id": "maximum-population-year",
  "questionId": "maximum-population-year",
  "slug": "maximum-population-year",
  "title": "Population via Range Counting",
  "difficulty": "Medium",
  "category": "Cyclic sort",
  "patterns": [
    "cyclic sort",
    "array",
    "counting"
  ],
  "lists": [],
  "hints": [
    "years are small bounded integers, so instead of a general interval-overlap algorithm, you can index directly into an array by year, similar in spirit to placing values by their known range in cyclic sort problems",
    "for each log [birth, death], think of it as a +1 event at year birth and a -1 event at year death (since the person is no longer counted starting at death)",
    "build a delta array indexed by year, add +1 at each birth index and -1 at each death index, then sweep through years in order keeping a running total (population), which changes by exactly the delta at each year",
    "track the maximum running total seen so far and the year it was first reached, since ties should resolve to the earliest year"
  ],
  "commonMistakes": [
    "counting death as still alive, i.e. treating the interval as inclusive on both ends instead of [birth, death - 1]",
    "not resolving ties correctly (should return the earliest year at the max, not just any year at the max)",
    "forgetting to offset years to a small array index (e.g. subtracting a base year like 1950) when the actual year values are large"
  ],
  "content": {
    "problemStatement": "You're given a list of `logs` where each log is `[birth, death]`,\nrepresenting a person who was alive during every year from `birth` up to\n(but not including) `death`.\n\n**Return the earliest year that had the maximum number of people alive at once.**\n",
    "constraints": [
      "1 <= logs.length <= 100",
      "1900 <= birth[i] < death[i] <= 2050"
    ],
    "notes": [
      "overlapping logs that tie for maximum population in multiple years (return the earliest)",
      "a single log with no overlaps",
      "all logs share the exact same birth year"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "logs = [[1993, 1999], [2000, 2010]]",
        "output": "1993",
        "expectedOutput": "1993",
        "explanation": "1993-1998 each have 1 person alive, 1999 has 0 (that person died), 2000-2009 have 1 person alive. the max alive at any point is 1, and the earliest year reaching it is 1993"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "logs = [[1950, 1961], [1960, 1971], [1970, 1981]]",
        "output": "1960",
        "expectedOutput": "1960",
        "explanation": "1960 has both the first and second person alive (2 people), which is the peak; it's the earliest year reaching that peak"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "logs = [[1900, 1910]]",
        "output": "1900",
        "expectedOutput": "1900",
        "explanation": ""
