  "slug": "maximum-sum-subarray-of-size-k",
  "title": "Maximum Sum Subarray of Size K",
  "difficulty": "Easy",
  "category": "Sliding window",
  "patterns": [
    "sliding window",
    "fixed-size window"
  ],
  "lists": [],
  "hints": [
    "when the window slides over by one position, how much of the sum from the previous window is still valid?",
    "all but one element stays the same - only the element leaving the window and the element entering it changed",
    "compute the sum of the first window once, then as you slide right, subtract the element that just left and add the element that just entered",
    "track the best sum seen as you slide, rather than recomputing the whole window sum each time"
  ],
  "commonMistakes": [
    "recomputing the full window sum at every position instead of updating it incrementally",
    "off-by-one on the window boundaries, especially near the end of the array",
    "not handling k equal to the array length (only one window to consider)"
  ],
  "content": {
    "problemStatement": "You're given a list of integers `nums` and a window size `k`.\n\n**Find the maximum possible sum of any `k` consecutive elements, and return that sum.**\n",
    "constraints": [
      "1 <= k <= length of nums",
      "the window size k is fixed"
    ],
    "notes": [
      "k equals the length of the array (only one possible window)",
      "k = 1 (the answer is just the maximum single element)",
      "all negative numbers"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
