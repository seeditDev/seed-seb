  "solution": {
    "approach": "Reverse the linked list order and print space-separated values.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <stdlib.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    int *a = (int*)malloc(n * sizeof(int));\n    for (int i = 0; i < n; i++) scanf(\"%d\", &a[i]);\n    for (int i = n - 1; i >= 0; i--) {\n        if (i < n - 1) putchar(' ');\n        printf(\"%d\", a[i]);\n    }\n    putchar('\\n');\n    free(a);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n; if (cin >> n) {\n        vector<int> a(n);\n        for (int i = 0; i < n; i++) cin >> a[i];\n        for (int i = n - 1; i >= 0; i--) {\n            if (i < n - 1) cout << \" \";\n            cout << a[i];\n        }\n        cout << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            int[] a = new int[n];\n            for (int i = 0; i < n; i++) a[i] = sc.nextInt();\n            StringBuilder sb = new StringBuilder();\n            for (int i = n - 1; i >= 0; i--) {\n                if (sb.length() > 0) sb.append(\" \");\n                sb.append(a[i]);\n            }\n            System.out.println(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = [int(x) for x in sys.stdin.read().split()]\n    if toks:\n        n = toks[0]\n        arr = toks[1:1+n]\n        print(\" \".join(str(x) for x in reversed(arr)))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/).map(Number);\n    if (toks.length > 0) {\n        const n = toks[0];\n        const arr = toks.slice(1, 1 + n);\n        console.log(arr.reverse().join(\" \"));\n    }\n}\nmain();\n"
    },
