  "solution": {
    "approach": "Compute power(base, exp) using repeated multiplication loop.",
    "timeComplexity": "O(exp)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    long long base, exp;\n    if (scanf(\"%lld %lld\", &base, &exp) == 2) {\n        long long res = 1;\n        for (int i = 0; i < exp; i++) res *= base;\n        printf(\"%lld\\n\", res);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    long long base, exp;\n    if (cin >> base >> exp) {\n        long long res = 1;\n        for (int i = 0; i < exp; i++) res *= base;\n        cout << res << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLong()) {\n            long base = sc.nextLong(), exp = sc.nextLong();\n            long res = 1;\n            for (int i = 0; i < exp; i++) res *= base;\n            System.out.println(res);\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    parts = sys.stdin.read().split()\n    if len(parts) >= 2:\n        base, exp = int(parts[0]), int(parts[1])\n        print(base ** exp)\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction main() {\n    const parts = fs.readFileSync(0, 'utf-8').trim().split(/\\s+/);\n    if (parts.length >= 2) {\n        const base = BigInt(parts[0]), exp = BigInt(parts[1]);\n        console.log((base ** exp).toString());\n    }\n}\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Initialize result = 1 and multiply by base exp times."
  },
