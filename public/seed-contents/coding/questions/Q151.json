  "solution": {
    "notes": [
      "The task is primarily string parsing and ordering. A mutable-string implementation can perform the classic reverse-all-characters-then-reverse-each-word technique in O(1) auxiliary space, excluding the output buffer required by the platform interface."
    ],
    "approach": "Scan the string into words, ignoring leading, trailing, and repeated spaces, then emit the words in reverse order with one space between them. The supplied Python reference uses split() followed by reverse iteration.",
    "editorial": {
      "better": {
        "complexity": "O(n) time and O(n) space.",
        "description": "Split the string into words, discard empty pieces caused by repeated spaces, reverse the word sequence, and join it with single spaces. This directly matches the required normalization and runs in linear time."
      },
      "optimal": {
        "complexity": "O(n) time and O(1) auxiliary space for a mutable in-place representation.",
        "description": "For a mutable character array, first remove leading/trailing/repeated spaces, then reverse the entire compacted string and reverse each individual word. Reversing the whole string changes word order while reversing each word restores its characters. This achieves linear time and constant auxiliary space apart from the output/storage mandated by the mutable representation."
      },
      "bruteForce": {
        "complexity": "O(n^2) time in the worst case; O(n) space.",
        "description": "Repeatedly locate the next word and prepend it to the result. This is straightforward but can repeatedly move an increasingly large result, leading to O(n^2) time in implementations with ordinary immutable strings."
      }
    },
    "timeComplexity": "O(n), where n is the length of s.",
    "spaceComplexity": "O(n) for the stored words/output representation.",
    "code": {
      "Python3": "class Solution:\n    def reverseWords(self, s: str) -> str:\n        return \" \".join(reversed(s.split()))"
    }
  },
