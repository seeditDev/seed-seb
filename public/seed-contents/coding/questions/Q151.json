  "boilerPlates": {
    "C": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nchar* reverseWords(char* s) {\n    int n = (int)strlen(s);\n    char* temp = (char*)malloc((n + 1) * sizeof(char));\n    strcpy(temp, s);\n\n    int maxWords = n / 2 + 1;\n    char** words = (char**)malloc(maxWords * sizeof(char*));\n    int count = 0;\n\n    char* token = strtok(temp, \" \");\n    while (token != NULL) {\n        words[count++] = token;\n        token = strtok(NULL, \" \");\n    }\n\n    char* result = (char*)malloc((n + 1) * sizeof(char));\n    int pos = 0;\n    for (int i = count - 1; i >= 0; i--) {\n        if (pos > 0) result[pos++] = ' ';\n        int len = (int)strlen(words[i]);\n        memcpy(result + pos, words[i], len);\n        pos += len;\n    }\n    result[pos] = '\\0';\n\n    free(words);\n    free(temp);\n    return result;\n}\n\nint main(void) {\n    char line[10005];\n    if (!fgets(line, sizeof(line), stdin)) return 0;\n    int len = (int)strlen(line);\n    while (len > 0 && (line[len-1] == '\\n' || line[len-1] == '\\r')) line[--len] = '\\0';\n\n    char* start = strchr(line, '\"');\n    char* end = strrchr(line, '\"');\n    if (!start || !end || end <= start) return 0;\n    *end = '\\0';\n\n    char* result = reverseWords(start + 1);\n    printf(\"\\\"%s\\\"\\n\", result);\n    free(result);\n    return 0;\n}\n",
    "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nclass Solution {\npublic:\n    string reverseWords(string s) {\n        stringstream ss(s);\n        vector<string> words;\n        string word;\n        while (ss >> word) words.push_back(word);\n\n        reverse(words.begin(), words.end());\n        string ans;\n        for (int i = 0; i < (int)words.size(); ++i) {\n            if (i) ans += ' ';\n            ans += words[i];\n        }\n        return ans;\n    }\n};\n\nint main() {\n    string line;\n    getline(cin, line);\n    size_t first = line.find('\"');\n    size_t last = line.rfind('\"');\n    string s = line.substr(first + 1, last - first - 1);\n    cout << '\"' << Solution().reverseWords(s) << '\"' << '\\n';\n    return 0;\n}\n",
    "Java": "import java.io.*;\n\nclass Solution {\n    public String reverseWords(String s) {\n        String trimmed = s.trim();\n        if (trimmed.isEmpty()) return \"\";\n        String[] words = trimmed.split(\" +\");\n        StringBuilder ans = new StringBuilder();\n        for (int i = words.length - 1; i >= 0; i--) {\n            if (ans.length() > 0) ans.append(' ');\n            ans.append(words[i]);\n        }\n        return ans.toString();\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine();\n        int firstQuote = line.indexOf('\"');\n        int lastQuote = line.lastIndexOf('\"');\n        String s = line.substring(firstQuote + 1, lastQuote);\n        System.out.println(\"\\\"\" + new Solution().reverseWords(s) + \"\\\"\");\n    }\n}\n",
    "Python3": "import sys, json\n\nclass Solution:\n    def reverseWords(self, s: str) -> str:\n        return \" \".join(reversed(s.split()))\n\nif __name__ == \"__main__\":\n    args = json.loads(sys.stdin.readline())\n    print(json.dumps(Solution().reverseWords(args[0])))\n",
    "JavaScript": "'use strict';\nconst readline = require('readline');\n\nfunction reverseWords(s) {\n    return s.trim().split(/ +/).reverse().join(' ');\n}\n\nconst rl = readline.createInterface({ input: process.stdin });\nrl.on('line', line => {\n    const args = JSON.parse(line.trim());\n    console.log(JSON.stringify(reverseWords(args[0])));\n    rl.close();\n});\n"
