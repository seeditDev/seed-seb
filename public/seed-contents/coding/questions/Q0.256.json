  "solution": {
    "approach": "Print the reversed input string.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005];\n    if (fgets(s, sizeof(s), stdin)) {\n        int len = strlen(s);\n        while (len > 0 && (s[len - 1] == '\\n' || s[len - 1] == '\\r')) len--;\n        for (int i = len - 1; i >= 0; i--) putchar(s[i]);\n        putchar('\\n');\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\n#include <algorithm>\nusing namespace std;\nint main() {\n    string s; if (getline(cin, s)) {\n        while (!s.empty() && (s.back() == '\\r' || s.back() == '\\n')) s.pop_back();\n        reverse(s.begin(), s.end());\n        cout << s << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLine()) {\n            String s = sc.nextLine().replaceAll(\"[\\r\\n]\", \"\");\n            System.out.println(new StringBuilder(s).reverse().toString());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    s = sys.stdin.read().strip(\"\\r\\n\")\n    print(s[::-1])\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const s = fs.readFileSync(0, \"utf-8\").replace(/[\\r\\n]+$/, \"\");\n    console.log(s.split(\"\").reverse().join(\"\"));\n}\nmain();\n"
    },
