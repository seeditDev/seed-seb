  "solution": {
    "approach": "Find and print the largest digit present in the given integer.",
    "timeComplexity": "O(D)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    char max_c = s[0];\n    for (int i = 1; s[i]; i++) if (s[i] > max_c) max_c = s[i];\n    putchar(max_c); putchar('\\n');\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\n#include <algorithm>\nusing namespace std;\nint main() {\n    string s; if (cin >> s) cout << *max_element(s.begin(), s.end()) << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            char m = s.charAt(0);\n            for (char c : s.toCharArray()) if (c > m) m = c;\n            System.out.println(m);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks: print(max(toks[0]))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) {\n        let m = toks[0][0];\n        for (const c of toks[0]) if (c > m) m = c;\n        console.log(m);\n    }\n}\nmain();\n"
    },
