  "solution": {
    "approach": "Read a single character from standard input and print it.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    char ch;\n    if (scanf(\" %c\", &ch) == 1) {\n        printf(\"%c\\n\", ch);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    char ch;\n    if (cin >> ch) {\n        cout << ch << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            System.out.println(sc.next().charAt(0));\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        print(s[0])\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        console.log(s[0]);\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Read the first non-whitespace character from standard input and output it."
  },
