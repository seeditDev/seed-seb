  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# stack\nclass Solution(object):\n    def removeStars(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: str\n        \"\"\"\n        result = []\n        for c in s:\n            if c == '*':\n                result.pop()\n            else:\n                result.append(c)\n        return \"\".join(result)"
    },
