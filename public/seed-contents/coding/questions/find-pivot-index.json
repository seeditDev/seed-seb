        "type": "reg",
        "input": "nums = [1, 7, 3, 6, 5, 6]",
        "output": "3",
        "expectedOutput": "3",
        "explanation": "left sum 1+7+3=11 equals right sum 5+6=11"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [1, 2, 3]",
