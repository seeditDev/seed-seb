  "slug": "find-pivot-index",
  "title": "Find Pivot Index",
  "difficulty": "Easy",
  "category": "Prefix sum",
  "patterns": [
    "prefix sum"
  ],
  "lists": [],
  "hints": [
    "if you know the total sum of the whole array and the sum of everything to the left of index i, can you get the right sum without rescanning?",
    "right sum at i equals total - leftSum - nums[i]",
    "compute total first, then scan left to right keeping a running leftSum; at each index compare leftSum to total - leftSum - nums[i]",
    "add nums[i] to leftSum only after checking, since leftSum should represent everything strictly before the current index"
  ],
  "commonMistakes": [
    "including the current element in the left sum when checking equality",
    "not handling the empty-side case correctly at the first or last index",
    "returning the wrong (non-leftmost) index when multiple pivots exist"
  ],
  "content": {
    "problemStatement": "You're given an array of integers.\n\n**Find the leftmost index where the sum of all elements to the left equals the sum of all elements to the right of it, or return -1 if no such index exists.**\n\nAn empty side counts as a sum of 0.\n",
    "constraints": [
      "1 <= nums.length <= 10^4",
      "-1000 <= nums[i] <= 1000"
    ],
    "notes": [
      "the pivot is at index 0 (empty left side)",
      "the pivot is at the last index (empty right side)",
      "no pivot exists"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
