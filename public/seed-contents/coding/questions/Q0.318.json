  "solution": {
    "approach": "Convert base-26 alphabetical column title to integer.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    char s[20]; if (scanf(\"%s\", s) != 1) return 0;\n    long long ans = 0;\n    for (int i = 0; s[i]; i++) ans = ans * 26 + (s[i] - 'A' + 1);\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; if (cin >> s) {\n        long long ans = 0;\n        for (char c : s) ans = ans * 26 + (c - 'A' + 1);\n        cout << ans << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            long ans = 0;\n            for (char c : s.toCharArray()) ans = ans * 26 + (c - 'A' + 1);\n            System.out.println(ans);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    s = sys.stdin.read().strip()\n    ans = 0\n    for c in s: ans = ans * 26 + (ord(c) - ord(\"A\") + 1)\n    print(ans)\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const s = fs.readFileSync(0, \"utf-8\").trim();\n    let ans = 0n;\n    for (const c of s) ans = ans * 26n + BigInt(c.charCodeAt(0) - 64);\n    console.log(ans.toString());\n}\nmain();\n"
    },
