  "solution": {
    "approach": "Print first and last element of array separated by space.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long first_v, last_v, x;\n    for (int i = 0; i < n; i++) {\n        scanf(\"%lld\", &x);\n        if (i == 0) first_v = x;\n        if (i == n - 1) last_v = x;\n    }\n    printf(\"%lld %lld\\n\", first_v, last_v);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n    cout << a.front() << \" \" << a.back() << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long first = 0, last = 0;\n            for (int i = 0; i < n; i++) {\n                long x = sc.nextLong();\n                if (i == 0) first = x;\n                if (i == n - 1) last = x;\n            }\n            System.out.println(first + \" \" + last);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    print(f\"{toks[1]} {toks[n]}\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    console.log(`${toks[1]} ${toks[n]}`);\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Output a[0] and a[n - 1]."
  },
