{
  "id": "last-stone-weight",
  "questionId": "last-stone-weight",
  "slug": "last-stone-weight",
  "title": "Last Stone Weight",
  "difficulty": "Easy",
  "category": "Heap",
  "patterns": [
    "heap",
    "max-heap",
    "simulation"
  ],
  "lists": [],
  "hints": [
    "at every step you only care about the two heaviest stones - re-sorting the entire list each time wastes work",
    "a heap keeps the largest element accessible in O(log n) time without re-sorting everything",
    "push all stones onto a max-heap; pop the top two, smash them, and if there's a leftover push it back on",
    "stop when the heap has zero or one stone left; that remaining value (or 0) is your answer"
  ],
  "commonMistakes": [
    "using a min-heap instead of a max-heap, which finds the two lightest stones instead of the heaviest",
    "forgetting to push the leftover stone back into the heap when the two smashed stones aren't equal",
    "returning a negative or wrong value when only one stone remains from the start, instead of returning it directly"
  ],
  "content": {
    "problemStatement": "You have a pile of stones, each with a positive weight. Repeat the\nfollowing process until at most one stone remains: pick up the two\nheaviest stones (call their weights x and y, with x <= y) and smash them\ntogether. If they're equal weight, both stones are destroyed. Otherwise\nthe lighter stone is destroyed and the heavier one loses weight x,\nbecoming a new stone of weight y - x that goes back into the pile.\n\n**Return the weight of the single stone left at the end, or 0 if every\nstone was destroyed.**\n",
    "constraints": [
      "1 <= stones.length <= 30",
      "1 <= stones[i] <= 1000",
      "process continues until zero or one stones remain"
    ],
    "notes": [
      "single stone in the pile (no smashing occurs)",
      "all stones destroy each other exactly, leaving weight 0",
      "all stones have the same weight",
      "two stones only"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "stones = [2, 7, 4, 1, 8, 1]",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "8 and 7 smash to leave 1; 4 and 2 smash to leave 2; 2 and 1 smash to leave 1; the remaining two 1s smash and destroy each other, leaving a single stone of weight 1"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "stones = [1, 3]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "3 and 1 smash together, leaving a stone of weight 2"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "stones = [2, 2]",
        "output": "0",
        "expectedOutput": "0",
        "explanation": "the two equal stones destroy each other completely"
      }
    ],
