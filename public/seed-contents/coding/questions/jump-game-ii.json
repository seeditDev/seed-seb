  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "think of this like a breadth-first search over 'how far can I get in k jumps' - what does the boundary of jump k look like?",
    "as you scan through the indices reachable within your current jump budget, track the farthest index reachable with one more jump",
    "the moment your scan reaches the end of the current jump's window, you're forced to take that extra jump before continuing",
    "keep three values as you scan: current window end, farthest reach seen so far, and jump count - increment jumps and advance the window only when you hit the window end"
  ],
  "commonMistakes": [
    "confusing this with Jump Game (which only asks true/false) and forgetting to actually count jumps",
    "incrementing the jump count at every index instead of only when the current window is exhausted",
    "not realizing the last index never needs to trigger one more jump beyond what's needed to reach it"
  ],
  "content": {
    "problemStatement": "You're given a list of integers where `nums[i]` is the farthest number\nof steps you're allowed to jump forward from index i. Starting at index\n0, it's always possible to reach the last index.\n\n**Return the minimum number of jumps needed to reach the last index.**\n",
    "constraints": [
      "1 <= nums.length <= 10^4",
      "0 <= nums[i] <= 1000",
      "it is guaranteed that you can reach nums.length - 1"
    ],
    "notes": [
      "a single-element array (already at the last index, 0 jumps needed)",
      "a jump length large enough to clear the rest of the array in one move",
      "every index only allows a jump of exactly 1"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [2, 3, 1, 1, 4]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "jump 1 step to index 1, then 3 steps to reach index 4"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [1, 1, 1, 1]",
        "output": "3",
        "expectedOutput": "3",
        "explanation": "you can only move one index at a time, so it takes 3 jumps to cover 3 gaps"
      }
    ],
