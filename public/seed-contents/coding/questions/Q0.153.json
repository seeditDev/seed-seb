  "solution": {
    "approach": "Print a 2D concentric square grid based on Chebyshev distance from center.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\n#include <stdlib.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    int sz = 2 * n - 1;\n    for (int r = 0; r < sz; r++) {\n        for (int c = 0; c < sz; c++) {\n            int dr = abs(r - (n - 1)), dc = abs(c - (n - 1));\n            int d = dr > dc ? dr : dc;\n            printf(\"%d\", d + 1);\n        }\n        printf(\"\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <algorithm>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    int sz = 2 * n - 1;\n    for (int r = 0; r < sz; r++) {\n        for (int c = 0; c < sz; c++) {\n            int d = max(abs(r - (n - 1)), abs(c - (n - 1)));\n            cout << (d + 1);\n        }\n        cout << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            int sz = 2 * n - 1;\n            StringBuilder sb = new StringBuilder();\n            for (int r = 0; r < sz; r++) {\n                for (int c = 0; c < sz; c++) {\n                    int d = Math.max(Math.abs(r - (n - 1)), Math.abs(c - (n - 1)));\n                    sb.append(d + 1);\n                }\n                sb.append(\"\\n\");\n            }\n            System.out.print(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    sz = 2 * n - 1\n    for r in range(sz):\n        row = [str(max(abs(r - (n - 1)), abs(c - (n - 1))) + 1) for c in range(sz)]\n        print(\"\".join(row))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const sz = 2 * n - 1;\n    const lines = [];\n    for (let r = 0; r < sz; r++) {\n        let row = \"\";\n        for (let c = 0; c < sz; c++) {\n            const d = Math.max(Math.abs(r - (n - 1)), Math.abs(c - (n - 1)));\n            row += (d + 1);\n        }\n        lines.push(row);\n    }\n    console.log(lines.join(\"\\n\"));\n}\nmain();\n"
    },
