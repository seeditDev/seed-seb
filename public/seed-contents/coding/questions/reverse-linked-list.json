{
  "id": "reverse-linked-list",
  "questionId": "reverse-linked-list",
  "slug": "reverse-linked-list",
  "title": "Reverse Linked List",
  "difficulty": "Easy",
  "category": "Linked list",
  "patterns": [
    "linked list",
    "in-place reversal"
  ],
  "lists": [
    "blind-75",
    "grind-75"
  ],
  "hints": [
    "if you were given real nodes, what would you need to change about each node to reverse the list?",
    "each node's 'next' pointer needs to point backward instead of forward - can you do this with a single pass while keeping track of the previous node?",
    "keep a 'prev' pointer starting at null/none, and for each node set its next to prev, then advance prev and the current pointer",
    "since we represent the list as an array, the same idea just means building the output by walking from index 0 and prepending, or simply reading the array backward"
  ],
  "commonMistakes": [
    "off-by-one errors when swapping front/back indices in an in-place two-pointer swap",
    "forgetting to handle the empty list case",
    "returning the same array unreversed because the reversal was done in a variable that was never used for the return value"
  ],
  "content": {
    "problemStatement": "A singly linked list is given to you as an array `nums`, where `nums[i]`\nis the value of the i-th node in order: [n0, n1, ..., nk].\n\n**Reverse the list and return the values in their new order, [nk, ..., n1, n0].**\n",
    "constraints": [
      "0 <= nums.length <= 5000",
      "-5000 <= nums[i] <= 5000"
    ],
    "notes": [
      "an empty list",
      "a single-node list",
      "a two-node list"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [1, 2, 3, 4, 5]",
        "output": "[5, 4, 3, 2, 1]",
        "expectedOutput": "[5, 4, 3, 2, 1]",
        "explanation": "the list is reversed end to end"
