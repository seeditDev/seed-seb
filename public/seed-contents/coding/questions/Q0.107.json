  "solution": {
    "approach": "Iteratively construct pattern rows using mathematical coordinates and loop counters for pattern 107.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    // Standard solution for Q0.107\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    // Standard solution for Q0.107\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        // Standard solution for Q0.107\n    }\n}\n",
      "Python3": "import sys\n\ndef solve(inp):\n    tokens = inp.strip().split()\n    if not tokens: return ''\n    n = int(tokens[0])\n    res = []\n    c = 1\n    for i in range(1, n + 1):\n        row = [str(c + j) for j in range(i)]\n        if i % 2 == 0: row.reverse()\n        res.append('*'.join(row))\n        c += i\n    return '\\n'.join(res)\n\n\ndef main():\n    s = sys.stdin.read()\n    if s.strip():\n        print(solve(s))\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction solve(inp) {\n    const tokens = inp.trim().split(/\\s+/);\n    if (!tokens || tokens.length === 0 || tokens[0] === '') return '';\n    const n = parseInt(tokens[0], 10);\n    const res = [];\n    let c = 1;\n    for (let i = 1; i <= n; i++) {\n        const row = [];\n        for (let j = 0; j < i; j++) row.push(c + j);\n        if (i % 2 === 0) row.reverse();\n        res.push(row.join('*'));\n        c += i;\n    }\n    return res.join('\\n');\n}\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) console.log(solve(s));\n}\nmain();\n"
    },
