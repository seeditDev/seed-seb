  "solution": {
    "approach": "Calculate area of circle using the formula area = 3.14 * r * r.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    double r;\n    if (scanf(\"%lf\", &r) == 1) {\n        printf(\"%.2f\\n\", 3.14 * r * r);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <iomanip>\nusing namespace std;\n\nint main() {\n    double r;\n    if (cin >> r) {\n        cout << fixed << setprecision(2) << 3.14 * r * r << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextDouble()) {\n            double r = sc.nextDouble();\n            System.out.printf(\"%.2f\\n\", 3.14 * r * r);\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        r = float(s)\n        print(f\"{3.14 * r * r:.2f}\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const r = parseFloat(s);\n        console.log((3.14 * r * r).toFixed(2));\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Accept radius r, compute 3.14 * r * r, and print with 2 decimal digits."
  },
