{
  "id": "max-vowels-in-substring",
  "questionId": "max-vowels-in-substring",
  "slug": "max-vowels-in-substring",
  "title": "Maximum Vowels in a Substring of Given Length",
  "difficulty": "Easy",
  "category": "Sliding window",
  "patterns": [
    "sliding window",
    "fixed-size window"
  ],
  "lists": [],
  "hints": [
    "when the window slides over by one character, what actually changes about the vowel count?",
    "only two characters change status: the one leaving the window on the left, and the one entering on the right",
    "count vowels in the first k characters once, then as you slide right, subtract 1 if the outgoing character was a vowel, and add 1 if the incoming character is a vowel",
    "track the max count seen as you slide across the rest of the string"
  ],
  "commonMistakes": [
    "recounting the whole window's vowels at every position instead of updating incrementally",
    "forgetting to check the incoming character before or after updating the pointer, causing an off-by-one",
    "not treating both uppercase and lowercase as vowels if the problem's test data includes them (this version assumes lowercase input)"
  ],
  "content": {
    "problemStatement": "You're given a string `s` and a window size `k`.\n\n**Find the maximum number of vowels (a, e, i, o, u) contained in any substring of `s` with length `k`.**\n",
    "constraints": [
      "1 <= k <= length of s",
      "the window size k is fixed"
    ],
    "notes": [
      "k equals the length of the string",
      "no vowels at all",
      "the whole string is vowels"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
