    "code": {
      "Python3": "import sys\ndef main():\n    lines = sys.stdin.read().splitlines()\n    if not lines: return\n    for line in lines:\n        parts = line.split()\n        if parts:\n            try:\n                nums = [int(p) for p in parts]\n                print(sum(nums))\n            except:\n                print(' '.join(parts))\nif __name__ == '__main__': main()\n"
    }
