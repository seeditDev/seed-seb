{
  "id": "longest-common-prefix",
  "questionId": "longest-common-prefix",
  "slug": "longest-common-prefix",
  "title": "Longest Common Prefix",
  "difficulty": "Easy",
  "category": "Trie",
  "patterns": [
    "trie",
    "string"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "the common prefix is exactly the path from the root that every single word shares - what structure naturally represents shared paths between words?",
    "insert every word into a trie one character at a time",
    "starting at the root, walk down as long as the current node has exactly one child - that means every word inserted so far agrees on this next character",
    "stop walking the moment you hit a node with more than one child, or a node where some word actually ends (its prefix can't be extended further without losing that word) - the characters collected so far are the answer"
  ],
  "commonMistakes": [
    "forgetting the branch-stopping rule when a shorter word ends exactly where longer words continue, e.g. 'ab' and 'abc' should stop the prefix at 'ab'",
    "not handling the single-word case, where the whole word is trivially the answer",
    "comparing words pairwise instead of tracking a single shrinking candidate, which is correct but easy to get the indices wrong on"
  ],
  "content": {
    "problemStatement": "You're given a single space-delimited string of lowercase words.\n\n**Find the longest string that is a prefix of every word in the\nlist.**\n\nIf the words share no common starting characters, return an empty\nstring.\n",
    "constraints": [
      "1 <= number of words <= 200",
      "0 <= words[i].length <= 200",
      "words[i] consists of lowercase English letters only"
    ],
    "notes": [
      "only one word in the list (the answer is that word itself)",
      "one word is a complete prefix of all the others, e.g. 'ab abc abcd'",
      "no shared prefix at all, not even one character"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "words = \"flower flow flight\"",
        "output": "\"fl\"",
        "expectedOutput": "\"fl\"",
        "explanation": "all three words start with f, then l, then diverge (o vs i)"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "words = \"dog racecar car\"",
