{
  "id": "move-zeroes",
  "questionId": "move-zeroes",
  "slug": "move-zeroes",
  "title": "Move Zeroes",
  "difficulty": "Easy",
  "category": "Two pointers",
  "patterns": [
    "two pointers",
    "in-place array"
  ],
  "lists": [],
  "hints": [
    "can you avoid building a whole second array, and instead shift things around as you scan once?",
    "what if a slow pointer marked 'the next spot a non-zero value belongs', and a fast pointer looked for non-zero values to put there?",
    "walk the array with a fast pointer; every time you find a non-zero value, place it at the slow pointer's position and advance slow",
    "once the fast pointer reaches the end, every position from the slow pointer onward should become zero"
  ],
  "commonMistakes": [
    "swapping instead of overwriting when it isn't needed, or forgetting to zero out the remaining tail after placing all non-zero values",
    "changing the relative order of the non-zero elements",
    "allocating a second array when the point is to do it with two pointers over the same pass"
  ],
  "content": {
    "problemStatement": "You're given a list of numbers `nums`.\n\n**Return the list with every zero moved to the end, while every non-zero number keeps its original relative order.**\n\nDo it in a single pass, without allocating a second array to build the answer in.\n",
    "constraints": [
      "0 <= nums.length <= 10^4",
      "-2^31 <= nums[i] <= 2^31 - 1",
      "nums may contain any mix of positive, negative, and zero values"
    ],
    "notes": [
      "no zeroes at all (array unchanged)",
      "all zeroes",
      "zeroes already at the end"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
