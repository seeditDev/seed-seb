  "solution": {
    "approach": "Print numbers from 1 to n separated by space.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int n;\n    if (scanf(\"%d\", &n) == 1) {\n        for (int i = 1; i <= n; i++) {\n            printf(\"%d%s\", i, (i == n ? \"\" : \" \"));\n        }\n        printf(\"\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int n;\n    if (cin >> n) {\n        for (int i = 1; i <= n; i++) {\n            cout << i << (i == n ? \"\" : \" \");\n        }\n        cout << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            StringBuilder sb = new StringBuilder();\n            for (int i = 1; i <= n; i++) {\n                if (i > 1) sb.append(\" \");\n                sb.append(i);\n            }\n            System.out.println(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        n = int(s)\n        print(' '.join(str(i) for i in range(1, n + 1)))\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const n = parseInt(s, 10);\n        const arr = [];\n        for (let i = 1; i <= n; i++) arr.push(i);\n        console.log(arr.join(' '));\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Generate sequence 1, 2, ..., n and join with spaces."
  },
