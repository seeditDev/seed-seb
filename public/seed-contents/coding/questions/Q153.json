  "content": {
    "problemStatement": "An array of distinct integers, originally sorted in ascending order, has\nbeen rotated an unknown number of positions to the right.\n\n**Return the minimum element in the array.**\n\nYou must do this faster than a plain linear scan.",
    "constraints": [
      "1 <= nums.length <= 5000",
      "-5000 <= nums[i] <= 5000",
      "all integers in nums are unique",
      "nums is sorted in ascending order and rotated between 1 and nums.length times"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [3, 4, 5, 1, 2]",
        "output": "1",
        "explanation": "the array was [1,2,3,4,5] rotated so 1 ended up after 5"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [4, 5, 6, 7, 0, 1, 2]",
        "output": "0",
        "explanation": ""
