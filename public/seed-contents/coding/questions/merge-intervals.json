{
  "id": "merge-intervals",
  "questionId": "merge-intervals",
  "slug": "merge-intervals",
  "title": "Merge Intervals",
  "difficulty": "Medium",
  "category": "Merge intervals",
  "patterns": [
    "merge intervals",
    "sorting"
  ],
  "lists": [
    "blind-75",
    "grind-75",
    "interview-150"
  ],
  "hints": [
    "if the intervals were already sorted by start time, could an interval possibly overlap one that's far away in the list?",
    "sort the intervals by start time first - this guarantees any overlap involves adjacent intervals in the sorted order",
    "sweep through the sorted list, keeping a 'current merged interval'. compare each next interval's start to the current merged interval's end",
    "if the next interval's start is less than or equal to the current end, extend the current merged interval's end to the max of the two ends; otherwise close off the current merged interval and start a new one"
  ],
  "commonMistakes": [
    "forgetting to sort the input first, which breaks the adjacency assumption the sweep relies on",
    "using strict less-than instead of less-than-or-equal when comparing start to end, missing merges for touching intervals like [1,4] and [4,5]",
    "taking the new interval's end directly instead of max(currentEnd, newEnd), which drops coverage when a later interval is fully contained in the current one"
  ],
  "content": {
    "problemStatement": "You're given a list of `intervals`, each represented as `[start, end]`.\n\n**Merge all overlapping intervals and return a list of the non-overlapping intervals that cover exactly the same total range as the input.**\n",
    "constraints": [
      "0 <= intervals.length <= 10^4",
      "intervals[i].length == 2",
      "0 <= start <= end <= 10^4"
    ],
    "notes": [
      "empty list of intervals",
      "a single interval",
      "all intervals overlap into one merged interval",
      "no intervals overlap at all",
      "intervals that only touch at an endpoint",
      "input given out of sorted order"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
