        "type": "reg",
        "input": "tree = [3, 5, 1, 6, 2, 0, 8, -101, -101, 7, 4], target = 5, k = 2",
        "output": "[1, 4, 7]",
        "expectedOutput": "[1, 4, 7]",
        "explanation": "from node 5, distance 1 reaches 3 (parent), 6 and 2 (children); distance 2 from there reaches 1 (3's other child), 7 and 4 (2's children)"
      },
      {
        "id": "sample_2",
