  "content": {
    "problemStatement": "You're given a list of positive integers `nums`, where every element must belong to exactly one of two subsets.\n\n**Determine whether it's possible to split the list into two subsets such that the sum of elements in each subset is equal.**",
    "constraints": [
      "1 <= nums.length <= 200",
      "1 <= nums[i] <= 100",
      "the sum of all elements in nums does not exceed 20000"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [1, 5, 11, 5]",
        "output": "true",
        "explanation": "one subset is [1, 5, 5] summing to 11, the other is [11] also summing to 11"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [1, 2, 3, 5]",
        "output": "false",
        "explanation": "the total sum is 11, which is odd, so it can never be split into two equal halves"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "nums = [1, 2, 3, 4]",
        "output": "true",
        "explanation": "one subset is [1, 4] summing to 5, the other is [2, 3] also summing to 5"
      }
    ],
