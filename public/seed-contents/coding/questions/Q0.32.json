  "solution": {
    "approach": "Check if integer is odd or even using modulo 2.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int n;\n    if (scanf(\"%d\", &n) == 1) {\n        printf(\"%s\\n\", (n % 2 == 0) ? \"Even\" : \"Odd\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int n;\n    if (cin >> n) {\n        cout << (n % 2 == 0 ? \"Even\" : \"Odd\") << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            System.out.println(sc.nextInt() % 2 == 0 ? \"Even\" : \"Odd\");\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        print(\"Even\" if int(s) % 2 == 0 else \"Odd\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        console.log(parseInt(s, 10) % 2 === 0 ? \"Even\" : \"Odd\");\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "If N % 2 == 0 print 'Even', otherwise print 'Odd'."
  },
