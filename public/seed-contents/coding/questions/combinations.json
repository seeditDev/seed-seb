{
  "id": "combinations",
  "questionId": "combinations",
  "slug": "combinations",
  "title": "Combinations",
  "difficulty": "Easy",
  "category": "Backtracking",
  "patterns": [
    "backtracking"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "since each combination must be listed in increasing order, once you decide to move past a number you never need to look at it again for this branch",
    "recurse with a 'start' parameter: at each call, try adding every number from start to n, then recurse with start + 1 for the next position",
    "stop and record the current combination once it has exactly k numbers in it",
    "after trying a number and recursing, remove it from the current combination before trying the next candidate at that position - that's the backtrack step"
  ],
  "commonMistakes": [
    "not using a start index, which lets combinations be generated out of order or with repeated numbers",
    "forgetting to stop recursing once the current combination already has k elements, wasting work",
    "off-by-one on the range, e.g. looping to n exclusive instead of inclusive"
  ],
  "content": {
    "problemStatement": "You're given two integers, `n` and `k`.\n\n**Return every possible combination of `k` distinct numbers chosen from 1 to `n` (inclusive).**\n\nEach combination should list its numbers in increasing order. The combinations themselves can be returned in any order relative to each other.\n",
    "constraints": [
      "1 <= n <= 20",
      "1 <= k <= n"
    ],
    "notes": [
      "k equals n (only one combination: all numbers)",
      "k equals 1 (n combinations, one per number)",
      "n is small and k is close to n"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
