  "solution": {
    "approach": "Compute digital root of integer N.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    long long n; if (scanf(\"%lld\", &n) != 1) return 0;\n    if (n == 0) printf(\"0\\n\");\n    else printf(\"%lld\\n\", (n - 1) % 9 + 1);\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    long long n; if (cin >> n) {\n        if (n == 0) cout << \"0\\n\";\n        else cout << (n - 1) % 9 + 1 << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLong()) {\n            long n = sc.nextLong();\n            System.out.println(n == 0 ? 0 : (n - 1) % 9 + 1);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks:\n        n = int(toks[0])\n        print(0 if n == 0 else (n - 1) % 9 + 1)\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) {\n        const n = BigInt(toks[0]);\n        console.log(n === 0n ? \"0\" : ((n - 1n) % 9n + 1n).toString());\n    }\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Use formula (N - 1) % 9 + 1 for N > 0, or 0 if N == 0."
  },
