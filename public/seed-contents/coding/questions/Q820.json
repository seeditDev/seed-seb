    "JavaScript": "const readline = require(\"readline\");\n\nfunction minimumLengthEncoding(words) {\n    const unique = [...new Set(words)];\n    const trie = [];\n    const makeNode = () => {\n        const node = { child: new Array(26).fill(-1), terminal: false };\n        trie.push(node);\n        return trie.length - 1;\n    };\n\n    makeNode();\n\n    for (const word of unique) {\n        let cur = 0;\n        for (let i = word.length - 1; i >= 0; --i) {\n            const c = word.charCodeAt(i) - 97;\n            if (trie[cur].child[c] === -1) {\n                trie[cur].child[c] = makeNode();\n            }\n            cur = trie[cur].child[c];\n        }\n        trie[cur].terminal = true;\n    }\n\n    function dfs(u, depth) {\n        let hasChild = false;\n        let sum = 0;\n        for (let c = 0; c < 26; ++c) {\n            const v = trie[u].child[c];\n            if (v !== -1) {\n                hasChild = true;\n                sum += dfs(v, depth + 1);\n            }\n        }\n        if (!hasChild && trie[u].terminal) {\n            return depth + 1;\n        }\n        return sum;\n    }\n\n    return dfs(0, 0);\n}\n\nconst rl = readline.createInterface({ input: process.stdin, output: process.stdout });\nrl.on(\"line\", (line) => {\n    const args = JSON.parse(line.trim());\n    console.log(JSON.stringify(minimumLengthEncoding(args[0])));\n    rl.close();\n});\n"
