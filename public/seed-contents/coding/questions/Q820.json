  "boilerPlates": {
    "C": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdbool.h>\n\ntypedef struct {\n    int child[26];\n    bool terminal;\n} TrieNode;\n\nstatic void init_node(TrieNode *node) {\n    for (int i = 0; i < 26; ++i) node->child[i] = -1;\n    node->terminal = false;\n}\n\nstatic int dfs(TrieNode *trie, int u, int depth) {\n    bool has_child = false;\n    int sum = 0;\n\n    for (int c = 0; c < 26; ++c) {\n        int v = trie[u].child[c];\n        if (v != -1) {\n            has_child = true;\n            sum += dfs(trie, v, depth + 1);\n        }\n    }\n\n    if (!has_child && trie[u].terminal) return depth + 1;\n    return sum;\n}\n\nint minimumLengthEncoding(char **words, int wordsSize) {\n    int capacity = wordsSize * 8 + 1;\n    TrieNode *trie = (TrieNode *)malloc((size_t)capacity * sizeof(TrieNode));\n    if (!trie) return 0;\n\n    int count = 1;\n    init_node(&trie[0]);\n\n    for (int i = 0; i < wordsSize; ++i) {\n        int cur = 0;\n        int len = (int)strlen(words[i]);\n\n        for (int j = len - 1; j >= 0; --j) {\n            int c = words[i][j] - 'a';\n            if (trie[cur].child[c] == -1) {\n                if (count >= capacity) {\n                    free(trie);\n                    return 0;\n                }\n                trie[cur].child[c] = count;\n                init_node(&trie[count]);\n                ++count;\n            }\n            cur = trie[cur].child[c];\n        }\n        trie[cur].terminal = true;\n    }\n\n    int answer = dfs(trie, 0, 0);\n    free(trie);\n    return answer;\n}\n\nstatic char **parse_words(const char *line, int *count) {\n    int capacity = 16;\n    char **words = (char **)malloc((size_t)capacity * sizeof(char *));\n    *count = 0;\n\n    for (int i = 0; line[i] != '\\0'; ++i) {\n        if (line[i] != '\"') continue;\n\n        int start = ++i;\n        while (line[i] != '\\0' && line[i] != '\"') ++i;\n        if (line[i] != '\"') break;\n\n        int len = i - start;\n        char *word = (char *)malloc((size_t)len + 1);\n        memcpy(word, line + start, (size_t)len);\n        word[len] = '\\0';\n\n        if (*count >= capacity) {\n            capacity *= 2;\n            words = (char **)realloc(words, (size_t)capacity * sizeof(char *));\n        }\n        words[*count] = word;\n        (*count)++;\n    }\n\n    return words;\n}\n\nint main(void) {\n    char line[30000];\n    if (!fgets(line, sizeof(line), stdin)) return 0;\n\n    int wordsSize = 0;\n    char **words = parse_words(line, &wordsSize);\n    int result = minimumLengthEncoding(words, wordsSize);\n    printf(\"%d\\n\", result);\n\n    for (int i = 0; i < wordsSize; ++i) free(words[i]);\n    free(words);\n    return 0;\n}\n",
    "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Node {\n    int child[26];\n    bool terminal;\n\n    Node() {\n        fill(child, child + 26, -1);\n        terminal = false;\n    }\n};\n\nclass Solution {\n    vector<Node> trie;\n\n    int dfs(int u, int depth) {\n        bool hasChild = false;\n        int sum = 0;\n        for (int c = 0; c < 26; ++c) {\n            int v = trie[u].child[c];\n            if (v != -1) {\n                hasChild = true;\n                sum += dfs(v, depth + 1);\n            }\n        }\n        if (!hasChild && trie[u].terminal) return depth + 1;\n        return sum;\n    }\n\npublic:\n    int minimumLengthEncoding(vector<string>& words) {\n        unordered_set<string> unique(words.begin(), words.end());\n        trie.clear();\n        trie.emplace_back();\n\n        for (const string& word : unique) {\n            int cur = 0;\n            for (int i = (int)word.size() - 1; i >= 0; --i) {\n                int c = word[i] - 'a';\n                if (trie[cur].child[c] == -1) {\n                    trie[cur].child[c] = (int)trie.size();\n                    trie.emplace_back();\n                }\n                cur = trie[cur].child[c];\n            }\n            trie[cur].terminal = true;\n        }\n\n        return dfs(0, 0);\n    }\n};\n\nstatic vector<string> parseWords(const string& line) {\n    vector<string> words;\n    for (size_t i = 0; i < line.size(); ++i) {\n        if (line[i] != '\"') continue;\n        size_t start = ++i;\n        while (i < line.size() && line[i] != '\"') ++i;\n        if (i <= line.size()) words.push_back(line.substr(start, i - start));\n    }\n    return words;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    vector<string> words = parseWords(line);\n    cout << Solution().minimumLengthEncoding(words) << '\\n';\n    return 0;\n}\n",
    "Java": "import java.io.*;\nimport java.util.*;\n\nclass Solution {\n    private static class Node {\n        int[] child = new int[26];\n        boolean terminal;\n        Node() {\n            Arrays.fill(child, -1);\n            terminal = false;\n        }\n    }\n\n    private final ArrayList<Node> trie = new ArrayList<>();\n\n    private int newNode() {\n        trie.add(new Node());\n        return trie.size() - 1;\n    }\n\n    private void insert(String word) {\n        int cur = 0;\n        for (int i = word.length() - 1; i >= 0; --i) {\n            int c = word.charAt(i) - 'a';\n            if (trie.get(cur).child[c] == -1) {\n                trie.get(cur).child[c] = newNode();\n            }\n            cur = trie.get(cur).child[c];\n        }\n        trie.get(cur).terminal = true;\n    }\n\n    private int dfs(int u, int depth) {\n        boolean hasChild = false;\n        int sum = 0;\n        for (int c = 0; c < 26; ++c) {\n            int v = trie.get(u).child[c];\n            if (v != -1) {\n                hasChild = true;\n                sum += dfs(v, depth + 1);\n            }\n        }\n        if (!hasChild && trie.get(u).terminal) {\n            return depth + 1;\n        }\n        return sum;\n    }\n\n    public int minimumLengthEncoding(String[] words) {\n        trie.clear();\n        newNode();\n        for (String word : new HashSet<>(Arrays.asList(words))) {\n            insert(word);\n        }\n        return dfs(0, 0);\n    }\n}\n\npublic class Main {\n    private static String[] parseWords(String line) {\n        ArrayList<String> words = new ArrayList<>();\n        int i = 0;\n        while (i < line.length()) {\n            if (line.charAt(i) == '\"') {\n                int start = ++i;\n                while (i < line.length() && line.charAt(i) != '\"') i++;\n                words.add(line.substring(start, i));\n            }\n            i++;\n        }\n        return words.toArray(new String[0]);\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine();\n        String[] words = parseWords(line);\n        System.out.println(new Solution().minimumLengthEncoding(words));\n    }\n}\n",
