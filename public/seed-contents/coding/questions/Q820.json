  "solution": {
    "notes": [
      "Reversing the words turns suffix relationships into prefix relationships in the trie.",
      "A terminal trie node with no children corresponds to a word that contributes len(word) + 1 to the encoding.",
      "The trailing '#' is counted once for each encoded group."
    ],
    "approach": "Build a trie from the words in reverse order. A word must be stored as a separate encoded segment exactly when its reversed path ends at a trie leaf, meaning no other word has it as a suffix. Duplicates are removed first because repeating a word never increases the shortest encoding length.",
    "editorial": {
      "better": {
        "complexity": "O(S * L) expected time and O(S) space, with L <= 7 and S the total length of distinct words.",
        "description": "Store all distinct words in a hash set. For each word, generate its proper suffixes and check whether any suffix is present; only words with no matching longer word contribute to the answer."
      },
      "optimal": {
        "complexity": "O(S) expected time and O(S) space.",
        "description": "Insert every distinct word in reverse into a trie. When the insertion ends at a node with no children, that word is not a suffix of any other word and contributes len(word) + 1. Reverse insertion converts suffix detection into a prefix-trie lookup."
      },
      "bruteForce": {
        "complexity": "O(u^2 * L) time and O(u) auxiliary space, where u is the number of distinct words and L <= 7.",
        "description": "Deduplicate the words, then compare every pair to determine whether one word is a suffix of another. Add len(word) + 1 only for words that are not suffixes of a longer word."
      }
    },
    "timeComplexity": "O(S) expected, where S is the total number of characters across all distinct words.",
    "spaceComplexity": "O(S) for the reversed trie and the deduplicated word set.",
    "code": {
      "Python3": "import sys\nimport json\n\nclass Solution:\n    def minimumLengthEncoding(self, words):\n        words = set(words)\n        root = {}\n        terminal_nodes = []\n\n        for word in words:\n            node = root\n            for ch in reversed(word):\n                if ch not in node:\n                    node[ch] = {}\n                node = node[ch]\n            terminal_nodes.append((word, node))\n\n        ans = 0\n        for word, node in terminal_nodes:\n            if not node:\n                ans += len(word) + 1\n        return ans"
    }
  },
