{
  "id": "merge-accounts-by-id",
  "questionId": "merge-accounts-by-id",
  "slug": "merge-accounts-by-id",
  "title": "Merge Accounts by Id",
  "difficulty": "Medium",
  "category": "Union find",
  "patterns": [
    "union find",
    "connected components"
  ],
  "lists": [
    "grind-75"
  ],
  "hints": [
    "start by assuming all n accounts are distinct people",
    "each same-person pair either merges two previously-separate people, or confirms something you already know",
    "union the two accounts in each pair; track how many merges actually reduced the component count",
    "the answer is n minus the number of merges that combined two different components"
  ],
  "commonMistakes": [
    "decrementing the people count even when a pair's two accounts were already merged",
    "forgetting accounts with no relationships still count as their own person",
    "not using path compression, which slows down find() on long merge chains"
  ],
  "content": {
    "problemStatement": "A service has `n` accounts, numbered 0 to n-1. Some pairs of accounts are\nknown to belong to the same real person (this relationship is transitive:\nif account A and B belong to the same person, and B and C belong to the\nsame person, then A and C do too). You're given the list of known\nsame-person pairs, `samePerson`.\n\n**Return the number of distinct people once all accounts have been merged according to these relationships.**\n",
    "constraints": [
      "1 <= n <= 10^5",
      "0 <= samePerson.length <= 10^5",
      "samePerson[i].length == 2",
      "0 <= samePerson[i][0], samePerson[i][1] < n"
    ],
    "notes": [
      "no relationships at all - every account is a distinct person",
      "a single account",
      "a long chain of pairs that all merge into one person",
      "a relationship pair listed more than once"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "n = 5, samePerson = [[0,1],[1,2],[3,4]]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "accounts 0, 1, 2 belong to one person; accounts 3, 4 belong to another"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "n = 6, samePerson = [[0,1],[2,3]]",
        "output": "4",
        "expectedOutput": "4",
        "explanation": "two merged pairs plus two untouched accounts (4 and 5) each on their own"
      },
      {
