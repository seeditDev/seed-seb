  "solution": {
    "approach": "Split string into last part from index 5 and first 5 characters separated by space.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    printf(\"%s \", s + 5);\n    for (int i = 0; i < 5; i++) putchar(s[i]);\n    putchar('\\n');\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; if (cin >> s) cout << s.substr(5) << \" \" << s.substr(0, 5) << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            System.out.println(s.substring(5) + \" \" + s.substring(0, 5));\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks:\n        s = toks[0]\n        print(s[5:] + \" \" + s[:5])\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) {\n        const s = toks[0];\n        console.log(s.slice(5) + \" \" + s.slice(0, 5));\n    }\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Print substring from index 5 onward, a space, and first 5 characters."
  },
