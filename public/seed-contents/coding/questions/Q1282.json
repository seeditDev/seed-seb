  "boilerPlates": {
    "C": "#include <stdio.h>\n#include <stdlib.h>\n\nstatic int* parse_ints(const char* s, int* count) {\n    int capacity = 16;\n    int size = 0;\n    int* values = (int*)malloc((size_t)capacity * sizeof(int));\n    if (!values) exit(EXIT_FAILURE);\n\n    for (const char* p = s; *p != '\\0'; ) {\n        while (*p != '\\0' && *p != '-' && (*p < '0' || *p > '9')) p++;\n        if (*p == '\\0') break;\n\n        char* end = NULL;\n        long value = strtol(p, &end, 10);\n        if (end == p) break;\n\n        if (size == capacity) {\n            capacity *= 2;\n            int* grown = (int*)realloc(values, (size_t)capacity * sizeof(int));\n            if (!grown) {\n                free(values);\n                exit(EXIT_FAILURE);\n            }\n            values = grown;\n        }\n        values[size++] = (int)value;\n        p = end;\n    }\n\n    *count = size;\n    return values;\n}\n\nstatic int** groupThePeople(\n    const int* groupSizes,\n    int n,\n    int* returnSize,\n    int** returnColumnSizes\n) {\n    int** buckets = (int**)calloc((size_t)n + 1, sizeof(int*));\n    int* bucketCounts = (int*)calloc((size_t)n + 1, sizeof(int));\n    int** result = (int**)malloc((size_t)n * sizeof(int*));\n    int* columnSizes = (int*)malloc((size_t)n * sizeof(int));\n\n    if (!buckets || !bucketCounts || !result || !columnSizes) {\n        free(buckets);\n        free(bucketCounts);\n        free(result);\n        free(columnSizes);\n        exit(EXIT_FAILURE);\n    }\n\n    int resultCount = 0;\n\n    for (int person = 0; person < n; person++) {\n        int size = groupSizes[person];\n        int count = bucketCounts[size];\n\n        if (count == 0) {\n            buckets[size] = (int*)malloc((size_t)size * sizeof(int));\n            if (!buckets[size]) exit(EXIT_FAILURE);\n        }\n\n        buckets[size][count] = person;\n        bucketCounts[size] = count + 1;\n\n        if (bucketCounts[size] == size) {\n            result[resultCount] = buckets[size];\n            columnSizes[resultCount] = size;\n            resultCount++;\n            buckets[size] = NULL;\n            bucketCounts[size] = 0;\n        }\n    }\n\n    free(buckets);\n    free(bucketCounts);\n    *returnSize = resultCount;\n    *returnColumnSizes = columnSizes;\n    return result;\n}\n\nint main(void) {\n    char line[200000];\n    if (!fgets(line, sizeof(line), stdin)) return 1;\n\n    int n = 0;\n    int* groupSizes = parse_ints(line, &n);\n\n    int returnSize = 0;\n    int* returnColumnSizes = NULL;\n    int** result = groupThePeople(groupSizes, n, &returnSize, &returnColumnSizes);\n\n    printf(\"[\");\n    for (int i = 0; i < returnSize; i++) {\n        if (i > 0) printf(\",\");\n        printf(\"[\");\n        for (int j = 0; j < returnColumnSizes[i]; j++) {\n            if (j > 0) printf(\",\");\n            printf(\"%d\", result[i][j]);\n        }\n        printf(\"]\");\n    }\n    printf(\"]\\n\");\n\n    for (int i = 0; i < returnSize; i++) free(result[i]);\n    free(result);\n    free(returnColumnSizes);\n    free(groupSizes);\n    return 0;\n}\n",
    "C++": "#include <iostream>\n#include <regex>\n#include <string>\n#include <vector>\n#include <iterator>\nusing namespace std;\n\nclass Solution {\npublic:\n    vector<vector<int>> groupThePeople(const vector<int>& groupSizes) {\n        const int n = static_cast<int>(groupSizes.size());\n        vector<vector<int>> buckets(n + 1);\n        vector<vector<int>> result;\n\n        for (int person = 0; person < n; ++person) {\n            int size = groupSizes[person];\n            buckets[size].push_back(person);\n\n            if (static_cast<int>(buckets[size].size()) == size) {\n                result.push_back(buckets[size]);\n                buckets[size].clear();\n            }\n        }\n        return result;\n    }\n};\n\nint main() {\n    string line;\n    getline(cin, line);\n\n    regex number(R\"(-?\\d+)\");\n    sregex_iterator it(line.begin(), line.end(), number);\n    sregex_iterator end;\n\n    vector<int> groupSizes;\n    for (; it != end; ++it) {\n        groupSizes.push_back(stoi(it->str()));\n    }\n\n    vector<vector<int>> result = Solution().groupThePeople(groupSizes);\n\n    cout << \"[\";\n    for (size_t i = 0; i < result.size(); ++i) {\n        if (i > 0) cout << \",\";\n        cout << \"[\";\n        for (size_t j = 0; j < result[i].size(); ++j) {\n            if (j > 0) cout << \",\";\n            cout << result[i][j];\n        }\n        cout << \"]\";\n    }\n    cout << \"]\\n\";\n    return 0;\n}\n",
    "Java": "import java.io.*;\nimport java.util.*;\nimport java.util.regex.*;\n\n@SuppressWarnings(\"unchecked\")\nclass Solution {\n    public List<List<Integer>> groupThePeople(int[] groupSizes) {\n        List<Integer>[] buckets = new ArrayList[groupSizes.length + 1];\n        List<List<Integer>> result = new ArrayList<>();\n\n        for (int person = 0; person < groupSizes.length; person++) {\n            int size = groupSizes[person];\n            if (buckets[size] == null) {\n                buckets[size] = new ArrayList<>();\n            }\n            buckets[size].add(person);\n\n            if (buckets[size].size() == size) {\n                result.add(new ArrayList<>(buckets[size]));\n                buckets[size] = null;\n            }\n        }\n        return result;\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine();\n        Matcher matcher = Pattern.compile(\"-?\\\\d+\").matcher(line);\n        List<Integer> values = new ArrayList<>();\n        while (matcher.find()) {\n            values.add(Integer.parseInt(matcher.group()));\n        }\n\n        int[] groupSizes = new int[values.size()];\n        for (int i = 0; i < values.size(); i++) {\n            groupSizes[i] = values.get(i);\n        }\n\n        List<List<Integer>> result = new Solution().groupThePeople(groupSizes);\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < result.size(); i++) {\n            if (i > 0) sb.append(',');\n            sb.append('[');\n            for (int j = 0; j < result.get(i).size(); j++) {\n                if (j > 0) sb.append(',');\n                sb.append(result.get(i).get(j));\n            }\n            sb.append(']');\n        }\n        sb.append(']');\n        System.out.println(sb);\n    }\n}\n",
