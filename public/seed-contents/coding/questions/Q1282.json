  "solution": {
    "notes": [
      "Each person is inserted into exactly one bucket and emitted exactly once.",
      "The output itself contains all n person IDs, so O(n) auxiliary storage is consistent with a returned list of groups."
    ],
    "approach": "Group people by their required group size. While scanning person IDs from left to right, append each ID to the bucket for its size. As soon as a bucket reaches that size, emit it as one complete group and start a fresh bucket for the same size.",
    "editorial": {
      "better": {
        "complexity": "O(n log n) time, O(n) space",
        "description": "Sort person IDs by groupSizes[id], then split the sorted sequence into consecutive chunks whose length equals the shared group size. Sorting avoids repeated scans but costs more than necessary."
      },
      "optimal": {
        "complexity": "O(n) time, O(n) space",
        "description": "Use a bucket keyed by required group size. Append each person to that bucket and immediately emit the bucket when its length reaches the required size. Every person is processed once, so the algorithm is linear."
      },
      "bruteForce": {
        "complexity": "O(n^2) time, O(n) space",
        "description": "Try to build each group by repeatedly scanning all unassigned people to find those with the same required size. This can rescan many people and may take O(n^2) time."
      }
    },
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n)",
    "code": {
      "Python3": "import sys, json\nfrom typing import List\n\nclass Solution:\n    def groupThePeople(self, groupSizes: List[int]) -> List[List[int]]:\n        buckets = {}\n        result = []\n        for person, size in enumerate(groupSizes):\n            bucket = buckets.setdefault(size, [])\n            bucket.append(person)\n            if len(bucket) == size:\n                result.append(bucket)\n                del buckets[size]\n        return result"
    }
  },
