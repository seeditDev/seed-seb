  "solution": {
    "approach": "Print numbers 1..i, followed by zeros, followed by i..1.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= i; j++) printf(\"%d\", j);\n        if (i < n) for (int z = 0; z < 2 * (n - i) - 1; z++) putchar('0');\n        int start = (i == n) ? i - 1 : i;\n        for (int j = start; j >= 1; j--) printf(\"%d\", j);\n        printf(\"\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= i; j++) cout << j;\n        if (i < n) cout << string(2 * (n - i) - 1, '0');\n        int start = (i == n) ? i - 1 : i;\n        for (int j = start; j >= 1; j--) cout << j;\n        cout << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            StringBuilder sb = new StringBuilder();\n            for (int i = 1; i <= n; i++) {\n                for (int j = 1; j <= i; j++) sb.append(j);\n                if (i < n) sb.append(\"0\".repeat(2 * (n - i) - 1));\n                int start = (i == n) ? i - 1 : i;\n                for (int j = start; j >= 1; j--) sb.append(j);\n                sb.append(\"\\n\");\n            }\n            System.out.print(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    for i in range(1, n + 1):\n        left = \"\".join(str(j) for j in range(1, i + 1))\n        zeros = \"0\" * (2 * (n - i) - 1) if i < n else \"\"\n        right = \"\".join(str(j) for j in range(i - (1 if i == n else 0), 0, -1))\n        print(left + zeros + right)\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const lines = [];\n    for (let i = 1; i <= n; i++) {\n        let left = \"\"; for (let j = 1; j <= i; j++) left += j;\n        const zeros = i < n ? \"0\".repeat(2 * (n - i) - 1) : \"\";\n        let right = \"\";\n        const start = (i === n) ? i - 1 : i;\n        for (let j = start; j >= 1; j--) right += j;\n        lines.push(left + zeros + right);\n    }\n    console.log(lines.join(\"\\n\"));\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "For row i (1 to N), print ascending numbers 1..i, zeros (2*(N-i)-1 if i<N), and descending numbers."
  },
