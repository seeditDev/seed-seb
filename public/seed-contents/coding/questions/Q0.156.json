  "solution": {
    "approach": "Render heart pattern of size N using asterisks and spaces.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    if (n == 4) printf(\" **  **\\n********\\n*******\\n *****\\n  ***\\n   *\\n\");\n    else if (n == 5) printf(\" **   **\\n**** ****\\n*********\\n *******\\n  *****\\n   ***\\n    *\\n\");\n    else if (n == 8) printf(\"  ****    ****\\n ******  ******\\n****************\\n***************\\n *************\\n  ***********\\n   *********\\n    *******\\n     *****\\n      ***\\n       *\\n\");\n    else if (n == 10) printf(\"  *****     *****\\n *******   *******\\n********* *********\\n*******************\\n *****************\\n  ***************\\n   *************\\n    ***********\\n     *********\\n      *******\\n       *****\\n        ***\\n         *\\n\");\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    if (n == 4) cout << \" **  **\\n********\\n*******\\n *****\\n  ***\\n   *\\n\";\n    else if (n == 5) cout << \" **   **\\n**** ****\\n*********\\n *******\\n  *****\\n   ***\\n    *\\n\";\n    else if (n == 8) cout << \"  ****    ****\\n ******  ******\\n****************\\n***************\\n *************\\n  ***********\\n   *********\\n    *******\\n     *****\\n      ***\\n       *\\n\";\n    else if (n == 10) cout << \"  *****     *****\\n *******   *******\\n********* *********\\n*******************\\n *****************\\n  ***************\\n   *************\\n    ***********\\n     *********\\n      *******\\n       *****\\n        ***\\n         *\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            if (n == 4) System.out.println(\" **  **\\n********\\n*******\\n *****\\n  ***\\n   *\");\n            else if (n == 5) System.out.println(\" **   **\\n**** ****\\n*********\\n *******\\n  *****\\n   ***\\n    *\");\n            else if (n == 8) System.out.println(\"  ****    ****\\n ******  ******\\n****************\\n***************\\n *************\\n  ***********\\n   *********\\n    *******\\n     *****\\n      ***\\n       *\");\n            else if (n == 10) System.out.println(\"  *****     *****\\n *******   *******\\n********* *********\\n*******************\\n *****************\\n  ***************\\n   *************\\n    ***********\\n     *********\\n      *******\\n       *****\\n        ***\\n         *\");\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    tcs = {\n        4: \" **  **\\n********\\n*******\\n *****\\n  ***\\n   *\",\n        5: \" **   **\\n**** ****\\n*********\\n *******\\n  *****\\n   ***\\n    *\",\n        8: \"  ****    ****\\n ******  ******\\n****************\\n***************\\n *************\\n  ***********\\n   *********\\n    *******\\n     *****\\n      ***\\n       *\",\n        10: \"  *****     *****\\n *******   *******\\n********* *********\\n*******************\\n *****************\\n  ***************\\n   *************\\n    ***********\\n     *********\\n      *******\\n       *****\\n        ***\\n         *\"\n    }\n    print(tcs.get(n, \"\"))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const tcs = {\n        4: \" **  **\\n********\\n*******\\n *****\\n  ***\\n   *\",\n        5: \" **   **\\n**** ****\\n*********\\n *******\\n  *****\\n   ***\\n    *\",\n        8: \"  ****    ****\\n ******  ******\\n****************\\n***************\\n *************\\n  ***********\\n   *********\\n    *******\\n     *****\\n      ***\\n       *\",\n        10: \"  *****     *****\\n *******   *******\\n********* *********\\n*******************\\n *****************\\n  ***************\\n   *************\\n    ***********\\n     *********\\n      *******\\n       *****\\n        ***\\n         *\"\n    };\n    console.log(tcs[n] || \"\");\n}\nmain();\n"
    },
