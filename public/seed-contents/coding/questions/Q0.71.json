  "solution": {
    "approach": "Convert a decimal integer to binary string representation.",
    "timeComplexity": "O(log N)",
    "spaceComplexity": "O(log N)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    long long n;\n    if (scanf(\"%lld\", &n) == 1) {\n        if (n == 0) { printf(\"0\\n\"); return 0; }\n        char bin[65];\n        int idx = 0;\n        while (n > 0) {\n            bin[idx++] = (n % 2) + '0';\n            n /= 2;\n        }\n        for (int i = idx - 1; i >= 0; i--) putchar(bin[i]);\n        putchar('\\n');\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    long long n;\n    if (cin >> n) {\n        if (n == 0) { cout << \"0\\n\"; return 0; }\n        string s = \"\";\n        while (n > 0) {\n            s += (n % 2 ? '1' : '0');\n            n /= 2;\n        }\n        reverse(s.begin(), s.end());\n        cout << s << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLong()) {\n            System.out.println(Long.toBinaryString(sc.nextLong()));\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        print(bin(int(s))[2:])\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        console.log(BigInt(s).toString(2));\n    }\n}\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Extract bits using repeated modulo/division by 2, or format using built-in binary specifiers."
