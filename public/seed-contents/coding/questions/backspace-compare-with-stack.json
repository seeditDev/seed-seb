{
  "id": "backspace-compare-with-stack",
  "questionId": "backspace-compare-with-stack",
  "slug": "backspace-compare-with-stack",
  "title": "Build Final String With Backspaces",
  "difficulty": "Easy",
  "category": "Stack",
  "patterns": [
    "stack"
  ],
  "lists": [],
  "hints": [
    "what does pressing backspace actually do to whatever you've typed so far - does it need to know anything beyond the very last character you typed?",
    "walk through s left to right; for a letter, add it to your result so far; for '#', remove the most recent character if one exists",
    "a stack (or a list used as one) models 'the most recent character typed' exactly, and popping on '#' handles the no-op case naturally when it's empty",
    "join the stack's contents at the end to form the final string"
  ],
  "commonMistakes": [
    "popping from an empty stack on '#' instead of checking first (or not handling the case at all in languages where it would crash)",
    "trying to handle backspaces by scanning right to left with a counter of skips (works, but is easy to get the counter logic wrong compared to the simpler stack simulation)",
    "forgetting consecutive '#' characters can cancel each other's effect only if there's enough typed content before them"
  ],
  "content": {
    "problemStatement": "You're given a string containing lowercase letters and the character '#', where '#' represents pressing backspace, deleting the previous character in the string being typed (if there is one; a '#' with nothing before it does nothing).\n\n**Simulate typing the string character by character, and return the final resulting string after all backspaces are applied.**\n",
    "constraints": [
      "0 <= s.length <= 200",
      "s consists only of lowercase English letters and the character '#'"
    ],
    "notes": [
      "backspace at the very start of the string (no-op)",
      "more backspaces than typed characters",
      "string with no '#' at all"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"ab#c\"",
        "output": "\"ac\"",
        "expectedOutput": "\"ac\"",
        "explanation": "type a, type b, backspace removes b, type c -> \"ac\""
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"ab##\"",
        "output": "\"\"",
        "expectedOutput": "\"\"",
        "explanation": "type a, type b, backspace removes b, backspace removes a -> empty"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"a##c\"",
        "output": "\"c\"",
        "expectedOutput": "\"c\"",
        "explanation": "type a, backspace removes a (empty), backspace does nothing (nothing to remove), type c -> \"c\""
      }
    ],
