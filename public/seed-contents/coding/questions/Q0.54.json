  "solution": {
    "approach": "Compute sum of numbers from 1 to n using formula n * (n + 1) / 2.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    long long n;\n    if (scanf(\"%lld\", &n) == 1) {\n        printf(\"%lld\\n\", n * (n + 1) / 2);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    long long n;\n    if (cin >> n) {\n        cout << n * (n + 1) / 2 << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLong()) {\n            long n = sc.nextLong();\n            System.out.println(n * (n + 1) / 2);\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        n = int(s)\n        print(n * (n + 1) // 2)\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const n = BigInt(s);\n        console.log((n * (n + 1n) / 2n).toString());\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Calculate sum = n * (n + 1) / 2 using 64-bit integers to prevent overflow."
  },
