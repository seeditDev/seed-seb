{
  "id": "longest-consecutive-sequence-union-find",
  "questionId": "longest-consecutive-sequence-union-find",
  "slug": "longest-consecutive-sequence-union-find",
  "title": "Longest Consecutive Sequence",
  "difficulty": "Medium",
  "category": "Union find",
  "patterns": [
    "union find",
    "connected components"
  ],
  "lists": [],
  "hints": [
    "you don't need array indices for union-find here - use a hash map from value to its own union-find node",
    "insert every distinct value as its own component first, skipping duplicates",
    "for each value v, if v + 1 also exists in the map, union their components - this is the only edge relationship you need to build the whole structure",
    "track the size of each component (union by size), and the answer is the largest component size at the end"
  ],
  "commonMistakes": [
    "not skipping duplicate values before inserting, which can inflate or corrupt component sizes",
    "only checking v + 1 and not realizing v - 1 will be handled naturally when that smaller value does its own v+1 check, so you never need to check both directions",
    "using array index-based union-find instead of a value-to-id map, which breaks down for sparse or negative values"
  ],
  "content": {
    "problemStatement": "You're given an unsorted array of integers, possibly with duplicates.\n\n**Return the length of the longest run of consecutive integers (values\nthat differ by exactly 1) that all appear somewhere in the array.**\n",
    "constraints": [
      "0 <= nums.length <= 100000",
      "-1000000000 <= nums[i] <= 1000000000",
      "duplicates may appear"
    ],
    "notes": [
      "an empty array",
      "a single element",
      "an array with duplicate values",
      "an array with no two consecutive values at all"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [100,4,200,1,3,2]",
        "output": "4",
        "expectedOutput": "4",
        "explanation": "1, 2, 3, 4 is the longest consecutive run"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [0,3,7,2,5,8,4,6,0,1]",
        "output": "9",
        "expectedOutput": "9",
        "explanation": "0 through 8 are all present, giving a run of length 9"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "nums = []",
        "output": "0",
        "expectedOutput": "0",
        "explanation": "an empty array has no run at all"
      }
