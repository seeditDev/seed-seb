{
  "id": "longest-palindrome",
  "questionId": "longest-palindrome",
  "slug": "longest-palindrome",
  "title": "Longest Palindrome",
  "difficulty": "Easy",
  "category": "Hash map",
  "patterns": [
    "hash map",
    "greedy",
    "strings"
  ],
  "lists": [
    "grind-75"
  ],
  "hints": [
    "a palindrome is built from pairs of matching letters mirrored around a center, plus optionally one unpaired letter exactly in the middle - so what actually matters about each letter's count in s?",
    "count how many times each letter appears in s",
    "for a letter appearing k times, you can use floor(k/2)*2 of them as mirrored pairs; every letter contributes its even part to the total length",
    "if any letter has a leftover odd count (even just one letter with count 1), you can place exactly one such leftover letter in the very center, adding 1 more to the total (but only once, not once per odd-count letter)"
  ],
  "commonMistakes": [
    "adding 1 to the answer once per letter that has an odd count, instead of at most once total",
    "treating the problem as case-insensitive and merging counts for 'a' and 'A'",
    "trying to find a palindromic substring within s instead of a palindrome built by rearranging its letters"
  ],
  "content": {
    "problemStatement": "You're given a string of letters, treated as a bag of characters rather\nthan a fixed sequence: you may rearrange the letters however you like,\nand you don't have to use all of them.\n\n**Using some or all of the letters in the string, return the length of\nthe longest palindrome you can build.**\n\nThis is not about finding a palindromic substring inside `s`, it's\nabout what palindrome you could construct from its letters. The\ncomparison is case-sensitive, so 'a' and 'A' are different letters.\n",
    "constraints": [
      "1 <= s.length <= 2000",
      "s consists of lowercase and/or uppercase English letters only",
      "letter comparison is case-sensitive ('a' != 'A')"
    ],
    "notes": [
      "every letter appears an even number of times (all letters get used)",
      "every letter appears exactly once (only one letter can be the center)",
      "a mix of same letter in different cases, e.g. 'Aa', which do not pair with each other"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"abccccdd\"",
        "output": "7",
        "expectedOutput": "7",
        "explanation": "one longest palindrome buildable is \"dccaccd\", length 7 (the second 'd' or extra letters are left unused)"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"a\"",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "a single letter is trivially a palindrome of length 1"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"bb\"",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "both letters match, so the whole string is used as \"bb\""
      }
    ],
