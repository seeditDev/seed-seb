  "solution": {
    "approach": "Check if string is a palindrome.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005];\n    if (scanf(\"%s\", s) == 1) {\n        int l = 0, r = strlen(s) - 1, pal = 1;\n        while (l < r) if (s[l++] != s[r--]) { pal = 0; break; }\n        printf(\"%s\\n\", pal ? \"Yes\" : \"No\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\n#include <algorithm>\nusing namespace std;\nint main() {\n    string s; if (cin >> s) {\n        string rev = s; reverse(rev.begin(), rev.end());\n        cout << (s == rev ? \"Yes\" : \"No\") << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            String rev = new StringBuilder(s).reverse().toString();\n            System.out.println(s.equals(rev) ? \"Yes\" : \"No\");\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    s = sys.stdin.read().strip()\n    if s: print(\"Yes\" if s == s[::-1] else \"No\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const s = fs.readFileSync(0, \"utf-8\").trim();\n    if (s) console.log(s === s.split(\"\").reverse().join(\"\") ? \"Yes\" : \"No\");\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Compare string with its reverse. Print 'Yes' if palindrome, else 'No'."
  },
