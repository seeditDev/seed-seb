{
  "id": "starting-courses",
  "questionId": "starting-courses",
  "slug": "starting-courses",
  "title": "Courses You Can Start Immediately",
  "difficulty": "Easy",
  "category": "Topological sort",
  "patterns": [
    "topological sort",
    "graph",
    "in-degree"
  ],
  "lists": [],
  "hints": [
    "a course qualifies if it never shows up as the 'depends on something' side of a prerequisite pair - how would you track that efficiently?",
    "make an array of size n initialized to zero, and for every prerequisite pair increment the count for the dependent course",
    "after one pass over all edges, which indices still have a count of zero?",
    "collect those indices in ascending order - a simple left-to-right scan over the in-degree array already visits them in order"
  ],
  "commonMistakes": [
    "confusing which element of the pair is the dependent course and which is the prerequisite",
    "forgetting that a self-loop prerequisite still counts as a prerequisite, excluding that course from the result",
    "not returning the result in ascending order"
  ],
  "content": {
    "problemStatement": "There are `n` courses, labeled 0 to n - 1, and a list of prerequisite\npairs, where each pair `[a, b]` means course `a` requires course `b` to\nbe completed first.\n\n**Return, in ascending order, every course that has no prerequisites at all, meaning it can be started immediately.**\n",
    "constraints": [
      "1 <= n <= 10^4",
      "each prerequisite pair [a, b] has 0 <= a, b < n",
      "the same prerequisite pair may appear more than once"
    ],
    "notes": [
      "no prerequisite edges at all - every course is a starting course",
      "a self-loop prerequisite like [0, 0] means that course is NOT a starting course, since it does require something (itself) first",
      "duplicate prerequisite pairs listed more than once",
      "a course that never appears anywhere in prereqs still counts as a starting course"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "n = 4, prereqs = [[1, 0], [2, 0], [3, 1]]",
        "output": "[0]",
        "expectedOutput": "[0]",
        "explanation": "courses 1, 2, and 3 each require something first; only course 0 needs nothing"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "n = 3, prereqs = []",
        "output": "[0, 1, 2]",
        "expectedOutput": "[0, 1, 2]",
        "explanation": "with no prerequisite pairs at all, every course can start immediately"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "n = 5, prereqs = [[2, 0], [2, 1], [4, 3]]",
        "output": "[0, 1, 3]",
        "expectedOutput": "[0, 1, 3]",
        "explanation": "only courses 2 and 4 require anything first"
      }
