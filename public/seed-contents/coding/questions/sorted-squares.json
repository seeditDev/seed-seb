  "lists": [],
  "hints": [
    "sorting after squaring works, but it ignores that the input was already sorted. where in the array can the biggest square possibly come from?",
    "the largest square is always at one of the two ends - either the most negative number or the largest positive number",
    "use two pointers starting at both ends, compare the squares, and place the bigger one at the back of the result, working inward",
    "you're filling the answer array from the back forward, since you're finding the largest values first"
  ],
  "commonMistakes": [
    "forgetting negative numbers exist and just squaring in the original order",
    "sorting after squaring instead of using the two-pointer fill, missing the point of using the sorted input",
    "filling the result array from the front instead of the back, which doesn't match finding the biggest values first"
  ],
