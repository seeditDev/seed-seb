      "1 <= nums.length <= 10^4",
      "-10^4 <= nums[i] <= 10^4",
      "nums is sorted in non-decreasing order"
    ],
    "notes": [
      "all negative numbers",
      "all non-negative numbers",
      "a single element"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
