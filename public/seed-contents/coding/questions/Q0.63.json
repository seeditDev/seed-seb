  "solution": {
    "approach": "Multiply two numbers without using * operator using repeated addition.",
    "timeComplexity": "O(B)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    long long a, b;\n    if (scanf(\"%lld %lld\", &a, &b) == 2) {\n        long long prod = 0;\n        for (long long i = 0; i < b; i++) prod += a;\n        printf(\"%lld\\n\", prod);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    long long a, b;\n    if (cin >> a >> b) {\n        long long prod = 0;\n        for (long long i = 0; i < b; i++) prod += a;\n        cout << prod << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLong()) {\n            long a = sc.nextLong(), b = sc.nextLong();\n            long prod = 0;\n            for (long i = 0; i < b; i++) prod += a;\n            System.out.println(prod);\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    parts = sys.stdin.read().split()\n    if len(parts) >= 2:\n        a, b = int(parts[0]), int(parts[1])\n        prod = 0\n        for _ in range(b):\n            prod += a\n        print(prod)\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction main() {\n    const parts = fs.readFileSync(0, 'utf-8').trim().split(/\\s+/);\n    if (parts.length >= 2) {\n        const a = BigInt(parts[0]), b = BigInt(parts[1]);\n        let prod = 0n;\n        for (let i = 0n; i < b; i += 1n) prod += a;\n        console.log(prod.toString());\n    }\n}\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Add A to an accumulator B times."
