  "solution": {
    "approach": "Print the length of the input string.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005];\n    if (fgets(s, sizeof(s), stdin)) {\n        int len = strlen(s);\n        while (len > 0 && (s[len - 1] == '\\n' || s[len - 1] == '\\r')) len--;\n        printf(\"%d\\n\", len);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; if (getline(cin, s)) {\n        while (!s.empty() && (s.back() == '\\r' || s.back() == '\\n')) s.pop_back();\n        cout << s.length() << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLine()) {\n            String s = sc.nextLine().replaceAll(\"[\\r\\n]\", \"\");\n            System.out.println(s.length());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    s = sys.stdin.read().strip(\"\\r\\n\")\n    print(len(s))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const s = fs.readFileSync(0, \"utf-8\").replace(/[\\r\\n]+$/, \"\");\n    console.log(s.length);\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Compute string character length excluding trailing line breaks."
