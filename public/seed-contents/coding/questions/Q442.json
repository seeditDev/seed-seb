  "content": {
    "problemStatement": "You're given an array `nums` of length `n` where every value is in the\nrange `[1, n]`, and each value appears either once or exactly twice.\n\n**Return every value that appears twice, sorted in ascending order.**",
    "constraints": [
      "array length is n, every value is in range [1, n]",
      "each value appears once or exactly twice",
      "return the duplicated values sorted ascending"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [4, 3, 2, 7, 8, 2, 3, 1]",
        "output": "[2, 3]",
        "explanation": "2 and 3 each appear twice, sorted ascending gives [2, 3]"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [1, 1, 2]",
        "output": "[1]",
        "explanation": ""
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "nums = [1, 2, 3]",
        "output": "[]",
        "explanation": "no value repeats"
      }
    ],
    "notes": []
