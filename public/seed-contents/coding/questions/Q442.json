  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def findDuplicates(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: List[int]\n        \"\"\"\n        result = []\n        for i in nums:\n            if nums[abs(i)-1] < 0:\n                result.append(abs(i))\n            else:\n                nums[abs(i)-1] *= -1\n        return result"
    },
