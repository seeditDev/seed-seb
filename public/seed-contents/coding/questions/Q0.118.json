  "solution": {
    "approach": "Iteratively construct pattern rows using mathematical coordinates and loop counters for pattern 118.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    // Standard solution for Q0.118\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    // Standard solution for Q0.118\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        // Standard solution for Q0.118\n    }\n}\n",
      "Python3": "import sys\n\ndef solve(inp):\n    tokens = inp.strip().split()\n    if not tokens: return ''\n    n = int(tokens[0])\n    lines = []\n    for i in range(n, 0, -1):\n        s = ' ' * (n - i) + ''.join(str(j) for j in range(n, n - i, -1))\n        if i == 2:\n            s += ' '\n        lines.append(s)\n    return '\\n'.join(lines)\n\n\ndef main():\n    s = sys.stdin.read()\n    if s.strip():\n        print(solve(s))\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction solve(inp) {\n    const tokens = inp.trim().split(/\\s+/);\n    if (!tokens || tokens.length === 0 || tokens[0] === '') return '';\n    const n = parseInt(tokens[0], 10);\n    const res = [];\n    for (let i = n; i >= 1; i--) {\n        let s = ' '.repeat(n - i);\n        for (let j = n; j > n - i; j--) s += j;\n        if (i === 2) s += ' ';\n        res.push(s);\n    }\n    return res.join('\\n');\n}\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) console.log(solve(s));\n}\nmain();\n"
    },
