        "type": "reg",
        "input": "nums1 = [4, 1, 2], nums2 = [1, 3, 4, 2]",
        "output": "[-1, 3, -1]",
        "expectedOutput": "[-1, 3, -1]",
        "explanation": "in nums2, nothing to the right of 4 is greater; the first value to the right of 1 that's greater is 3; nothing to the right of 2 is greater"
      },
      {
