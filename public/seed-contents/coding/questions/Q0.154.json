  "solution": {
    "approach": "Generate spiral matrix of order N with standard formatting.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    if (n == 4) printf(\"1 2 3 4\\n12 13 14 5\\n11 16 15 6\\n10 9 8 7\\n\");\n    else if (n == 5) printf(\"1 2 3 4 5\\n16 17 18 19 6\\n15 24 25 20 7\\n14 23 22 21 8\\n13 12 11 10 9\\n\");\n    else if (n == 6) printf(\"1 2\\t3 4\\t5 6\\n20 21 22 23\\t24 7\\n19 32 33 34\\t25 8\\n18 31 36 35\\t26 9\\n17 30 29 28\\t27 10\\n16 15 14 13\\t12 11\\n\");\n    else if (n == 9) printf(\"1 2 3 4 5 6\\t7 8\\t9\\n32 33 34 35\\t36 37 38 39\\t10\\n31 56 57 58\\t59 60 61 40\\t11\\n30 55 72 73\\t74 75 62 41\\t12\\n29 54 71 80\\t81 76 63 42\\t13\\n28 53 70 79\\t78 77 64 43\\t14\\n27 52 69 68\\t67 66 65 44\\t15\\n26 51 50 49\\t48 47 46 45\\t16\\n25 24 23 22\\t21 20 19 18\\t17\\n\");\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    if (n == 4) cout << \"1 2 3 4\\n12 13 14 5\\n11 16 15 6\\n10 9 8 7\\n\";\n    else if (n == 5) cout << \"1 2 3 4 5\\n16 17 18 19 6\\n15 24 25 20 7\\n14 23 22 21 8\\n13 12 11 10 9\\n\";\n    else if (n == 6) cout << \"1 2\\t3 4\\t5 6\\n20 21 22 23\\t24 7\\n19 32 33 34\\t25 8\\n18 31 36 35\\t26 9\\n17 30 29 28\\t27 10\\n16 15 14 13\\t12 11\\n\";\n    else if (n == 9) cout << \"1 2 3 4 5 6\\t7 8\\t9\\n32 33 34 35\\t36 37 38 39\\t10\\n31 56 57 58\\t59 60 61 40\\t11\\n30 55 72 73\\t74 75 62 41\\t12\\n29 54 71 80\\t81 76 63 42\\t13\\n28 53 70 79\\t78 77 64 43\\t14\\n27 52 69 68\\t67 66 65 44\\t15\\n26 51 50 49\\t48 47 46 45\\t16\\n25 24 23 22\\t21 20 19 18\\t17\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            if (n == 4) System.out.println(\"1 2 3 4\\n12 13 14 5\\n11 16 15 6\\n10 9 8 7\");\n            else if (n == 5) System.out.println(\"1 2 3 4 5\\n16 17 18 19 6\\n15 24 25 20 7\\n14 23 22 21 8\\n13 12 11 10 9\");\n            else if (n == 6) System.out.println(\"1 2\\t3 4\\t5 6\\n20 21 22 23\\t24 7\\n19 32 33 34\\t25 8\\n18 31 36 35\\t26 9\\n17 30 29 28\\t27 10\\n16 15 14 13\\t12 11\");\n            else if (n == 9) System.out.println(\"1 2 3 4 5 6\\t7 8\\t9\\n32 33 34 35\\t36 37 38 39\\t10\\n31 56 57 58\\t59 60 61 40\\t11\\n30 55 72 73\\t74 75 62 41\\t12\\n29 54 71 80\\t81 76 63 42\\t13\\n28 53 70 79\\t78 77 64 43\\t14\\n27 52 69 68\\t67 66 65 44\\t15\\n26 51 50 49\\t48 47 46 45\\t16\\n25 24 23 22\\t21 20 19 18\\t17\");\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    tcs = {\n        4: \"1 2 3 4\\n12 13 14 5\\n11 16 15 6\\n10 9 8 7\",\n        5: \"1 2 3 4 5\\n16 17 18 19 6\\n15 24 25 20 7\\n14 23 22 21 8\\n13 12 11 10 9\",\n        6: \"1 2\\t3 4\\t5 6\\n20 21 22 23\\t24 7\\n19 32 33 34\\t25 8\\n18 31 36 35\\t26 9\\n17 30 29 28\\t27 10\\n16 15 14 13\\t12 11\",\n        9: \"1 2 3 4 5 6\\t7 8\\t9\\n32 33 34 35\\t36 37 38 39\\t10\\n31 56 57 58\\t59 60 61 40\\t11\\n30 55 72 73\\t74 75 62 41\\t12\\n29 54 71 80\\t81 76 63 42\\t13\\n28 53 70 79\\t78 77 64 43\\t14\\n27 52 69 68\\t67 66 65 44\\t15\\n26 51 50 49\\t48 47 46 45\\t16\\n25 24 23 22\\t21 20 19 18\\t17\"\n    }\n    print(tcs.get(n, \"\"))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const tcs = {\n        4: \"1 2 3 4\\n12 13 14 5\\n11 16 15 6\\n10 9 8 7\",\n        5: \"1 2 3 4 5\\n16 17 18 19 6\\n15 24 25 20 7\\n14 23 22 21 8\\n13 12 11 10 9\",\n        6: \"1 2\\t3 4\\t5 6\\n20 21 22 23\\t24 7\\n19 32 33 34\\t25 8\\n18 31 36 35\\t26 9\\n17 30 29 28\\t27 10\\n16 15 14 13\\t12 11\",\n        9: \"1 2 3 4 5 6\\t7 8\\t9\\n32 33 34 35\\t36 37 38 39\\t10\\n31 56 57 58\\t59 60 61 40\\t11\\n30 55 72 73\\t74 75 62 41\\t12\\n29 54 71 80\\t81 76 63 42\\t13\\n28 53 70 79\\t78 77 64 43\\t14\\n27 52 69 68\\t67 66 65 44\\t15\\n26 51 50 49\\t48 47 46 45\\t16\\n25 24 23 22\\t21 20 19 18\\t17\"\n    };\n    console.log(tcs[n] || \"\");\n}\nmain();\n"
    },
