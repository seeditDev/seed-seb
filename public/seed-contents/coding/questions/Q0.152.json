  "solution": {
    "approach": "Compute integer average of N elements.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1 || n == 0) return 0;\n    long long sum = 0, x;\n    for (int i = 0; i < n; i++) { scanf(\"%lld\", &x); sum += x; }\n    printf(\"%lld\\n\", sum / n);\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n) || n == 0) return 0;\n    long long sum = 0, x;\n    for (int i = 0; i < n; i++) { cin >> x; sum += x; }\n    cout << sum / n << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long sum = 0;\n            for (int i = 0; i < n; i++) sum += sc.nextLong();\n            System.out.println(sum / n);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    nums = [int(x) for x in toks[1:n+1]]\n    print(sum(nums) // n)\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = BigInt(toks[0]);\n    let sum = 0n;\n    for (let i = 1; i <= Number(n); i++) sum += BigInt(toks[i]);\n    console.log((sum / n).toString());\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Sum all elements and compute integer division sum / N."
  },
