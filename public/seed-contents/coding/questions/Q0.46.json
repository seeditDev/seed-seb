  "solution": {
    "approach": "Classify character as ALPHABET, NUMBER, or SPECIAL CHARACTER.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <ctype.h>\n\nint main() {\n    char ch;\n    if (scanf(\" %c\", &ch) == 1) {\n        if (isdigit(ch)) printf(\"NUMBER\\n\");\n        else if (isalpha(ch)) printf(\"ALPHABET\\n\");\n        else printf(\"SPECIAL CHARACTER\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <cctype>\nusing namespace std;\n\nint main() {\n    char ch;\n    if (cin >> ch) {\n        if (isdigit(ch)) cout << \"NUMBER\\n\";\n        else if (isalpha(ch)) cout << \"ALPHABET\\n\";\n        else cout << \"SPECIAL CHARACTER\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            char c = sc.next().charAt(0);\n            if (Character.isDigit(c)) System.out.println(\"NUMBER\");\n            else if (Character.isLetter(c)) System.out.println(\"ALPHABET\");\n            else System.out.println(\"SPECIAL CHARACTER\");\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        c = s[0]\n        if c.isdigit(): print(\"NUMBER\")\n        elif c.isalpha(): print(\"ALPHABET\")\n        else: print(\"SPECIAL CHARACTER\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const c = s[0];\n        if (/\\d/.test(c)) console.log(\"NUMBER\");\n        else if (/[a-zA-Z]/.test(c)) console.log(\"ALPHABET\");\n        else console.log(\"SPECIAL CHARACTER\");\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Check if character is digit (0-9) -> NUMBER, letter (a-z, A-Z) -> ALPHABET, else -> SPECIAL CHARACTER."
  },
  "hints": [
    "Use isdigit() or check '0' <= c <= '9' for NUMBER.",
    "Use isalpha() for ALPHABET.",
    "Otherwise it is SPECIAL CHARACTER."
