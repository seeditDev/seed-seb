  "solution": {
    "approach": "Print first number as 5 digits zero-padded, and second number in next line width 5 space-padded.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int a, b;\n    if (scanf(\"%d %d\", &a, &b) == 2) {\n        printf(\"%05d\\n%5d\\n\", a, b);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <iomanip>\nusing namespace std;\n\nint main() {\n    int a, b;\n    if (cin >> a >> b) {\n        cout << setfill('0') << setw(5) << a << \"\\n\";\n        cout << setfill(' ') << setw(5) << b << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            System.out.printf(\"%05d\\n%5d\\n\", a, b);\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    parts = sys.stdin.read().split()\n    if len(parts) >= 2:\n        a = int(parts[0])\n        b = int(parts[1])\n        print(f\"{a:05d}\")\n        print(f\"{b:5d}\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const parts = fs.readFileSync(0, 'utf-8').trim().split(/\\s+/);\n    if (parts.length >= 2) {\n        console.log(parts[0].padStart(5, '0'));\n        console.log(parts[1].padStart(5, ' '));\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Format first number with %05d and second number with %5d on subsequent lines."
  },
