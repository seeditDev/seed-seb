        "type": "reg",
        "input": "nums = [-3, 2, -3, 4, 2]",
        "output": "5",
        "expectedOutput": "5",
        "explanation": "with startValue 5, the running totals are 2, 4, 1, 5, 7 - all at least 1"
      },
      {
