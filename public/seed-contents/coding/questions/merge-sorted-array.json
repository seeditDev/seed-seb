    "constraints": [
      "0 <= nums1.length, nums2.length <= 200",
      "-10^9 <= nums1[i], nums2[i] <= 10^9",
      "nums1 and nums2 are each sorted in ascending order"
    ],
    "notes": [
      "one of the two lists is empty",
      "all elements of one list are smaller than all elements of the other",
      "duplicate values across the two lists"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
