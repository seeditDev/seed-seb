    "optimal": {
      "time": "O(n)",
      "space": "O(1) extra if reversing in place, O(n) if building a new output array by slicing",
      "pattern": "reduce k modulo length, then use the reverse trick: reverse the whole array, then reverse the first k and last n-k segments separately"
    },
    "bruteForce": {
      "approach": "rotate one step at a time, k times: on each step, pop the last element and insert it at the front",
      "time": "O(n * k)",
      "space": "O(1) extra if done in place, though popping from the end and inserting at the front is O(n) per step in most array representations"
    }
