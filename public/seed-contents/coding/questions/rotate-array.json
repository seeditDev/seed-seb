{
  "id": "rotate-array",
  "questionId": "rotate-array",
  "slug": "rotate-array",
  "title": "Rotate Array",
  "difficulty": "Medium",
  "category": "Two pointers",
  "patterns": [
    "array rotation",
    "in-place transformation"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "what happens if k is bigger than the array length? think about what actually changes after rotating by exactly n steps",
    "reduce k to k mod n first, since a full lap around the array is a no-op",
    "one clean approach: the last k elements end up first, and the first n-k elements end up right after them, in their original relative order - can you slice and concatenate?",
    "a constant-extra-space approach: reverse the entire array, then reverse just the first k elements, then reverse just the remaining n-k elements",
    "double check your reverse-based approach on a small example by hand, it's easy to reverse the wrong segment or the wrong number of elements"
  ],
  "commonMistakes": [
    "forgetting to take k modulo the array length, causing wasted work or out-of-bounds slicing when k exceeds nums.length",
    "rotating left instead of right (the last k elements should move to the front, not the first k elements move to the back)",
    "off-by-one errors when slicing at index n - k versus n - k - 1",
    "mutating the input while still reading from it in a naive in-place shift, corrupting later reads"
  ],
  "content": {
    "problemStatement": "You're given a list of integers and a non-negative number of steps `k`.\n\n**Rotate the list to the right by `k` positions, meaning each element moves `k` spots toward the end, wrapping around to the front when it runs off the end, and return the rotated list.**\n\nIf `k` is larger than the length of the list, treat it as if you rotated by `k` modulo the length (rotating a full lap brings you back to where you started).\n",
    "constraints": [
      "1 <= nums.length <= 10^5",
      "-2^31 <= nums[i] <= 2^31 - 1",
      "0 <= k <= 10^5",
      "k can be larger than nums.length, in which case only k mod nums.length steps actually matter"
    ],
    "notes": [
      "k equal to 0 (no rotation)",
      "k equal to nums.length or a multiple of it (rotation is a full lap, array unchanged)",
      "k greater than nums.length (must wrap using k mod length)",
      "a single-element array (any k leaves it unchanged)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [1,2,3,4,5,6,7], k = 3",
        "output": "[5,6,7,1,2,3,4]",
        "expectedOutput": "[5,6,7,1,2,3,4]",
        "explanation": "the last 3 elements (5,6,7) wrap around to the front, and the rest shift right by 3"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [-1,-100,3,99], k = 2",
        "output": "[3,99,-1,-100]",
        "expectedOutput": "[3,99,-1,-100]",
        "explanation": "the last 2 elements move to the front, pushing the first 2 to the back"
      },
      {
        "id": "sample_3",
