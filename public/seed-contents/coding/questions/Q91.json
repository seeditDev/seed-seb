  "content": {
    "problemStatement": "A message made only of uppercase letters A through Z was encoded into\ndigits by mapping 'A' -> \"1\", 'B' -> \"2\", ..., 'Z' -> \"26\", producing a\ndigit string `s`.\n\n**Return the number of distinct ways `s` could have been decoded back into letters.**\n\nA digit string with a leading zero in any decoded group is not a valid encoding of anything.",
    "constraints": [
      "1 <= s.length <= 100",
      "s consists of digits '0' through '9'"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"12\"",
        "output": "2",
        "explanation": "\"12\" could be read as \"1\"+\"2\" (AB) or as \"12\" (L)"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"226\"",
        "output": "3",
        "explanation": "\"2\"+\"2\"+\"6\" (BBF), \"22\"+\"6\" (VF), or \"2\"+\"26\" (BZ)"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"0\"",
        "output": "0",
        "explanation": "a leading zero can never map to a valid letter, so there are no valid decodings"
      }
    ],
    "notes": []
  },
