  "content": {
    "problemStatement": "You're given an array of `points` on the X-Y plane, where `points[i] = [xi, yi]`.\n\n**Return the maximum number of points that all lie on the same straight line.**",
    "constraints": [
      "1 <= points.length <= 300",
      "points[i].length == 2",
      "-10^4 <= x_i, y_i <= 10^4",
      "all points are unique"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "points = [[1,1],[2,2],[3,3]]",
        "output": "3",
        "explanation": "all three points lie on the line y = x"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "points = [[1,1],[3,2],[5,3],[4,1],[2,3],[1,4]]",
        "output": "4",
        "explanation": "four of the six points lie on a single line"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "points = [[0,0]]",
        "output": "1",
        "explanation": "a single point trivially lies on a line"
      }
    ],
    "notes": []
