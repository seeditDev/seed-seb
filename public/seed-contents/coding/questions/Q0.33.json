  "solution": {
    "approach": "Read two integers and check if they are equal.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    long long a, b;\n    if (scanf(\"%lld %lld\", &a, &b) == 2) {\n        printf(\"%s\\n\", (a == b) ? \"Equal\" : \"Not Equal\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    long long a, b;\n    if (cin >> a >> b) {\n        cout << (a == b ? \"Equal\" : \"Not Equal\") << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLong()) {\n            long a = sc.nextLong(), b = sc.nextLong();\n            System.out.println(a == b ? \"Equal\" : \"Not Equal\");\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    parts = sys.stdin.read().split()\n    if len(parts) >= 2:\n        print(\"Equal\" if int(parts[0]) == int(parts[1]) else \"Not Equal\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const parts = fs.readFileSync(0, 'utf-8').trim().split(/\\s+/);\n    if (parts.length >= 2) {\n        console.log(parts[0] === parts[1] ? \"Equal\" : \"Not Equal\");\n    }\n}\n\nmain();\n"
    },
