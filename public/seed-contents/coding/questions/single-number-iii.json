      "-2^31 <= nums[i] <= 2^31 - 1",
      "each element in nums appears exactly twice, except two elements that each appear exactly once"
    ],
    "notes": [
      "the array has exactly two elements",
      "the two single numbers are negative, or straddle zero",
      "the two single numbers differ in only their lowest bit"
    ],
