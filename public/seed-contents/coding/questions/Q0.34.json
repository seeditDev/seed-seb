  "solution": {
    "approach": "Determine if an integer is Positive, Negative, or Zero.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int n;\n    if (scanf(\"%d\", &n) == 1) {\n        if (n > 0) printf(\"Positive\\n\");\n        else if (n < 0) printf(\"Negative\\n\");\n        else printf(\"Zero\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int n;\n    if (cin >> n) {\n        if (n > 0) cout << \"Positive\\n\";\n        else if (n < 0) cout << \"Negative\\n\";\n        else cout << \"Zero\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            if (n > 0) System.out.println(\"Positive\");\n            else if (n < 0) System.out.println(\"Negative\");\n            else System.out.println(\"Zero\");\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        n = int(s)\n        if n > 0: print(\"Positive\")\n        elif n < 0: print(\"Negative\")\n        else: print(\"Zero\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const n = parseInt(s, 10);\n        if (n > 0) console.log(\"Positive\");\n        else if (n < 0) console.log(\"Negative\");\n        else console.log(\"Zero\");\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Check if n > 0 -> 'Positive', n < 0 -> 'Negative', n == 0 -> 'Zero'."
