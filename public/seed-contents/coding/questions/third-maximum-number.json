{
  "id": "third-maximum-number",
  "questionId": "third-maximum-number",
  "slug": "third-maximum-number",
  "title": "Third Maximum Number",
  "difficulty": "Medium",
  "category": "Cyclic sort",
  "patterns": [
    "cyclic sort",
    "array"
  ],
  "lists": [],
  "hints": [
    "you only ever need to remember the top three distinct values at any point during the scan - everything else can be discarded immediately, so a full sort is overkill",
    "keep three variables representing the current largest, second largest, and third largest distinct values seen so far, all initialized to a sentinel meaning 'not set yet'",
    "for each number, skip it if it equals any of the three trackers already (duplicates don't count). otherwise figure out where it slides in: if it's bigger than the first tracker, shift first down to second and second down to third before updating first; similar logic if it lands between first and second, or between second and third",
    "at the end, if the third tracker was never set (fewer than 3 distinct values existed), return the first tracker (the true maximum) instead"
  ],
  "commonMistakes": [
    "using a naive sentinel like negative infinity that collides with a legitimately very negative number in the input, causing incorrect 'not set yet' detection (use a dedicated flag or Long.MIN_VALUE-style sentinel outside the input's possible range)",
    "counting duplicate values as filling multiple distinct slots",
    "forgetting to fall back to the overall maximum when fewer than three distinct values exist"
  ],
  "content": {
    "problemStatement": "You're given an array of integers `nums`.\n\n**Return the third distinct maximum number in `nums`.**\n\nIf a third distinct maximum doesn't exist because there are fewer than three distinct values, return the maximum number instead.\n",
    "constraints": [
      "1 <= nums.length <= 10^4",
      "-2^31 <= nums[i] <= 2^31 - 1"
    ],
    "notes": [
      "all elements are identical",
      "array with exactly 3 distinct values",
      "array containing negative numbers"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
