{
  "id": "online-stock-span",
  "questionId": "online-stock-span",
  "slug": "online-stock-span",
  "title": "Online Stock Span",
  "difficulty": "Medium",
  "category": "Monotonic stack",
  "patterns": [
    "monotonic stack",
    "design",
    "array"
  ],
  "lists": [],
  "hints": [
    "the 'online' framing just means you must process prices one at a time without peeking ahead - does that actually change the algorithm from the batch version, or just how you feed it input?",
    "keep a stack of (price, span) pairs representing days whose span hasn't been absorbed by a later day yet",
    "when a new price arrives, while the stack's top price is <= the new price, pop it and add its stored span to the new price's running span - that whole absorbed stretch is now part of today's span",
    "once nothing left on the stack is <= today's price (or the stack is empty), push (today's price, today's final span) and return that span as today's answer"
  ],
  "commonMistakes": [
    "recomputing the span from scratch for every new arrival instead of reusing the stack's accumulated state",
    "storing only prices on the stack without their spans, forcing a fallback to a slow scan",
    "using strict < instead of <= when popping, undercounting spans that include equal prices"
  ],
  "content": {
    "problemStatement": "Prices for a stock arrive one at a time, in chronological order, given to you up front as an array `prices` to simulate the arrivals. For each new price, its span is the number of consecutive days ending today (counting today) where the price was less than or equal to today's price, using only the prices seen so far, never future ones.\n\n**Return the span computed for each price, in the order the prices arrived.**\n",
    "constraints": [
      "1 <= prices.length <= 10^4",
      "1 <= prices[i] <= 10^5",
      "the span for the first price is always 1"
    ],
    "notes": [
      "strictly increasing prices, where each span extends all the way back to the first day",
      "strictly decreasing prices, where every span is 1",
      "repeated prices, since ties count toward the span"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "prices = [100, 80, 60, 70, 60, 75, 85]",
        "output": "[1, 1, 1, 2, 1, 4, 6]",
        "expectedOutput": "[1, 1, 1, 2, 1, 4, 6]",
        "explanation": "each span is computed only from prices at or before that day, exactly as they would arrive one by one"
      },
      {
        "id": "sample_2",
        "type": "reg",
