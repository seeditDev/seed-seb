{
  "id": "find-if-path-exists-in-graph",
  "questionId": "find-if-path-exists-in-graph",
  "slug": "find-if-path-exists-in-graph",
  "title": "Find if Path Exists in Graph",
  "difficulty": "Easy",
  "category": "Graphs",
  "patterns": [
    "graph dfs/bfs",
    "connectivity"
  ],
  "lists": [],
  "hints": [
    "this is really just asking: are source and destination in the same connected component?",
    "build an adjacency list from the edge list first",
    "run a DFS or BFS starting from source, marking visited nodes",
    "return whether destination was ever visited during that traversal, and remember to short-circuit if source equals destination"
  ],
  "commonMistakes": [
    "forgetting the graph is undirected and only adding the edge in one direction",
    "not handling source == destination as trivially true",
    "infinite looping by not tracking visited nodes"
  ],
  "content": {
    "problemStatement": "You're given an undirected graph with `n` nodes, labeled 0 to n-1,\ndescribed by a list of edges where each edge is `[u, v]`, plus a\n`source` node and a `destination` node.\n\n**Return true if there is a path connecting `source` to `destination`, and false otherwise.**\n\nA path of zero edges counts, so if `source` equals `destination` the answer is always true.\n",
    "constraints": [
      "1 <= n <= 200000",
      "edges are undirected, no self loops or repeated edges",
      "0 <= source, destination < n"
    ],
    "notes": [
      "source equals destination",
      "graph with no edges at all",
      "single node graph",
      "source and destination in different connected components"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "n = 3, edges = [[0,1],[1,2],[2,0]], source = 0, destination = 2",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "0 -> 1 -> 2 is a valid path"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "n = 6, edges = [[0,1],[0,2],[3,5],[5,4],[4,3]], source = 0, destination = 5",
        "output": "false",
        "expectedOutput": "false",
        "explanation": "nodes 0-1-2 form one component and 3-4-5 form a separate component"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "n = 1, edges = [], source = 0, destination = 0",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "source and destination are the same node, so no edges are needed"
      }
    ],
