  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def countElements(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        mn = min(nums)\n        mx = max(nums)\n        return sum(mn < x < mx for x in nums)"
    },
