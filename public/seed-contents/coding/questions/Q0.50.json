  "solution": {
    "approach": "Print numbers from 1 to n, each on a new line.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int n, i = 1;\n    if (scanf(\"%d\", &n) == 1) {\nloop:\n        if (i <= n) {\n            printf(\"%d\\n\", i);\n            i++;\n            goto loop;\n        }\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int n, i = 1;\n    if (cin >> n) {\nloop:\n        if (i <= n) {\n            cout << i << \"\\n\";\n            i++;\n            goto loop;\n        }\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            for (int i = 1; i <= n; i++) {\n                System.out.println(i);\n            }\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        n = int(s)\n        for i in range(1, n + 1):\n            print(i)\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const n = parseInt(s, 10);\n        for (let i = 1; i <= n; i++) {\n            console.log(i);\n        }\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Loop from i = 1 to n and print each number on a new line."
  },
