  "solution": {
    "approach": "Print an X-shaped number pattern of height 2N - 1.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    for (int i = 1; i < n; i++) {\n        for (int s = 0; s < i - 1; s++) printf(\" \");\n        printf(\"%d\", i);\n        for (int s = 0; s < 2 * (n - i) - 1; s++) printf(\" \");\n        printf(\"%d\\n\", i);\n    }\n    for (int s = 0; s < n - 1; s++) printf(\" \");\n    printf(\"%d\\n\", n);\n    for (int i = n - 1; i >= 1; i--) {\n        for (int s = 0; s < i - 1; s++) printf(\" \");\n        printf(\"%d\", i);\n        for (int s = 0; s < 2 * (n - i) - 1; s++) printf(\" \");\n        printf(\"%d\\n\", i);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    for (int i = 1; i < n; i++) {\n        cout << string(i - 1, ' ') << i << string(2 * (n - i) - 1, ' ') << i << \"\\n\";\n    }\n    cout << string(n - 1, ' ') << n << \"\\n\";\n    for (int i = n - 1; i >= 1; i--) {\n        cout << string(i - 1, ' ') << i << string(2 * (n - i) - 1, ' ') << i << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            StringBuilder sb = new StringBuilder();\n            for (int i = 1; i < n; i++) {\n                sb.append(\" \".repeat(i - 1)).append(i).append(\" \".repeat(2 * (n - i) - 1)).append(i).append(\"\\n\");\n            }\n            sb.append(\" \".repeat(n - 1)).append(n).append(\"\\n\");\n            for (int i = n - 1; i >= 1; i--) {\n                sb.append(\" \".repeat(i - 1)).append(i).append(\" \".repeat(2 * (n - i) - 1)).append(i).append(\"\\n\");\n            }\n            System.out.print(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    lines = []\n    for i in range(1, n):\n        lines.append(\" \" * (i - 1) + str(i) + \" \" * (2 * (n - i) - 1) + str(i))\n    lines.append(\" \" * (n - 1) + str(n))\n    for i in range(n - 1, 0, -1):\n        lines.append(\" \" * (i - 1) + str(i) + \" \" * (2 * (n - i) - 1) + str(i))\n    print(\"\\n\".join(lines))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const lines = [];\n    for (let i = 1; i < n; i++) {\n        lines.push(\" \".repeat(i - 1) + i + \" \".repeat(2 * (n - i) - 1) + i);\n    }\n    lines.push(\" \".repeat(n - 1) + n);\n    for (let i = n - 1; i >= 1; i--) {\n        lines.push(\" \".repeat(i - 1) + i + \" \".repeat(2 * (n - i) - 1) + i);\n    }\n    console.log(lines.join(\"\\n\"));\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Print top inverted V from 1 to N-1, center line N, and bottom V from N-1 down to 1."
  },
