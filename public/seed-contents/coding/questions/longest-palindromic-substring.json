{
  "id": "longest-palindromic-substring",
  "questionId": "longest-palindromic-substring",
  "slug": "longest-palindromic-substring",
  "title": "Longest Palindromic Substring",
  "difficulty": "Medium",
  "category": "Two pointers",
  "patterns": [
    "two pointers",
    "strings",
    "dynamic programming"
  ],
  "lists": [
    "blind-75",
