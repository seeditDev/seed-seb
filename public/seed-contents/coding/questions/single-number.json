  "title": "Single Number",
  "difficulty": "Easy",
  "category": "Bit manipulation",
  "patterns": [
    "bit manipulation",
    "xor"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "what does a number XORed with itself give you? what does a number XORed with 0 give you?",
    "if every number except one appears exactly twice, what happens if you XOR the entire array together?",
    "XOR is commutative and associative, so order doesn't matter - all the paired numbers cancel each other out",
    "start an accumulator at 0, XOR every element of the array into it, and the accumulator ends up holding the single number"
  ],
  "commonMistakes": [
    "reaching for a hash map or sorting when O(1) space is achievable with a single XOR pass",
    "forgetting to initialize the running XOR to 0 before the loop",
    "assuming XOR only works for exactly two numbers instead of an entire array at once"
  ],
  "content": {
    "problemStatement": "You're given a list of integers where every number appears exactly twice\nexcept for one number, which appears exactly once.\n\n**Return that lone number.**\n",
    "constraints": [
      "1 <= nums.length <= 3 * 10^4",
      "-2^31 <= nums[i] <= 2^31 - 1",
      "each element in nums appears exactly twice, except for one element which appears exactly once"
    ],
    "notes": [
      "the array has only one element",
      "the single number is negative",
      "the single number is at the start or end of the array"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
