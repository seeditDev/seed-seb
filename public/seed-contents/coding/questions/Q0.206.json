  "solution": {
    "approach": "Generate the first N Catalan numbers.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long c = 1;\n    printf(\"%lld\", c);\n    for (int i = 0; i < n - 1; i++) {\n        c = c * 2 * (2 * i + 1) / (i + 2);\n        printf(\" %lld\", c);\n    }\n    printf(\"\\n\");\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    long long c = 1;\n    cout << c;\n    for (int i = 0; i < n - 1; i++) {\n        c = c * 2 * (2 * i + 1) / (i + 2);\n        cout << \" \" << c;\n    }\n    cout << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long c = 1;\n            StringBuilder sb = new StringBuilder();\n            sb.append(c);\n            for (int i = 0; i < n - 1; i++) {\n                c = c * 2 * (2 * i + 1) / (i + 2);\n                sb.append(\" \").append(c);\n            }\n            System.out.println(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks:\n        n = int(toks[0])\n        res = [1]\n        for i in range(n - 1):\n            res.append(res[-1] * 2 * (2 * i + 1) // (i + 2))\n        print(\" \".join(str(x) for x in res[:n]))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) {\n        const n = parseInt(toks[0], 10);\n        const res = [1n];\n        for (let i = 0; i < n - 1; i++) {\n            const bi = BigInt(i);\n            res.push(res[res.length - 1] * 2n * (2n * bi + 1n) / (bi + 2n));\n        }\n        console.log(res.slice(0, n).map(x => x.toString()).join(\" \"));\n    }\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Use recurrence C_0 = 1, C_{i+1} = C_i * 2*(2i+1)/(i+2) to generate first N terms."
