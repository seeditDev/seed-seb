{
  "id": "interval-list-total-coverage",
  "questionId": "interval-list-total-coverage",
  "slug": "interval-list-total-coverage",
  "title": "Interval List Total Coverage",
  "difficulty": "Easy",
  "category": "Merge intervals",
  "patterns": [
    "merge intervals",
    "sorting"
  ],
  "lists": [],
  "hints": [
    "counting individual points one by one is wasteful when intervals can be large - can you count a whole merged range at once?",
    "sort the intervals by start time so overlapping ones become adjacent",
    "sweep through, merging any interval that overlaps or touches the current merged range by extending its end",
    "whenever the next interval starts after the current merged range ends (a genuine gap), add (end - start + 1) points from the finished merged range to your total, then start a new merged range",
    "don't forget to add the final merged range's points after the loop"
  ],
  "commonMistakes": [
    "double-counting points that fall in the overlap between two intervals by summing (end - start + 1) for each interval independently instead of merging first",
    "using end - start instead of end - start + 1 since endpoints are inclusive",
    "treating touching intervals like [1,3] and [4,6] as overlapping when they actually only touch after merging logic if consecutive, or vice versa mishandling the boundary condition"
  ],
  "content": {
    "problemStatement": "You're given a list of intervals, each represented as `[start, end]`\nusing inclusive integer endpoints. Intervals may overlap each other.\n\n**Return the total number of unique integer points that are covered by\nat least one interval.**\n",
    "constraints": [
      "0 <= intervals.length <= 10^4",
      "0 <= start <= end <= 10^6"
    ],
    "notes": [
      "empty list of intervals (coverage is 0)",
      "a single interval",
      "all intervals overlap into one big merged range",
      "no intervals overlap at all",
      "one interval is fully contained inside another"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
