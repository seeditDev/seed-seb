  "solution": {
    "approach": "Find minimum element in an array of N integers.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long min_v, x; scanf(\"%lld\", &min_v);\n    for (int i = 1; i < n; i++) { scanf(\"%lld\", &x); if (x < min_v) min_v = x; }\n    printf(\"%lld\\n\", min_v);\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    long long min_v, x; cin >> min_v;\n    for (int i = 1; i < n; i++) { cin >> x; if (x < min_v) min_v = x; }\n    cout << min_v << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long minV = sc.nextLong();\n            for (int i = 1; i < n; i++) {\n                long x = sc.nextLong();\n                if (x < minV) minV = x;\n            }\n            System.out.println(minV);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    nums = [int(x) for x in toks[1:n+1]]\n    print(min(nums))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    let minV = BigInt(toks[1]);\n    for (let i = 2; i <= n; i++) {\n        const x = BigInt(toks[i]);\n        if (x < minV) minV = x;\n    }\n    console.log(minV.toString());\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Iterate through N elements maintaining the minimum observed value."
  },
