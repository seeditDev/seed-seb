{
  "id": "course-schedule",
  "questionId": "course-schedule",
  "slug": "course-schedule",
  "title": "Course Schedule",
  "difficulty": "Easy",
  "category": "Topological sort",
  "patterns": [
    "topological sort",
    "graph",
    "cycle detection"
  ],
  "lists": [],
  "hints": [
    "if a valid order exists, some course must have zero prerequisites remaining at each step - which courses can you always take first?",
    "count how many prerequisites (in-degree) each course still needs; courses with in-degree 0 are safe to take right now",
    "process courses with in-degree 0, remove their outgoing edges (decrement in-degree of courses that depended on them), and repeat",
    "if you can process all numCourses this way, there's no cycle; if you get stuck with courses remaining, a cycle exists"
  ],
  "commonMistakes": [
    "forgetting to handle numCourses = 0 or courses with no prerequisites at all",
    "building the adjacency list in the wrong direction (treating the prerequisite as the dependent course or vice versa)",
    "using a plain DFS without tracking the current recursion path, which fails to detect cycles correctly"
  ],
  "content": {
    "problemStatement": "There are `numCourses` courses, labeled 0 to numCourses - 1. You're given a\nlist of `prerequisites` pairs, where each pair [a, b] means you must\ncomplete course b before you can take course a.\n\n**Determine whether it's possible to finish all courses given these constraints.**\n\nReturn true if it is, false otherwise, which happens when the prerequisites form a cycle, making some courses impossible to ever unlock.\n",
    "constraints": [
      "0 <= numCourses <= 10^4",
      "each prerequisite pair [a, b] has 0 <= a, b < numCourses",
      "a course can appear as a prerequisite for more than one other course"
    ],
    "notes": [
      "numCourses = 0 (no courses at all, trivially finishable)",
      "a single course with no prerequisites",
      "a self-loop prerequisite like [0, 0], which is itself a cycle",
      "a cycle hidden among otherwise unrelated, disconnected courses"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "numCourses = 2, prerequisites = [[1, 0]]",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "take course 0 first, then course 1"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "numCourses = 2, prerequisites = [[1, 0], [0, 1]]",
        "output": "false",
        "expectedOutput": "false",
        "explanation": "course 1 needs course 0, and course 0 needs course 1 - neither can ever start"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "numCourses = 4, prerequisites = [[1, 0], [2, 0], [3, 1], [3, 2]]",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "one valid order is 0, 1, 2, 3"
      }
    ],
