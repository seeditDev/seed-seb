  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# hash table\nclass Solution(object):\n    def findMaxK(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        lookup = set(nums)\n        return max([x for x in lookup if x > 0 and -x in lookup] or [-1])"
    },
