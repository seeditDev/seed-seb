        "type": "reg",
        "input": "points = [[10,16],[2,8],[1,6],[7,12]]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "one arrow at x=6 bursts [2,8] and [1,6]; another at x=11 bursts [10,16] and [7,12]"
      },
      {
