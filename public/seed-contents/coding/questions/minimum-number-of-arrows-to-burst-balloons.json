  "questionId": "minimum-number-of-arrows-to-burst-balloons",
  "slug": "minimum-number-of-arrows-to-burst-balloons",
  "title": "Minimum Number of Arrows to Burst Balloons",
  "difficulty": "Medium",
  "category": "Merge intervals",
  "patterns": [
    "merge intervals",
    "greedy",
    "sorting"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "this is the same shape as scheduling the maximum non-overlapping intervals, but phrased as 'how few arrows (points) can hit every interval'",
    "sort the balloons by their end coordinate",
    "shoot your first arrow at the end of the first balloon in sorted order - that's the best place to burst as many overlapping balloons as possible",
    "any subsequent balloon whose start is <= that arrow's position is also burst by it and can be skipped; the first balloon whose start is greater needs a new arrow, placed at its end"
  ],
  "commonMistakes": [
    "sorting by start instead of end, which doesn't guarantee the greedy arrow placement is optimal",
    "using strict less-than instead of <= when checking if a balloon's start is covered by the current arrow, mishandling balloons that only touch",
    "counting overlaps directly instead of simulating the greedy arrow placement pass"
  ],
  "content": {
    "problemStatement": "There are a number of spherical balloons taped onto a wall, each represented by a horizontal diameter given as `[start, end]`. You shoot arrows straight up along the wall; an arrow shot at horizontal position x bursts every balloon whose diameter range contains x, inclusive of the endpoints.\n\n**Return the minimum number of arrows needed to burst every balloon.**\n",
    "constraints": [
      "0 <= points.length <= 10^5",
      "points[i].length == 2",
      "-2^31 <= points[i][0] <= points[i][1] <= 2^31 - 1"
    ],
    "notes": [
      "empty list of balloons (answer 0)",
      "a single balloon",
      "all balloons overlap at one common point",
      "no balloons overlap at all",
      "balloons that only touch at an endpoint"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
