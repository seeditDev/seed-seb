  "content": {
    "problemStatement": "You're given an array of integers where no two adjacent elements are\nequal. A peak element is one that is strictly greater than its\nneighbors, treating the positions just off the left and right ends of\nthe array as negative infinity, so an end element only needs to beat its\none real neighbor.\n\n**Return the index of any peak element.**\n\nIf there are multiple peaks, returning the index of any one of them is accepted. You must do this faster than a plain linear scan.",
    "constraints": [
      "1 <= nums.length <= 1000",
      "-2^31 <= nums[i] <= 2^31 - 1",
      "nums[i] != nums[i + 1] for all valid i"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [1, 2, 3, 1]",
        "output": "2",
        "explanation": "3 is greater than both of its neighbors, 2 and 1"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [1, 2, 3, 4, 3, 2, 1]",
        "output": "3",
        "explanation": "4 is the single peak, greater than both 3 (on the left) and 3 (on the right)"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "nums = [1, 2, 1, 3, 5, 6, 4]",
        "output": "5 (or 1)",
        "explanation": "there are two peaks here, index 1 (value 2) and index 5 (value 6) - either is a valid answer"
      }
    ],
