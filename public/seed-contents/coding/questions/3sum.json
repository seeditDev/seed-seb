    "constraints": [
      "0 <= nums.length <= 3000",
      "-10^5 <= nums[i] <= 10^5"
    ],
    "notes": [
      "array with fewer than 3 elements (answer is empty)",
      "many duplicate values in the array",
      "no triplet sums to zero (answer is empty)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
