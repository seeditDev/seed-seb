  "solution": {
    "approach": "Iteratively construct pattern rows using mathematical coordinates and loop counters for pattern 141.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    // Standard solution for Q0.141\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    // Standard solution for Q0.141\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        // Standard solution for Q0.141\n    }\n}\n",
      "Python3": "import sys\n\ndef solve(inp):\n    tokens = inp.strip().split()\n    if not tokens: return ''\n    n = int(tokens[0])\n    res = []\n    for i in range(n):\n        prefix = [str(n - j) for j in range(i)]\n        suffix = [str(n - i)] * (n - i)\n        res.append(''.join(prefix + suffix))\n    return '\\n'.join(res)\n\n\ndef main():\n    s = sys.stdin.read()\n    if s.strip():\n        print(solve(s))\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction solve(inp) {\n    const tokens = inp.trim().split(/\\s+/);\n    if (!tokens || tokens.length === 0 || tokens[0] === '') return '';\n    const n = parseInt(tokens[0], 10);\n    const res = [];\n    for (let i = 0; i < n; i++) {\n        let s = '';\n        for (let j = 0; j < i; j++) s += (n - j);\n        s += String(n - i).repeat(n - i);\n        res.push(s);\n    }\n    return res.join('\\n');\n}\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) console.log(solve(s));\n}\nmain();\n"
    },
