  "content": {
    "problemStatement": "You're given a space-delimited sequence of tokens representing an\narithmetic expression in Reverse Polish Notation (postfix notation). Each\ntoken is either an integer or one of the operators `+`, `-`, `*`, `/`, and\nin RPN an operator always applies to the two numbers immediately before\nit.\n\n**Evaluate the expression and return the result.**\n\nDivision between two integers truncates toward zero, not floor division.",
    "constraints": [
      "1 <= number of tokens <= 10^4",
      "each token is an integer in [-200, 200] or one of the operators +, -, *, /",
      "the answer and all intermediate results fit in a 32-bit signed integer",
      "division truncates toward zero, not floor division"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "tokens = \"2 1 + 3 *\"",
        "output": "9",
        "explanation": "2 1 + evaluates to 3, then 3 3 * evaluates to 9"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "tokens = \"4 13 5 / +\"",
        "output": "6",
        "explanation": "13 5 / truncates to 2, then 4 2 + evaluates to 6"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "tokens = \"10 6 9 3 + -11 * / * 17 + 5 +\"",
        "output": "22",
        "explanation": "9 3 + = 12; -11 * 12 = -132; 6 -132 / truncates to 0; 10 0 * = 0; 0 17 + = 17; 17 5 + = 22"
      }
    ],
    "notes": []
  },
