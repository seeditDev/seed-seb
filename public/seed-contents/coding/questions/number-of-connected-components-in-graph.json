{
  "id": "number-of-connected-components-in-graph",
  "questionId": "number-of-connected-components-in-graph",
  "slug": "number-of-connected-components-in-graph",
  "title": "Number of Connected Components in an Undirected Graph",
  "difficulty": "Easy",
  "category": "Union find",
  "patterns": [
    "union find",
    "connected components"
  ],
  "lists": [],
  "hints": [
    "start with n separate components, one per node",
    "each time you union two nodes that were not already in the same component, the component count drops by one",
    "initialize a parent array of size n and a running count = n",
    "for each edge, find the roots of both endpoints; if they differ, union them and decrement count",
    "use path compression so repeated find() calls stay fast"
  ],
  "commonMistakes": [
    "decrementing the component count even when both endpoints are already in the same component",
    "not initializing every node from 0 to n-1 as its own parent up front, even nodes with no edges",
    "forgetting path compression and taking an O(n) hit per find on a long union chain"
  ],
  "content": {
    "problemStatement": "You have a graph with n nodes labeled 0 to n-1, described by a list of undirected `edges`, where each edge is a pair `[u, v]`.\n\n**Return the number of connected components in the graph.**\n",
    "constraints": [
      "1 <= n <= 2000",
      "0 <= edges.length <= n * (n - 1) / 2",
      "edges are undirected, no self loops or repeated edges"
    ],
    "notes": [
      "no edges at all - every node is isolated",
      "a single node",
      "a graph that is already fully connected",
      "several small disconnected clusters"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "n = 5, edges = [[0,1],[1,2],[3,4]]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "nodes 0-1-2 form one component, nodes 3-4 form another"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "n = 5, edges = [[0,1],[1,2],[2,3],[3,4]]",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "all five nodes are chained together into one component"
