    "constraints": [
      "1 ≤ n ≤ 10^5",
      "0 ≤ k ≤ 10^9"
    ],
    "inputFormat": "n k d\na1 a2 a3 ... an\nn = size of array\n\nk = number of rotations\n\nd = direction (L or R)",
    "outputFormat": "Rotated array",
