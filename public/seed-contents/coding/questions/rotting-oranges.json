{
  "id": "rotting-oranges",
  "questionId": "rotting-oranges",
  "slug": "rotting-oranges",
  "title": "Rotting Oranges",
  "difficulty": "Medium",
  "category": "Graphs",
  "patterns": [
    "graph dfs/bfs",
    "multi-source bfs",
    "grid traversal"
  ],
  "lists": [
    "grind-75"
  ],
  "hints": [
    "rot doesn't spread from just one source, it spreads from every rotten orange at once - that's a multi-source BFS",
    "start by putting every initially rotten orange's coordinates into a queue, all at 'minute 0'",
    "process the queue level by level (minute by minute); each fresh orange adjacent to something in the current level becomes rotten and joins the next level",
    "track the minute count as you process levels, and after BFS finishes, check whether any fresh orange was never reached"
  ],
  "commonMistakes": [
    "starting BFS from only one rotten orange instead of all of them simultaneously",
    "forgetting to check at the end whether any fresh oranges remain unreached, which should return -1",
    "off-by-one errors in the minute count, especially when there were zero fresh oranges to begin with"
  ],
  "content": {
    "problemStatement": "You're given a grid where each cell is 0 (empty), 1 (a fresh orange), or\n2 (a rotten orange). Every minute, any fresh orange that is horizontally\nor vertically adjacent to a rotten orange becomes rotten too.\n\n**Return the minimum number of minutes that must pass until no fresh orange remains, or -1 if that's impossible.**\n",
    "constraints": [
      "1 <= rows, cols <= 10",
      "grid[i][j] is 0, 1, or 2",
      "rows == grid.length and cols == grid[i].length for every row"
    ],
    "notes": [
      "no fresh oranges at all (answer is 0)",
      "no rotten oranges but at least one fresh orange (answer is -1)",
      "a fresh orange completely walled off by empty cells",
      "grid entirely rotten already"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "grid = [[2,1,1],[1,1,0],[0,1,1]]",
        "output": "4",
        "expectedOutput": "4",
        "explanation": "rot spreads outward minute by minute from the initial rotten orange until every fresh orange is reached"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "grid = [[2,1,1],[0,1,1],[1,0,1]]",
        "output": "-1",
        "expectedOutput": "-1",
        "explanation": "the fresh orange in the bottom-left corner is isolated by empty cells and can never rot"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "grid = [[0,2]]",
        "output": "0",
        "expectedOutput": "0",
        "explanation": "there are no fresh oranges to begin with"
