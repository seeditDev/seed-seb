{
  "id": "number-of-islands-ii",
  "questionId": "number-of-islands-ii",
  "slug": "number-of-islands-ii",
  "title": "Number of Islands II",
  "difficulty": "Hard",
  "category": "Union find",
  "patterns": [
    "union find",
    "grid",
    "online queries"
  ],
  "lists": [],
  "hints": [
    "keep a union-find structure sized for the whole grid, plus a set (or boolean grid) tracking which cells are currently land, and a running island count",
    "when a position repeats an already-land cell, just record the current count again and move to the next operation - nothing changes",
    "when a new land cell appears, first count it as its own island (count += 1)",
    "then check its up to 4 neighbors - for each one that is already land and in a DIFFERENT component, union them and count -= 1",
    "append the running count after processing each operation, in order"
  ],
  "commonMistakes": [
    "recomputing islands from scratch on every operation instead of updating incrementally",
    "not checking whether a position was already land before processing it as brand new",
    "decrementing the count once per land neighbor instead of only when that neighbor is in a genuinely different component (double-decrementing when two neighbors already share a root)"
  ],
  "content": {
    "problemStatement": "You're given the dimensions `m` and `n` of a grid that starts entirely as water, along with a sequence of \"add land\" `positions`, each given as `[r, c]`. After each operation, that cell becomes land, and if it was already land, the operation has no additional effect. An island is a maximal group of land cells connected horizontally or vertically.\n\n**Return an array where the i-th value is the number of islands in the grid immediately after the i-th operation.**\n",
    "constraints": [
      "1 <= m, n <= 100000",
      "0 <= positions.length <= 10000",
      "positions may repeat an already-land cell"
    ],
    "notes": [
      "no operations at all",
      "the same position added more than once in a row",
      "an operation that bridges two previously separate islands into one",
      "a 1x1 grid"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "m = 3, n = 3, positions = [[0,0],[0,1],[1,2],[2,1]]",
        "output": "[1,1,2,3]",
        "expectedOutput": "[1,1,2,3]",
        "explanation": "the first two land cells merge into one island; the next two each start their own separate island"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "m = 1, n = 1, positions = [[0,0],[0,0]]",
        "output": "[1,1]",
        "expectedOutput": "[1,1]",
        "explanation": "the second operation repeats an already-land cell and changes nothing"
      },
      {
        "id": "sample_3",
        "type": "reg",
