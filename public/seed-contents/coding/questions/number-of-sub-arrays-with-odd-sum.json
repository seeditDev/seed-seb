      "1 <= arr.length <= 10^5",
      "-100 <= arr[i] <= 100",
      "the answer is returned modulo 1,000,000,007"
    ],
    "notes": [
      "every element is even (answer is 0)",
      "every element is odd",
      "a single element array"
    ],
    "inputFormat": "Arguments passed into solution function",
