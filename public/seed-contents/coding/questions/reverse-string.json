      "0 <= s.length <= 10^5",
      "s consists of printable ASCII characters"
    ],
    "notes": [
      "empty string",
      "single character",
      "string with repeated characters"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
