{
  "id": "assign-cookies",
  "questionId": "assign-cookies",
  "slug": "assign-cookies",
  "title": "Assign Cookies",
  "difficulty": "Easy",
  "category": "Greedy",
  "patterns": [
    "greedy",
    "sorting",
    "two pointers"
  ],
  "lists": [],
  "hints": [
    "if you're going to satisfy the least-greedy child, does it ever help to waste a big cookie on them?",
    "sort both greed factors and cookie sizes ascending",
    "walk both sorted lists with two pointers - if the current cookie satisfies the current child, use it and advance both pointers, otherwise the cookie is too small for anyone remaining, so advance only the cookie pointer",
    "why is it safe to give the smallest sufficient cookie to the smallest greed child, rather than saving that cookie for later? because any child it could satisfy, it can satisfy now, and a bigger cookie might be needed by a greedier child later"
  ],
  "commonMistakes": [
    "matching the largest cookie to the largest greed factor first (greedy from the wrong end wastes big cookies on children who could have been satisfied by small ones, satisfying fewer children overall)",
    "forgetting to sort one or both arrays before the two-pointer sweep",
    "advancing both pointers even when the current cookie is too small to satisfy the current child"
  ],
  "content": {
    "problemStatement": "You're a parent trying to make your children happy with cookies. Each child `i` has a greed factor `g[i]`, the minimum cookie size that will satisfy them, and each cookie `j` has a size `s[j]`.\n\n**Return the maximum number of children you can make content, where a child is content only if they receive one cookie of size at least their greed factor.**\n\nEach cookie can be given to at most one child.\n",
    "constraints": [
      "1 <= number of children, number of cookies (either may be 0)",
      "each cookie can be given to at most one child",
      "a child is content only if their assigned cookie size >= their greed factor"
    ],
    "notes": [
      "no cookies at all (answer is 0)",
      "no children at all (answer is 0)",
      "every cookie is too small for every child",
      "more cookies than children"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "g = [1, 2, 3], s = [1, 1]",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "only the cookie of size 1 can satisfy the child with greed 1, the other cookie satisfies nobody"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "g = [1, 2], s = [1, 2, 3]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "give the size-1 cookie to the child with greed 1 and the size-2 cookie to the child with greed 2"
      }
