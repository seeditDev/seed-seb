  "solution": {
    "approach": "Check if integer string is a palindrome.",
    "timeComplexity": "O(D)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    int l = 0, r = strlen(s) - 1, pal = 1;\n    while (l < r) { if (s[l++] != s[r--]) { pal = 0; break; } }\n    printf(\"%s\\n\", pal ? \"Yes\" : \"No\");\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\n#include <algorithm>\nusing namespace std;\nint main() {\n    string s; if (!(cin >> s)) return 0;\n    string rev = s; reverse(rev.begin(), rev.end());\n    cout << (s == rev ? \"Yes\" : \"No\") << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            String rev = new StringBuilder(s).reverse().toString();\n            System.out.println(s.equals(rev) ? \"Yes\" : \"No\");\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks:\n        s = toks[0]\n        print(\"Yes\" if s == s[::-1] else \"No\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) {\n        const s = toks[0];\n        const rev = s.split(\"\").reverse().join(\"\");\n        console.log(s === rev ? \"Yes\" : \"No\");\n    }\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Compare string S with its reverse. Print 'Yes' if equal, else 'No'."
  },
