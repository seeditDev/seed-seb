  "solution": {
    "approach": "Check if an alphabet character is uppercase or lowercase.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <ctype.h>\n\nint main() {\n    char ch;\n    if (scanf(\" %c\", &ch) == 1) {\n        if (isupper(ch)) printf(\"UPPERCASE\\n\");\n        else printf(\"LOWERCASE\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <cctype>\nusing namespace std;\n\nint main() {\n    char ch;\n    if (cin >> ch) {\n        if (isupper(ch)) cout << \"UPPERCASE\\n\";\n        else cout << \"LOWERCASE\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            char c = sc.next().charAt(0);\n            if (Character.isUpperCase(c)) System.out.println(\"UPPERCASE\");\n            else System.out.println(\"LOWERCASE\");\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        print(\"UPPERCASE\" if s[0].isupper() else \"LOWERCASE\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const c = s[0];\n        console.log(c === c.toUpperCase() ? \"UPPERCASE\" : \"LOWERCASE\");\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Check if 'A' <= c <= 'Z' -> UPPERCASE, else -> LOWERCASE."
  },
