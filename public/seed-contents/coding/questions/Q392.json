  "solution": {
    "notes": [
      "An empty s is always a subsequence of t.",
      "The scan may stop immediately after the last character of s is matched."
    ],
    "approach": "Use two pointers: scan t from left to right while advancing a pointer in s only when the current character matches. The relative order is preserved automatically.",
    "editorial": {
      "better": {
        "complexity": "O(|s|·|t|) time and O(|s|·|t|) space.",
        "description": "Use dynamic programming on prefixes: dp[i][j] records whether the first i characters of s form a subsequence of the first j characters of t. This reduces the exponential search to polynomial time but uses a quadratic table."
      },
      "optimal": {
        "complexity": "O(|s| + |t|) time and O(1) auxiliary space.",
        "description": "Maintain one pointer i into s and scan t once. When t[j] equals s[i], advance i. If i reaches |s|, every character of s has been matched in order; otherwise s is not a subsequence of t."
      },
      "bruteForce": {
        "complexity": "O(2^|t|) time in the worst case and O(|t|) recursion stack space.",
        "description": "Try to choose or skip each character of t recursively and check whether s can be formed in order. This explores exponentially many subsequences and is useful only as a conceptual baseline."
      }
    },
    "timeComplexity": "O(|s| + |t|)",
    "spaceComplexity": "O(1) auxiliary space",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\n#include <stdbool.h>\n\nbool isSubsequence(const char* s, const char* t) {\n    size_t i = 0, n = strlen(s);\n    for (size_t j = 0; t[j] != '\\0'; ++j) {\n        if (i < n && t[j] == s[i]) {\n            ++i;\n            if (i == n) return true;\n        }\n    }\n    return i == n;\n}",
      "C++": "class Solution {\npublic:\n    bool isSubsequence(string s, string t) {\n        size_t i = 0;\n        for (char ch : t) {\n            if (i < s.size() && ch == s[i]) {\n                ++i;\n                if (i == s.size()) return true;\n            }\n        }\n        return i == s.size();\n    }\n};",
      "Java": "class Solution {\n    public boolean isSubsequence(String s, String t) {\n        int i = 0;\n        for (int j = 0; j < t.length(); j++) {\n            if (i < s.length() && t.charAt(j) == s.charAt(i)) {\n                i++;\n                if (i == s.length()) return true;\n            }\n        }\n        return i == s.length();\n    }\n}",
      "Python3": "import sys, json\n\nclass Solution:\n    def isSubsequence(self, s: str, t: str) -> bool:\n        i = 0\n        for ch in t:\n            if i < len(s) and ch == s[i]:\n                i += 1\n                if i == len(s):\n                    return True\n        return i == len(s)",
      "JavaScript": "const readline = require('readline');\n\nvar isSubsequence = function(s, t) {\n    let i = 0;\n    for (const ch of t) {\n        if (i < s.length && ch === s[i]) {\n            i++;\n            if (i === s.length) return true;\n        }\n    }\n    return i === s.length;\n};"
    }
