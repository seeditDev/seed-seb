    "C": "#include <stdio.h>\n#include <string.h>\n#include <stdbool.h>\n\nbool isSubsequence(const char* s, const char* t) {\n    return false;\n}\n\nint main(void) {\n    char line[20050];\n    if (!fgets(line, sizeof(line), stdin)) return 0;\n    char s[101] = {0}, t[10001] = {0};\n    const char* p = strchr(line, '\\\"');\n    if (!p) return 0;\n    ++p;\n    size_t i = 0;\n    while (p[i] && p[i] != '\\\"' && i < sizeof(s)-1) { s[i] = p[i]; ++i; }\n    s[i] = '\\0';\n    p = strchr(p + i + 1, '\\\"');\n    if (!p) return 0;\n    ++p;\n    i = 0;\n    while (p[i] && p[i] != '\\\"' && i < sizeof(t)-1) { t[i] = p[i]; ++i; }\n    t[i] = '\\0';\n    printf(\"%s\\n\", isSubsequence(s, t) ? \"true\" : \"false\");\n    return 0;\n}\n",
    "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nclass Solution {\npublic:\n    bool isSubsequence(string s, string t) {\n        return false;\n    }\n};\n\nstatic pair<string,string> readArgs(const string& line) {\n    string a, b;\n    size_t p = 1;\n    auto read = [&](string& out) {\n        while (p < line.size() && (line[p] == ' ' || line[p] == ',')) ++p;\n        if (p < line.size() && line[p] == '\\\"') ++p;\n        size_t start = p;\n        while (p < line.size() && line[p] != '\\\"') ++p;\n        out = line.substr(start, p - start);\n        if (p < line.size()) ++p;\n    };\n    read(a); read(b);\n    return {a,b};\n}\n\nint main() {\n    string line; getline(cin, line);\n    auto args = readArgs(line);\n    cout << (Solution().isSubsequence(args.first, args.second) ? \"true\" : \"false\") << endl;\n    return 0;\n}\n",
    "Java": "import java.io.*;\nimport java.util.*;\n\nclass Solution {\n    public boolean isSubsequence(String s, String t) {\n        return false;\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine().trim();\n        String[] vals = new String[2];\n        int pos = 1, k = 0;\n        while (pos < line.length() - 1 && k < 2) {\n            while (pos < line.length() - 1 && (line.charAt(pos) == ' ' || line.charAt(pos) == ',')) pos++;\n            int start = ++pos;\n            while (pos < line.length() - 1 && line.charAt(pos) != '\\\"') pos++;\n            vals[k++] = line.substring(start, pos++);\n        }\n        System.out.println(new Solution().isSubsequence(vals[0], vals[1]));\n    }\n}\n",
