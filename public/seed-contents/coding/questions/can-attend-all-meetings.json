{
  "id": "can-attend-all-meetings",
  "questionId": "can-attend-all-meetings",
  "slug": "can-attend-all-meetings",
  "title": "Can Attend All Meetings",
  "difficulty": "Easy",
  "category": "Merge intervals",
  "patterns": [
    "merge intervals",
    "sorting"
  ],
  "lists": [
    "blind-75"
  ],
  "hints": [
    "if the meetings were sorted by start time, could a meeting overlap with anything other than its immediate neighbor?",
    "sort the intervals by start time",
    "walk through the sorted list and compare each meeting's start to the previous meeting's end",
    "if any meeting's start is strictly less than the previous meeting's end, they overlap and the person can't attend both"
  ],
  "commonMistakes": [
    "forgetting to sort before checking adjacency, which misses overlaps between non-adjacent original positions",
    "treating a touching pair like [1,5] and [5,9] as overlapping (should use strict less-than, not less-than-or-equal)",
    "comparing every meeting to every other meeting when a single sorted pass suffices"
  ],
  "content": {
    "problemStatement": "You're given a list of meeting time intervals, each represented as `[start, end]`.\n\n**Determine whether a single person could attend every meeting in the list, meaning no two meetings overlap in time.**\n",
    "constraints": [
      "0 <= intervals.length <= 10^4",
      "intervals[i].length == 2",
      "0 <= intervals[i][0] <= intervals[i][1] <= 10^6"
    ],
    "notes": [
      "empty list of meetings",
      "a single meeting",
      "two meetings that touch exactly at an endpoint (not an overlap)",
      "a meeting fully contained inside another"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "intervals = [[0,30],[5,10],[15,20]]",
        "output": "false",
        "expectedOutput": "false",
        "explanation": "[0,30] overlaps both [5,10] and [15,20]"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "intervals = [[7,10],[2,4]]",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "the two meetings don't overlap"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "intervals = [[1,5],[5,9]]",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "meetings that only touch at an endpoint don't count as overlapping"
