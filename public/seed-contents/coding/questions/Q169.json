  "content": {
    "problemStatement": "You're given an array of integers `nums`.\n\n**Return the value that appears more than `n/2` times, where `n` is the array's length.**\n\nYou can assume such a value always exists.",
    "constraints": [
      "1 <= nums.length <= 5 * 10^4",
      "-10^9 <= nums[i] <= 10^9",
      "the majority element always exists in the array"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
