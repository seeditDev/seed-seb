  "solution": {
    "approach": "Count the number of digits in the given integer.",
    "timeComplexity": "O(D)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) == 1) printf(\"%zu\\n\", strlen(s));\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; if (cin >> s) cout << s.length() << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) System.out.println(sc.next().length());\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks: print(len(toks[0]))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) console.log(toks[0].length);\n}\nmain();\n"
    },
