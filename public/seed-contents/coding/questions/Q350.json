  "boilerPlates": {
    "C": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic int* parse_array(const char* s, int* n) {\n    const char* p = s + 1;\n    int cap = 16, size = 0;\n    int* a = (int*)malloc(cap * sizeof(int));\n    while (*p && *p != ']') {\n        if (*p == ',') { ++p; continue; }\n        char* end; long v = strtol(p, &end, 10);\n        if (size == cap) { cap *= 2; a = (int*)realloc(a, cap * sizeof(int)); }\n        a[size++] = (int)v; p = end;\n    }\n    *n = size; return a;\n}\n\nstatic int intersect(const int* nums1, int n1, const int* nums2, int n2, int* out) {\n    return 0;\n}\n\nint main(void){\n    char line[20000];\n    if(!fgets(line,sizeof(line),stdin)) return 0;\n    char* first=line+1; char* split=first; int depth=0;\n    while(*split){ if(*split=='[') ++depth; else if(*split==']') --depth; else if(*split==',' && depth==0) break; ++split; }\n    char saved=*split; *split='\\0';\n    int n1=0,n2=0; int* a=parse_array(first,&n1); *split=saved;\n    int* b=parse_array(split+1,&n2); int* out=(int*)malloc((n1<n2?n1:n2)*sizeof(int));\n    int m=intersect(a,n1,b,n2,out); printf(\"[\"); for(int i=0;i<m;++i){ if(i) printf(\",\"); printf(\"%d\",out[i]); } printf(\"]\\n\");\n    free(a); free(b); free(out); return 0;\n}\n",
    "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nclass Solution {\npublic:\n    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) {\n        return {};\n    }\n};\n\nstatic vector<string> splitTop(const string& s) {\n    string t = s.substr(1, s.size()-2);\n    vector<string> out; int depth=0, start=0;\n    for (int i=0;i<(int)t.size();++i) {\n        if (t[i]=='[') ++depth; else if (t[i]==']') --depth;\n        else if (t[i]==',' && depth==0) { out.push_back(t.substr(start,i-start)); start=i+1; }\n    }\n    out.push_back(t.substr(start)); return out;\n}\nstatic vector<int> parseArray(const string& s) {\n    string t=s.substr(1,s.size()-2); vector<int> a;\n    if(t.empty()) return a;\n    size_t p=0;\n    while(p<t.size()) { size_t q=t.find(',',p); if(q==string::npos) q=t.size(); a.push_back(stoi(t.substr(p,q-p))); p=q+1; }\n    return a;\n}\nint main(){\n    string line; getline(cin,line);\n    auto parts=splitTop(line);\n    auto nums1=parseArray(parts[0]); auto nums2=parseArray(parts[1]);\n    auto r=Solution().intersect(nums1,nums2);\n    cout<<'['; for(int i=0;i<(int)r.size();++i){ if(i) cout<<','; cout<<r[i]; } cout<<\"]\\n\";\n}\n",
    "Java": "import java.io.*;\nimport java.util.*;\n\nclass Solution {\n    public int[] intersect(int[] nums1, int[] nums2) {\n        return new int[0];\n    }\n}\n\npublic class Main {\n    static List<String> splitTop(String s) {\n        s = s.trim();\n        if (s.startsWith(\"[\") && s.endsWith(\"]\")) s = s.substring(1, s.length() - 1);\n        List<String> parts = new ArrayList<>();\n        int depth = 0, start = 0;\n        for (int i = 0; i < s.length(); i++) {\n            char c = s.charAt(i);\n            if (c == '[') depth++;\n            else if (c == ']') depth--;\n            else if (c == ',' && depth == 0) { parts.add(s.substring(start, i).trim()); start = i + 1; }\n        }\n        if (start < s.length()) parts.add(s.substring(start).trim());\n        return parts;\n    }\n    static int[] parseArray(String s) {\n        List<String> parts = splitTop(s);\n        int[] a = new int[parts.size()];\n        for (int i = 0; i < parts.size(); i++) a[i] = Integer.parseInt(parts.get(i));\n        return a;\n    }\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine();\n        List<String> outer = splitTop(line);\n        int[] nums1 = parseArray(outer.get(0));\n        int[] nums2 = parseArray(outer.get(1));\n        int[] result = new Solution().intersect(nums1, nums2);\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < result.length; i++) { if (i > 0) sb.append(','); sb.append(result[i]); }\n        sb.append(']');\n        System.out.println(sb);\n    }\n}\n",
