{
  "id": "first-unique-character-in-a-string",
  "questionId": "first-unique-character-in-a-string",
  "slug": "first-unique-character-in-a-string",
  "title": "First Unique Character in a String",
  "difficulty": "Easy",
  "category": "Hash map",
  "patterns": [
    "hash map",
    "frequency counting"
  ],
  "lists": [],
  "hints": [
    "checking 'does this character appear again later' by rescanning is wasteful - what if you knew every character's TOTAL count up front?",
    "count every character's frequency across the whole string in one pass",
    "then scan the string again, in order, and return the index of the first character whose total count is exactly 1",
    "two linear passes is still O(n) overall, much better than the nested rescan"
  ],
  "commonMistakes": [
    "returning as soon as a character's count reaches 1 during the FIRST (counting) pass, instead of waiting until the count is final",
    "returning the character itself instead of its index",
    "not handling the case where no unique character exists, forgetting to return -1"
  ],
  "content": {
    "problemStatement": "You're given a string `s`.\n\n**Return the index of the first character that doesn't repeat anywhere else in the string, or -1 if every character repeats.**\n",
    "constraints": [
      "0 <= s.length <= 10^5",
      "s consists of only lowercase English letters"
    ],
    "notes": [
      "every character repeats (return -1)",
      "a single character string (always index 0)",
      "the last character is the only unique one"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
