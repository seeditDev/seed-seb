{
  "id": "roman-to-integer",
  "questionId": "roman-to-integer",
  "slug": "roman-to-integer",
  "title": "Roman to Integer",
  "difficulty": "Easy",
  "category": "Hash map",
  "patterns": [
    "hash map",
    "strings",
    "greedy"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "map each of the seven symbols to its integer value first - that alone handles purely additive numerals like 'LVIII'",
    "the tricky part is subtractive pairs like 'IV' or 'CM', where a smaller symbol comes right before a larger one and should be subtracted instead of added",
    "at each position, compare the current symbol's value to the value of the symbol right after it",
    "if the next symbol's value is strictly greater than the current one's, subtract the current value from your running total instead of adding it; otherwise add it as usual",
    "a single pass with that one-symbol lookahead is enough, no need to special-case each of the six subtractive pairs individually"
  ],
  "commonMistakes": [
    "hardcoding only the additive case and never checking whether the current symbol should be subtracted",
    "off-by-one errors in the lookahead, e.g. comparing a symbol to itself or reading past the end of the string on the last character",
    "assuming every smaller-before-larger occurrence is one of the six valid subtractive pairs instead of just comparing values directly",
    "building a full substitution table for all six pairs instead of the simpler single-pass comparison, and getting the pair list wrong"
  ],
  "content": {
    "problemStatement": "Roman numerals use seven symbols: I (1), V (5), X (10), L (50), C (100), D (500), and M (1000). Normally symbols are written largest to smallest and their values are summed, but six specific pairs use subtractive notation instead, where a smaller-value symbol placed immediately before a larger-value one means \"subtract\" rather than \"add\":\n\n- IV (4), IX (9)\n- XL (40), XC (90)\n- CD (400), CM (900)\n\n**Given a valid roman numeral string, return the integer it represents.**\n",
    "constraints": [
      "1 <= s.length <= 15",
      "s contains only the characters I, V, X, L, C, D, M",
      "s is guaranteed to be a valid roman numeral in the range [1, 3999]"
    ],
    "notes": [
      "a single symbol (e.g. 'M' or 'I')",
      "a numeral made entirely of subtractive pairs (e.g. 'CMXCIX')",
      "the largest representable value, 3999 ('MMMCMXCIX')",
      "a numeral with no subtractive pairs, purely additive (e.g. 'LVIII')"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"III\"",
        "output": "3",
        "expectedOutput": "3",
        "explanation": "three I's summed together: 1 + 1 + 1"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"LVIII\"",
        "output": "58",
        "expectedOutput": "58",
        "explanation": "L = 50, V = 5, III = 3, summed normally: 50 + 5 + 3"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"MCMXCIV\"",
        "output": "1994",
        "expectedOutput": "1994",
        "explanation": "M = 1000, CM = 900 (subtractive), XC = 90 (subtractive), IV = 4 (subtractive): 1000 + 900 + 90 + 4"
      }
    ],
