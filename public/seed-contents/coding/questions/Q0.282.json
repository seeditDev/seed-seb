  "solution": {
    "approach": "Count the number of uppercase characters in the given string.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <ctype.h>\nint main() {\n    char s[1000]; if (!fgets(s, sizeof(s), stdin)) return 0;\n    int cnt = 0;\n    for (int i = 0; s[i]; i++) if (isupper(s[i])) cnt++;\n    printf(\"%d\\n\", cnt);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\n#include <cctype>\nusing namespace std;\nint main() {\n    string s; if (!getline(cin, s)) return 0;\n    int cnt = 0;\n    for (char c : s) if (isupper(c)) cnt++;\n    cout << cnt << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLine()) {\n            String s = sc.nextLine();\n            int cnt = 0;\n            for (char c : s.toCharArray()) if (Character.isUpperCase(c)) cnt++;\n            System.out.println(cnt);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    s = sys.stdin.read().strip()\n    print(sum(1 for c in s if c.isupper()))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const s = fs.readFileSync(0, \"utf-8\").trim();\n    let cnt = 0;\n    for (const c of s) if (c >= \"A\" && c <= \"Z\") cnt++;\n    console.log(cnt);\n}\nmain();\n"
    },
