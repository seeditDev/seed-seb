    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    // Standard solution for Q0.148\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    // Standard solution for Q0.148\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        // Standard solution for Q0.148\n    }\n}\n",
      "Python3": "import sys\n\ndef solve(inp):\n    tokens = inp.strip().split()\n    if not tokens: return ''\n    n = int(tokens[0])\n    nums = [int(x) for x in tokens[1:n + 1]]\n    total = sum(nums)\n    out = [str(total - x) for x in nums]\n    return ' '.join(out)\n\n\ndef main():\n    s = sys.stdin.read()\n    if s.strip():\n        print(solve(s))\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction solve(inp) {\n    const tokens = inp.trim().split(/\\s+/);\n    if (!tokens || tokens.length === 0 || tokens[0] === '') return '';\n    const n = parseInt(tokens[0], 10);\n    const nums = tokens.slice(1, n + 1).map(Number);\n    const total = nums.reduce((a, b) => a + b, 0);\n    return nums.map(x => total - x).join(' ');\n}\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) console.log(solve(s));\n}\nmain();\n"
    },
