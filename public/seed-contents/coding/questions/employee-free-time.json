{
  "id": "employee-free-time",
  "questionId": "employee-free-time",
  "slug": "employee-free-time",
  "title": "Employee Free Time",
  "difficulty": "Medium",
  "category": "Merge intervals",
  "patterns": [
    "merge intervals",
    "sorting"
  ],
  "lists": [],
  "hints": [
    "free time is just the complement of everyone's combined busy time - so first figure out the combined busy time",
    "sort all the given intervals by start time, ignoring which employee they belong to, since you only care about total coverage",
    "sweep through and merge overlapping or touching intervals into a list of non-overlapping busy blocks, exactly like the standard merge intervals problem",
    "walk through the merged busy blocks in order: whenever the next block's start is strictly greater than the previous block's end, that gap [previousEnd, nextStart] is a free time interval"
  ],
  "commonMistakes": [
    "forgetting to merge overlapping busy intervals first before looking for gaps, which produces false gaps that are actually still covered by another employee",
    "including the time before the very first block's start or after the very last block's end as free time, when only gaps strictly between merged blocks should count",
    "treating touching intervals (where one ends exactly where the next starts) as producing a zero-length free interval instead of no gap at all"
  ],
  "content": {
    "problemStatement": "A company has several employees, and you're given everyone's working\nintervals already flattened into a single combined list (not grouped by\nemployee), where each interval is `[start, end]` representing a time\nsomeone was working.\n\n**Return the list of finite gaps, sorted by start time, during which no one at all was working.**\n\nOnly gaps strictly between the earliest start time and the latest end time in the whole schedule count, so time before the first start or after the last end is not included.\n",
    "constraints": [
      "each interval is [start, end] with start <= end",
      "the input is not guaranteed to be sorted",
      "there are at least two intervals in the schedule"
    ],
    "notes": [
      "the merged schedule has no internal gaps at all (return an empty list)",
      "many small intervals scattered with several gaps between them",
      "overlapping intervals from different employees that need to be merged before finding gaps",
      "intervals that only touch at an endpoint (no gap between them)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "schedule = [[1,3],[6,7],[2,4],[8,10]]",
        "output": "[[4,6],[7,8]]",
        "expectedOutput": "[[4,6],[7,8]]",
        "explanation": "merging the working intervals gives [1,4],[6,7],[8,10], so the gaps between them are [4,6] and [7,8]"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "schedule = [[1,5],[2,6]]",
        "output": "[]",
        "expectedOutput": "[]",
        "explanation": "the merged working time is one continuous block [1,6] with no gaps inside it"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "schedule = [[1,2],[5,6],[1,3]]",
        "output": "[[3,5]]",
        "expectedOutput": "[[3,5]]",
        "explanation": "merged busy time is [1,3] and [5,6], leaving the gap [3,5]"
      }
    ],
