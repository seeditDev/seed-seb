  "solution": {
    "approach": "Use nested loops to iterate through rows and columns, printing characters corresponding to the pattern formula.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\nint main() { int n; if(scanf(\"%d\",&n)==1){for(int i=1;i<=n;i++){for(int j=n;j>n-i;j--)printf(\"%d\",j);printf(\"\\n\");}}return 0; }",
      "C++": "#include <iostream>\nusing namespace std;\nint main(){int n;if(cin>>n){for(int i=1;i<=n;i++){for(int j=n;j>n-i;j--)cout<<j;cout<<\"\\n\";}}return 0;}",
      "Java": "import java.util.Scanner;\npublic class Main{public static void main(String[] args){Scanner sc=new Scanner(System.in);if(sc.hasNextInt()){int n=sc.nextInt();for(int i=1;i<=n;i++){StringBuilder sb=new StringBuilder();for(int j=n;j>n-i;j--)sb.append(j);System.out.println(sb);}}}}",
      "Python3": "import sys\ndef pattern(n):\n    return '\\n'.join(''.join(str(j) for j in range(n, n - i, -1)) for i in range(1, n + 1))\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        print(pattern(int(s)))\nmain()",
      "JavaScript": "const fs = require('fs');\nconst s = fs.readFileSync(0, 'utf-8').trim();\nif (s) { const n = parseInt(s, 10); for(let i=1;i<=n;i++){let l='';for(let j=n;j>n-i;j--)l+=j;console.log(l);}}"
    },
