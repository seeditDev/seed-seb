{
  "id": "sqrt-x",
  "questionId": "sqrt-x",
  "slug": "sqrt-x",
  "title": "Integer Square Root",
  "difficulty": "Easy",
  "category": "Binary search",
  "patterns": [
    "binary search"
  ],
  "lists": [],
  "hints": [
    "you don't need to try every candidate answer one at a time - the candidates themselves are sorted in a useful way",
    "as i increases, i * i increases too - that monotonic relationship is exactly what binary search needs",
    "binary search over possible answers from 0 to x: for a candidate mid, is mid * mid too big, too small, or just right",
    "keep the largest mid found so far where mid * mid <= x, shrinking the search space each time; watch for overflow when squaring large mid values"
  ],
  "commonMistakes": [
    "using a built-in sqrt/pow function despite the constraint against it",
    "overflow when computing mid * mid for large x in fixed-width integer languages (use a wider type or divide instead of multiply)",
    "off-by-one, returning the first i where i * i exceeds x instead of the last i where it doesn't"
  ],
  "content": {
    "problemStatement": "You're given a non-negative integer `x`.\n\n**Return the integer square root of x, the largest integer whose square is less than or equal to x.**\n\nYou may not use a built-in square root function.\n",
    "constraints": [
      "0 <= x <= 2^31 - 1"
    ],
    "notes": [
      "x = 0 or x = 1 (answer equals x)",
      "x is a perfect square",
      "x is a large number, so the search range and mid-point math must avoid overflow"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
