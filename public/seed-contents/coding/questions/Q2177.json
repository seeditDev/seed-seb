    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def sumOfThree(self, num):\n        \"\"\"\n        :type num: int\n        :rtype: List[int]\n        \"\"\"\n        return [num//3-1, num//3, num//3+1] if num%3 == 0 else []"
