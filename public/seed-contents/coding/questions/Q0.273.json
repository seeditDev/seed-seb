  "solution": {
    "approach": "Check if lengths match and s2 is a substring of s1 + s1.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s1[1000], s2[1000];\n    if (scanf(\"%s %s\", s1, s2) == 2) {\n        if (strlen(s1) == strlen(s2)) {\n            char double_s1[2000];\n            strcpy(double_s1, s1); strcat(double_s1, s1);\n            if (strstr(double_s1, s2)) { puts(\"Yes\"); return 0; }\n        }\n        puts(\"No\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s1, s2;\n    if (cin >> s1 >> s2) {\n        if (s1.length() == s2.length() && (s1 + s1).find(s2) != string::npos) {\n            cout << \"Yes\\n\";\n        } else {\n            cout << \"No\\n\";\n        }\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s1 = sc.next(), s2 = sc.next();\n            if (s1.length() == s2.length() && (s1 + s1).contains(s2)) System.out.println(\"Yes\");\n            else System.out.println(\"No\");\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    lines = [l.strip() for l in sys.stdin.read().splitlines() if l.strip()]\n    if len(lines) >= 2:\n        s1, s2 = lines[0], lines[1]\n        print(\"Yes\" if len(s1) == len(s2) and s2 in (s1 + s1) else \"No\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const lines = fs.readFileSync(0, \"utf-8\").split(/\\r?\\n/).map(l => l.trim()).filter(Boolean);\n    if (lines.length >= 2) {\n        const s1 = lines[0], s2 = lines[1];\n        console.log((s1.length === s2.length && (s1 + s1).includes(s2)) ? \"Yes\" : \"No\");\n    }\n}\nmain();\n"
    },
