{
  "id": "find-the-highest-altitude",
  "questionId": "find-the-highest-altitude",
  "slug": "find-the-highest-altitude",
  "title": "Find the Highest Altitude",
  "difficulty": "Easy",
  "category": "Prefix sum",
  "patterns": [
    "prefix sum"
  ],
  "lists": [],
  "hints": [
    "the altitude at any point is just the running total of gains up to that point, starting from 0 - which pattern is this?",
    "keep a running altitude starting at 0, and update it by adding each gain in order",
    "track the maximum altitude seen so far as you go, including the starting 0",
    "you never need to store the full altitude history, just the running value and the running max"
  ],
  "commonMistakes": [
    "forgetting that the starting altitude of 0 itself can be the answer (all-negative gains)",
    "returning the last altitude instead of the maximum altitude reached"
  ],
  "content": {
    "problemStatement": "A biker starts a trip at altitude 0. You're given an array of net\naltitude gains between consecutive points on the route, where `gain[i]`\nis the change from point `i` to point `i+1`.\n\n**Return the highest altitude reached anywhere on the trip.**\n",
    "constraints": [
      "1 <= gain.length <= 100",
      "-100 <= gain[i] <= 100"
    ],
    "notes": [
      "all gains are negative (the highest altitude is the starting 0)",
      "a single gain value"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "gain = [-5, 1, 5, 0, -7]",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "altitudes along the way are 0, -5, -4, 1, 1, -6 - the highest is 1"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "gain = [-4, -3, -2, -1, 4, 3, 2]",
