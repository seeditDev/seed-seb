        "type": "reg",
        "input": "nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]",
        "output": "6",
        "expectedOutput": "6",
        "explanation": "the slice [4, -1, 2, 1] has the largest sum, 6"
