  "lists": [
    "blind-75",
    "grind-75",
    "interview-150"
  ],
  "hints": [
    "when you close a bracket, which opening bracket must it match - the earliest unmatched one, or the most recent one?",
    "what data structure naturally gives you 'the most recent unmatched item'?",
    "try a stack: push opening brackets, and on a closing bracket, pop and check it matches",
    "what should happen if you need to pop but the stack is empty, or the string ends with items still on the stack?"
  ],
  "commonMistakes": [
    "not handling an empty stack when a closing bracket appears (index-out-of-range)",
    "forgetting to check the stack is empty at the very end (unmatched opening brackets)",
    "matching by bracket family loosely instead of exact pair type"
  ],
  "content": {
    "problemStatement": "You're given a string `s` made up only of the bracket characters ( ) [ ] { }.\n\n**Decide whether the brackets are \"balanced\": every opening bracket has a matching closing bracket of the same type, and brackets close in the correct nested order.**\n",
    "constraints": [
      "0 <= s.length <= 10^4",
      "s consists only of the characters '(', ')', '[', ']', '{', '}'"
    ],
    "notes": [
      "empty string (valid)",
      "only opening brackets",
      "only closing brackets",
      "correct bracket types but wrong order, e.g. '([)]'"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"()[]{}\"",
        "output": "true",
        "expectedOutput": "true",
        "explanation": ""
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"(]\"",
        "output": "false",
        "expectedOutput": "false",
        "explanation": ""
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"([)]\"",
        "output": "false",
        "expectedOutput": "false",
        "explanation": "the brackets overlap instead of nesting properly - ( opens, then [ opens, but ) closes before ] does"
      }
    ],
