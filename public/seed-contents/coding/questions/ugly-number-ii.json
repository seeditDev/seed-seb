        "type": "reg",
        "input": "n = 10",
        "output": "12",
        "expectedOutput": "12",
        "explanation": "the ugly numbers in order are 1, 2, 3, 4, 5, 6, 8, 9, 10, 12 - the 10th one is 12 (note 7 and 11 are skipped since they have prime factors other than 2, 3, 5)"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "n = 1",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "1 is defined as the first ugly number"
      },
      {
        "id": "sample_3",
