{
  "id": "find-the-index-of-the-first-occurrence-in-a-string",
  "questionId": "find-the-index-of-the-first-occurrence-in-a-string",
  "slug": "find-the-index-of-the-first-occurrence-in-a-string",
  "title": "Find the Index of the First Occurrence in a String",
  "difficulty": "Easy",
  "category": "Two pointers",
  "patterns": [
    "string",
    "two pointers"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "an occurrence at index i means haystack[i:i+len(needle)] equals needle exactly - how many starting positions i are worth checking?",
    "you only need to try i from 0 up to len(haystack) - len(needle), since needle can't fit past that",
    "for each i, compare characters one at a time and bail out early the moment one doesn't match, rather than building the whole substring first",
    "don't forget the needle-is-empty edge case up front, it should short-circuit to 0 before any comparison loop runs"
  ],
  "commonMistakes": [
    "forgetting the empty needle case and returning -1 or crashing instead of 0",
    "iterating i all the way to len(haystack) - 1 instead of stopping at len(haystack) - len(needle), causing out-of-bounds substring comparisons",
    "returning the last matching index instead of the first one found",
    "using string slicing to build a new substring every iteration, which works but silently costs an extra O(m) per comparison instead of comparing in place"
  ],
  "content": {
    "problemStatement": "You're given two strings, `haystack` and `needle`.\n\n**Find the index of the first occurrence of `needle` inside `haystack`, and return that index, or -1 if `needle` does not appear anywhere.**\n\nIf `needle` is empty, return 0, since an empty string is considered to occur at position 0.\n",
    "constraints": [
      "1 <= length of haystack <= 10^4",
      "0 <= length of needle <= 10^4",
      "haystack and needle consist of lowercase English characters only"
    ],
    "notes": [
      "needle is the empty string (should return 0)",
      "needle is longer than haystack (should return -1)",
      "needle equals haystack exactly (should return 0)",
      "needle appears more than once, only the first index should be returned"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "haystack = \"sadbutsad\", needle = \"sad\"",
        "output": "0",
        "expectedOutput": "0",
        "explanation": "\"sad\" first appears starting at index 0"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "haystack = \"leetcode\", needle = \"leeto\"",
        "output": "-1",
        "expectedOutput": "-1",
        "explanation": "\"leeto\" never appears as a contiguous substring of \"leetcode\""
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "haystack = \"hello\", needle = \"ll\"",
        "output": "2",
        "expectedOutput": "2",
