    "constraints": [
      "nums has n elements, each a distinct value in [0, n]",
      "exactly one value in [0, n] is missing from nums"
    ],
    "notes": [
      "the missing number is 0",
      "the missing number is n (the largest possible value)",
      "nums has only one element"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
