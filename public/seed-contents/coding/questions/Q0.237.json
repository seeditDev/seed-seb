  "solution": {
    "approach": "Print frequency of each element in order of its first appearance.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long a[1005]; int counts[1005] = {0}, uniq[1005], u_len = 0;\n    for (int i = 0; i < n; i++) {\n        scanf(\"%lld\", &a[i]);\n        int found = -1;\n        for (int j = 0; j < u_len; j++) if (uniq[j] == a[i]) { found = j; break; }\n        if (found != -1) counts[found]++;\n        else { uniq[u_len] = a[i]; counts[u_len++] = 1; }\n    }\n    for (int i = 0; i < u_len; i++) printf(\"%d:%d\\n\", uniq[i], counts[i]);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <vector>\n#include <map>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    vector<long long> order;\n    map<long long, int> counts;\n    for (int i = 0; i < n; i++) {\n        long long x; cin >> x;\n        if (counts[x] == 0) order.push_back(x);\n        counts[x]++;\n    }\n    for (long long x : order) cout << x << \":\" << counts[x] << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\nimport java.util.LinkedHashMap;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            LinkedHashMap<Long, Integer> map = new LinkedHashMap<>();\n            for (int i = 0; i < n; i++) {\n                long x = sc.nextLong();\n                map.put(x, map.getOrDefault(x, 0) + 1);\n            }\n            for (var entry : map.entrySet()) {\n                System.out.println(entry.getKey() + \":\" + entry.getValue());\n            }\n        }\n    }\n}\n",
      "Python3": "import sys\nfrom collections import OrderedDict\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    arr = [int(x) for x in toks[1:n+1]]\n    counts = OrderedDict()\n    for x in arr: counts[x] = counts.get(x, 0) + 1\n    for k, v in counts.items(): print(f\"{k}:{v}\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const counts = new Map();\n    for (let i = 1; i <= n; i++) counts.set(toks[i], (counts.get(toks[i]) || 0) + 1);\n    for (const [k, v] of counts) console.log(`${k}:${v}`);\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Maintain an ordered map / dictionary of element frequencies and print 'elem:count' per line."
  },
