    "code": {
      "Python3": "import sys\ndef main():\n    parts = sys.stdin.read().split()\n    if not parts: return\n    nums = [int(x) for x in parts]\n    print(len([x for x in nums if x % 2 == 0]))\nif __name__ == '__main__': main()\n"
    }
