{
  "id": "reverse-words-in-a-string",
  "questionId": "reverse-words-in-a-string",
  "slug": "reverse-words-in-a-string",
  "title": "Reverse Words in a String",
  "difficulty": "Medium",
  "category": "Two pointers",
  "patterns": [
    "strings",
    "two pointers"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "the simplest correct approach is to split on whitespace and reverse the resulting list of words - most languages' split already drops empty tokens caused by multiple spaces",
    "if you're asked to avoid extra space (the classic follow-up), think about what happens if you reverse the entire character array first",
    "reversing the whole string reverses the order of the words but also reverses each word's own letters - so what's the fix?",
    "after the full reversal, walk through and reverse each individual word back to normal, using two pointers to find each word's boundaries",
    "handle the spaces last: skip over runs of multiple spaces and any leading/trailing spaces while writing the final compacted result"
  ],
  "commonMistakes": [
    "using a fixed single split(' ') which produces empty-string tokens for consecutive spaces instead of collapsing them",
    "forgetting to strip leading/trailing spaces before or after reversing",
    "reversing the whole string character by character and forgetting to re-reverse each individual word, leaving words spelled backwards",
    "joining the reversed words with more than one space or with no space at all"
  ],
  "content": {
    "problemStatement": "You're given a string `s` that may contain leading spaces, trailing\nspaces, and multiple spaces between words.\n\n**Return a new string with the words in reverse order, separated by exactly one space each, with no leading or trailing spaces.**\n\nA word is defined as a maximal run of non-space characters.\n",
    "constraints": [
      "1 <= s.length <= 10^4",
      "s consists of English letters, digits, and spaces ' '",
      "there is at least one word in s"
    ],
    "notes": [
      "multiple consecutive spaces between two words",
      "leading and/or trailing spaces",
      "a single word with no spaces at all",
      "exactly two words"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"the sky is blue\"",
        "output": "\"blue is sky the\"",
        "expectedOutput": "\"blue is sky the\"",
        "explanation": ""
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"  hello world  \"",
        "output": "\"world hello\"",
        "expectedOutput": "\"world hello\"",
        "explanation": "leading and trailing spaces are removed from the result"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"a good   example\"",
        "output": "\"example good a\"",
        "expectedOutput": "\"example good a\"",
        "explanation": "multiple spaces between words in the input collapse to a single space in the output"
      }
    ],
