{
  "id": "flood-fill",
  "questionId": "flood-fill",
  "slug": "flood-fill",
  "title": "Flood Fill",
  "difficulty": "Easy",
  "category": "Graphs",
  "patterns": [
    "graph dfs/bfs",
    "grid traversal"
  ],
  "lists": [
    "grind-75"
  ],
  "hints": [
    "treat each cell as a node connected to its up/down/left/right neighbors of the same color",
    "run DFS or BFS from the starting cell, only visiting neighbors that still have the original color",
    "recolor a cell the moment you visit it, don't wait - that's what prevents revisiting and infinite loops",
    "handle the case where newColor equals the original color first, otherwise your visited check breaks and you may loop forever"
  ],
  "commonMistakes": [
    "not handling newColor equal to the original color, causing infinite recursion since the 'still original color' check never fails",
    "checking bounds after indexing into the grid instead of before",
    "recoloring only at the end instead of as you visit, allowing a cell to be revisited"
  ],
  "content": {
    "problemStatement": "You're given a grid of integers representing pixel colors, a starting\ncell `(row, col)`, and a new color.\n\n**Change the color of the starting cell and every cell reachable from it by moving up, down, left, or right through cells of the same original color, then return the grid after the fill.**\n",
    "constraints": [
      "1 <= rows, cols <= 50",
      "0 <= row < rows, 0 <= col < cols",
      "0 <= image[i][j], newColor <= 65535"
    ],
    "notes": [
      "newColor is the same as the starting cell's original color",
      "single cell grid",
      "starting cell's region covers the entire grid",
      "starting cell is isolated (no same-colored neighbors)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "image = [[1,1,1],[1,1,0],[1,0,1]], row = 1, col = 1, newColor = 2",
        "output": "[[2,2,2],[2,2,0],[2,0,1]]",
        "expectedOutput": "[[2,2,2],[2,2,0],[2,0,1]]",
        "explanation": "starting at (1,1) which is color 1, the connected region of 1s reachable from it becomes 2"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "image = [[0,0,0],[0,0,0]], row = 0, col = 0, newColor = 0",
        "output": "[[0,0,0],[0,0,0]]",
        "expectedOutput": "[[0,0,0],[0,0,0]]",
        "explanation": "the new color equals the starting color, so nothing changes (and we don't need to reprocess)"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "image = [[1]], row = 0, col = 0, newColor = 5",
        "output": "[[5]]",
        "expectedOutput": "[[5]]",
        "explanation": ""
      }
