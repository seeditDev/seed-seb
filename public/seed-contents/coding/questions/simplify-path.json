{
  "id": "simplify-path",
  "questionId": "simplify-path",
  "slug": "simplify-path",
  "title": "Simplify Path",
  "difficulty": "Medium",
  "category": "Stack",
  "patterns": [
    "stack"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "split the path on '/' to get individual components; empty strings from consecutive slashes and single-dot components can just be skipped",
    "\"..\" means 'undo the most recently entered directory' - what structure naturally supports undoing the most recent addition?",
    "keep a stack of real directory names: push a name when you see one, and pop (if non-empty) when you see \"..\"",
    "at the end, join the stack's contents with '/' and prefix with a leading '/'; if the stack is empty, the answer is just \"/\""
  ],
  "commonMistakes": [
    "popping from an empty stack on \"..\" instead of treating it as a no-op at the root",
    "not filtering out empty strings produced by consecutive slashes when splitting the path",
    "forgetting the special case where the final simplified path is just the root, producing an empty string instead of \"/\""
  ],
  "content": {
    "problemStatement": "You're given a string representing an absolute Unix-style file path,\nstarting with '/'. The path may contain single dots (\".\", meaning stay\nin the current directory), double dots (\"..\", meaning move up to the\nparent directory), multiple consecutive slashes, and a trailing slash.\n\n**Return the simplified canonical path.**\n\nThe result must start with a single '/', use exactly one '/' between directory names, contain no trailing slash (unless the whole path is just the root \"/\"), and must not contain any \".\" or \"..\" components. Attempting to go above the root simply stays at the root.\n",
    "constraints": [
      "1 <= path.length <= 3000",
      "path consists of English letters, digits, '.', '/', or '_'",
      "path is a valid absolute Unix-style path starting with '/'"
    ],
    "notes": [
      "\"..\" that would go above the root directory (stays at root)",
      "a path that simplifies all the way down to just \"/\"",
      "many consecutive slashes in a row"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "path = \"/home/\"",
        "output": "\"/home\"",
        "expectedOutput": "\"/home\"",
        "explanation": "trailing slash is removed"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "path = \"/home//foo/\"",
        "output": "\"/home/foo\"",
        "expectedOutput": "\"/home/foo\"",
        "explanation": "consecutive slashes collapse into one separator"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "path = \"/a/./b/../../c/\"",
        "output": "\"/c\"",
        "expectedOutput": "\"/c\"",
        "explanation": "\".\" is a no-op, and each \"..\" pops one directory: a -> a/b -> a (via ..) -> empty (via ..) -> c"
      }
    ],
