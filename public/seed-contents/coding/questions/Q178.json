  "solution": {
    "approach": "Process inputs via standard stream input and apply required transformations.",
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "code": {
      "Python3": "import sys\ndef main():\n    parts = sys.stdin.read().split()\n    if len(parts) < 2: return\n    num, digit = parts[0], parts[1]\n    print(num.count(digit))\nif __name__ == '__main__': main()\n"
    }
  },
