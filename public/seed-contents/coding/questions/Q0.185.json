  "solution": {
    "approach": "Replace all occurrences of character d1 with d2 in string S.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    char s[1005], d1[10], d2[10];\n    if (scanf(\"%s %s %s\", s, d1, d2) != 3) return 0;\n    for (int i = 0; s[i]; i++) {\n        if (s[i] == d1[0]) s[i] = d2[0];\n    }\n    printf(\"%s\\n\", s);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s, d1, d2;\n    if (cin >> s >> d1 >> d2) {\n        for (char &c : s) if (c == d1[0]) c = d2[0];\n        cout << s << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next(), d1 = sc.next(), d2 = sc.next();\n            System.out.println(s.replace(d1, d2));\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if len(toks) >= 3:\n        print(toks[0].replace(toks[1], toks[2]))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks.length >= 3) {\n        console.log(toks[0].split(toks[1]).join(toks[2]));\n    }\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Iterate through string S, replacing occurrences of d1 with d2."
