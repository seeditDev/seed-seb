        "type": "reg",
        "input": "nums = [3, 2, 0, -4], pos = 1",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "the cycle begins at index 1 (value 2)"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [1, 2], pos = 0",
        "output": "0",
        "expectedOutput": "0",
        "explanation": "the cycle begins at index 0 (value 1)"
      },
