  "solution": {
    "approach": "Print the leftmost (first) and rightmost (last) digit of a number separated by space.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    printf(\"%c %c\\n\", s[0], s[strlen(s) - 1]);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; if (cin >> s) cout << s.front() << \" \" << s.back() << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            System.out.println(s.charAt(0) + \" \" + s.charAt(s.length() - 1));\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks:\n        s = toks[0]\n        print(f\"{s[0]} {s[-1]}\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) {\n        const s = toks[0];\n        console.log(`${s[0]} ${s[s.length - 1]}`);\n    }\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Extract s[0] and s[length - 1] and print them separated by space."
  },
