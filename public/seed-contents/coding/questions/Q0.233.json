  "solution": {
    "approach": "Count elements that are strictly greater than all elements appearing before them.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long max_v, x; scanf(\"%lld\", &x);\n    max_v = x; int count = 1;\n    for (int i = 1; i < n; i++) {\n        scanf(\"%lld\", &x);\n        if (x > max_v) { count++; max_v = x; }\n    }\n    printf(\"%d\\n\", count);\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    long long max_v, x; cin >> x;\n    max_v = x; int count = 1;\n    for (int i = 1; i < n; i++) {\n        cin >> x;\n        if (x > max_v) { count++; max_v = x; }\n    }\n    cout << count << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long maxV = sc.nextLong();\n            int count = 1;\n            for (int i = 1; i < n; i++) {\n                long x = sc.nextLong();\n                if (x > maxV) { count++; maxV = x; }\n            }\n            System.out.println(count);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    arr = [int(x) for x in toks[1:n+1]]\n    max_seen = -float(\"inf\")\n    count = 0\n    for x in arr:\n        if x > max_seen: count += 1; max_seen = x\n    print(count)\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    let maxV = -Infinity, count = 0;\n    for (let i = 1; i <= n; i++) {\n        const val = Number(toks[i]);\n        if (val > maxV) { count++; maxV = val; }\n    }\n    console.log(count);\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Maintain max_seen; if current element > max_seen, increment count and update max_seen."
  },
