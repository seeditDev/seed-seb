  "content": {
    "problemStatement": "You're given a list of integers, `nums`.\n\n**Determine whether any value shows up more than once, returning true if there's at least one repeated value, or false if every value is unique.**",
    "constraints": [
      "0 <= nums.length <= 10^5",
      "-10^9 <= nums[i] <= 10^9"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [1, 2, 3, 1]",
        "output": "true",
        "explanation": "1 appears at indices 0 and 3"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [1, 2, 3, 4]",
        "output": "false",
        "explanation": ""
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "nums = [1, 1, 1, 3, 3, 4, 3, 2, 4, 2]",
        "output": "true",
        "explanation": ""
      }
    ],
    "notes": []
