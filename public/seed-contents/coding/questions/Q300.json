  "content": {
    "problemStatement": "You're given a list of integers. A subsequence keeps the original\nrelative order of elements but may skip any number of them.\n\n**Find the length of the longest strictly increasing subsequence.**",
    "constraints": [
      "1 <= nums.length <= 2500",
      "-10^4 <= nums[i] <= 10^4"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [10, 9, 2, 5, 3, 7, 101, 18]",
        "output": "4",
        "explanation": "one longest increasing subsequence is [2, 3, 7, 101]"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [7, 7, 7, 7, 7, 7, 7]",
        "output": "1",
        "explanation": "no two equal elements form an increasing step, so the best is any single element"
      }
    ],
    "notes": []
  },
