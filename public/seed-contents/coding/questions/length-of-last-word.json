{
  "id": "length-of-last-word",
  "questionId": "length-of-last-word",
  "slug": "length-of-last-word",
  "title": "Length of Last Word",
  "difficulty": "Easy",
  "category": "Two pointers",
  "patterns": [
    "strings",
    "two pointers"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "you only care about the last word - do you really need to process the whole string from the front?",
    "start scanning from the end of the string instead",
    "first skip over any trailing spaces to find the last non-space character, then keep moving left while characters are non-space to find where the last word starts",
    "the length is just the distance between where the word ends and where it starts, no splitting or extra storage needed"
  ],
  "commonMistakes": [
    "not skipping trailing spaces before starting to measure the last word",
    "using a language's split-on-space function without handling multiple consecutive spaces, producing empty string entries",
    "off-by-one errors when computing the length from start and end indices"
  ],
  "content": {
    "problemStatement": "You're given a string made up of words separated by one or more spaces,\nand possibly with leading or trailing spaces too. A \"word\" is a maximal\nrun of non-space characters.\n\n**Return the length of the last word in the string.**\n\nThe string always contains at least one non-space character, so there\nis always a last word to find.\n",
    "constraints": [
      "1 <= s.length <= 10^4",
      "s consists of English letters and spaces only",
      "there is at least one word in s"
    ],
    "notes": [
      "trailing spaces after the last word",
      "a single word with no spaces at all",
      "multiple consecutive spaces between the second-to-last and last word"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"Hello World\"",
        "output": "5",
        "expectedOutput": "5",
        "explanation": "the last word is \"World\", which has 5 characters"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"   fly me   to   the moon  \"",
        "output": "4",
        "expectedOutput": "4",
        "explanation": "trailing spaces are ignored; the last word is \"moon\""
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"luffy is still joyboy\"",
        "output": "6",
        "expectedOutput": "6",
        "explanation": "the last word is \"joyboy\""
      }
    ],
