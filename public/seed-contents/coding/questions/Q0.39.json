  "solution": {
    "approach": "Map integer day number (0=Sunday ... 6=Saturday) to day name, else 'Invalid'.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int d;\n    if (scanf(\"%d\", &d) == 1) {\n        const char* days[] = {\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"};\n        if (d >= 0 && d <= 6) printf(\"%s\\n\", days[d]);\n        else printf(\"Invalid\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int d;\n    if (cin >> d) {\n        const char* days[] = {\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"};\n        if (d >= 0 && d <= 6) cout << days[d] << \"\\n\";\n        else cout << \"Invalid\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int d = sc.nextInt();\n            String[] days = {\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"};\n            if (d >= 0 && d <= 6) System.out.println(days[d]);\n            else System.out.println(\"Invalid\");\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        d = int(s)\n        days = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"]\n        if 0 <= d <= 6: print(days[d])\n        else: print(\"Invalid\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const d = parseInt(s, 10);\n        const days = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"];\n        if (d >= 0 && d <= 6) console.log(days[d]);\n        else console.log(\"Invalid\");\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Use switch or array lookup for 0:Sunday, 1:Monday, 2:Tuesday, 3:Wednesday, 4:Thursday, 5:Friday, 6:Saturday. Default: 'Invalid'."
  },
