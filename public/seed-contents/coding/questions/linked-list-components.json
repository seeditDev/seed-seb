  "slug": "linked-list-components",
  "title": "Linked List Components",
  "difficulty": "Medium",
  "category": "Linked list",
  "patterns": [
    "linked list",
    "hash set"
  ],
  "lists": [],
  "hints": [
    "checking 'is this value in subset' repeatedly - can you make that check O(1) instead of scanning subset every time?",
    "put every value of subset into a hash set first",
    "walk nums once, and count a new component every time you transition from 'not in subset' (or the very start) into 'in subset'",
    "a component starts whenever the current node's value is in the set AND the previous node's value was not (or there was no previous node) - count those transitions"
  ],
  "commonMistakes": [
    "counting every in-subset node as its own component instead of merging consecutive runs",
    "using linear search through subset for each node instead of a hash set, which is correct but slow",
    "miscounting the boundary at the very start or end of the list"
  ],
  "content": {
    "problemStatement": "A singly linked list is given to you as an array `nums`, containing\nevery node's value in order (all values are unique). You're also given\n`subset`, a set of values of interest. A group of nodes forms a\n\"component\" if their values are all in `subset` and they are\nconsecutive in the linked list (that is, they form an unbroken run of\nneighboring nodes).\n\n**Return the number of such components.**\n",
    "constraints": [
      "1 <= nums.length <= 10^4",
      "0 <= nums[i] < nums.length, all values in nums are unique",
      "1 <= subset.length <= nums.length",
      "all values in subset appear in nums"
    ],
    "notes": [
      "subset is empty",
      "every value in nums is in subset (one big component)",
      "no two subset values are ever adjacent in nums (every match is its own component)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [0, 1, 2, 3], subset = [0, 1, 3]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "nodes 0 and 1 are consecutive and both in subset, forming one component; node 3 is in subset but isolated (node 2 breaks the run), forming a second component"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [0, 1, 2, 3, 4], subset = [0, 3, 1, 4]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "0 and 1 form one component; 3 and 4 form another; 2 is not in subset and separates them"
      },
      {
