{
  "id": "subsets-ii",
  "questionId": "subsets-ii",
  "slug": "subsets-ii",
  "title": "Subsets with Duplicates",
  "difficulty": "Medium",
  "category": "Backtracking",
  "patterns": [
    "backtracking"
  ],
  "lists": [],
  "hints": [
    "sort nums first - now equal values are adjacent, which makes duplicates easy to detect",
    "use the same include/exclude backtracking as plain Subsets, walking through sorted indices with a start pointer",
    "the duplicate subsets come from choosing 'skip this value' at one occurrence but 'include it' at an identical later occurrence at the same decision point",
    "at each recursive call, when looping over candidates to include next, skip a candidate if it equals the previous candidate you already tried and moved past at this same loop level"
  ],
  "commonMistakes": [
    "not sorting first, which makes adjacent-duplicate skipping unreliable",
    "skipping duplicates globally instead of only within the same recursive call's loop, which incorrectly removes valid subsets like [2, 2]",
    "comparing against the previous element in the array instead of the previous element tried at the current loop level"
  ],
  "content": {
    "problemStatement": "You're given a list of integers that may contain duplicate values.\n\n**Return every possible unique subset, such that no two subsets in the result are the same multiset of values.**\n\nThe list can be returned in any order, and elements within a subset can be in any order.\n",
    "constraints": [
      "nums may contain duplicate values",
      "1 <= length of nums <= 10",
      "no two subsets in the result may represent the same multiset"
    ],
    "notes": [
      "all elements are identical (only length+1 distinct subsets exist)",
      "no duplicates at all (behaves like plain Subsets)",
      "duplicates that are not adjacent once sorted, e.g. multiple values each appearing more than once"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [1, 2, 2]",
        "output": "[[], [1], [2], [1, 2], [2, 2], [1, 2, 2]]",
        "expectedOutput": "[[], [1], [2], [1, 2], [2, 2], [1, 2, 2]]",
        "explanation": "the two 2's are indistinguishable, so subsets that only differ in which physical 2 was picked are the same subset"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [0, 0]",
        "output": "[[], [0], [0, 0]]",
        "expectedOutput": "[[], [0], [0, 0]]",
        "explanation": ""
      }
