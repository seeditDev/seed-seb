  "solution": {
    "approach": "Check if student passed or failed (marks >= 35 is Pass, < 35 is Fail).",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int m;\n    if (scanf(\"%d\", &m) == 1) {\n        printf(\"%s\\n\", (m >= 35) ? \"Pass\" : \"Fail\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int m;\n    if (cin >> m) {\n        cout << (m >= 35 ? \"Pass\" : \"Fail\") << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            System.out.println(sc.nextInt() >= 35 ? \"Pass\" : \"Fail\");\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        print(\"Pass\" if int(s) >= 35 else \"Fail\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        console.log(parseInt(s, 10) >= 35 ? \"Pass\" : \"Fail\");\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "If mark >= 35 print 'Pass', else print 'Fail'."
  },
