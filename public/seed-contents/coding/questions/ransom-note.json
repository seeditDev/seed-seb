  "slug": "ransom-note",
  "title": "Ransom Note",
  "difficulty": "Easy",
  "category": "Hash map",
  "patterns": [
    "hash map",
    "frequency counting"
  ],
  "lists": [
    "grind-75",
    "interview-150"
  ],
  "hints": [
    "re-scanning magazine for every letter of ransomNote wastes work. what if you counted magazine's letters just once, up front?",
    "build a frequency map of magazine's letters",
    "walk through ransomNote, and for each letter, check if the map still has at least one available - if so, use it up (decrement); if not, it's impossible",
    "you can stop as soon as any letter runs out, without needing to build a frequency map of ransomNote itself"
  ],
  "commonMistakes": [
    "counting ransomNote's letters and comparing to magazine's total count without checking per-letter availability",
    "not decrementing the count as letters are used, allowing the same magazine letter to be reused too many times",
    "rescanning magazine from scratch for each letter of ransomNote instead of counting once up front"
  ],
  "content": {
    "problemStatement": "You're given two strings, `ransomNote` and `magazine`.\n\n**Determine whether you can construct `ransomNote` using only the letters available in `magazine`.**\n\nEach letter in `magazine` can only be used once.\n",
    "constraints": [
      "0 <= ransomNote.length, magazine.length <= 10^5",
      "ransomNote and magazine consist of lowercase English letters only",
      "each letter in magazine can be used at most once"
    ],
    "notes": [
      "ransomNote is longer than magazine (always false)",
      "ransomNote is empty (always true)",
      "magazine has enough total letters but not enough of a specific one"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
