  "solution": {
    "approach": "Print all numbers from given range [A, B] inclusive separated by space.",
    "timeComplexity": "O(B - A)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int a, b;\n    if (scanf(\"%d %d\", &a, &b) == 2) {\n        for (int i = a; i <= b; i++) {\n            printf(\"%d%s\", i, (i == b ? \"\" : \" \"));\n        }\n        printf(\"\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int a, b;\n    if (cin >> a >> b) {\n        for (int i = a; i <= b; i++) {\n            cout << i << (i == b ? \"\" : \" \");\n        }\n        cout << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int a = sc.nextInt(), b = sc.nextInt();\n            StringBuilder sb = new StringBuilder();\n            for (int i = a; i <= b; i++) {\n                if (i > a) sb.append(\" \");\n                sb.append(i);\n            }\n            System.out.println(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    parts = sys.stdin.read().split()\n    if len(parts) >= 2:\n        a, b = int(parts[0]), int(parts[1])\n        print(' '.join(str(i) for i in range(a, b + 1)))\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const parts = fs.readFileSync(0, 'utf-8').trim().split(/\\s+/);\n    if (parts.length >= 2) {\n        const a = parseInt(parts[0], 10), b = parseInt(parts[1], 10);\n        const arr = [];\n        for (let i = a; i <= b; i++) arr.push(i);\n        console.log(arr.join(' '));\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Iterate from start A to end B inclusive and output space-separated values."
