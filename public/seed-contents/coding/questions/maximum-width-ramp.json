        "type": "reg",
        "input": "nums = [6, 0, 8, 2, 1, 5]",
        "output": "4",
        "expectedOutput": "4",
        "explanation": "the ramp (i=1, j=5) has nums[1]=0 <= nums[5]=5, giving width 5 - 1 = 4"
      },
