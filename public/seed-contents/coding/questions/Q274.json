  "content": {
    "problemStatement": "You're given a list of citation counts for a researcher's papers, one\nnumber per paper, in no particular order.\n\n**Compute and return the researcher's h-index, the largest number h such that the researcher has published at least h papers that have each been cited at least h times.**",
    "constraints": [
      "1 <= number of papers <= 5000",
      "0 <= citations[i] <= 1000",
      "citations is given in no particular order"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "citations = [3, 0, 6, 1, 5]",
        "output": "3",
        "explanation": "3 papers have at least 3 citations each (6, 5, 3), and the 4th-highest paper only has 1 citation, so h=4 doesn't work, but h=3 does"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "citations = [1, 3, 1]",
        "output": "1",
        "explanation": "at least 1 paper has at least 1 citation, but not 2 papers with at least 2 citations each"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "citations = [0, 0, 0]",
        "output": "0",
        "explanation": ""
