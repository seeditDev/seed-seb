  "solution": {
    "approach": "Reverse the digits of an integer.",
    "timeComplexity": "O(D)",
    "spaceComplexity": "O(D)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    int len = strlen(s);\n    for (int i = len - 1; i >= 0; i--) putchar(s[i]);\n    putchar('\\n');\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\n#include <algorithm>\nusing namespace std;\nint main() {\n    string s; if (cin >> s) { reverse(s.begin(), s.end()); cout << s << \"\\n\"; }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) System.out.println(new StringBuilder(sc.next()).reverse().toString());\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks: print(toks[0][::-1])\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) console.log(toks[0].split(\"\").reverse().join(\"\"));\n}\nmain();\n"
    },
