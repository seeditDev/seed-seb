  "lists": [],
  "hints": [
    "you never hand a $20 bill back as change to anyone, so do you ever need to remember how many $20s you're holding?",
    "track just two counters: number of $5 bills and number of $10 bills in hand",
    "for a $10 payment there's only one way to make $5 change: one $5 bill",
    "for a $20 payment there are two ways to make $15 change: one $10 + one $5, or three $5s - when both are available, which should you prefer, and why does that choice conserve flexibility for future customers?",
    "prefer one $10 + one $5 over three $5s, because $10 bills are useless for any other change amount, while $5 bills are the only thing that can make change for a future $10 customer"
  ],
  "commonMistakes": [
    "always breaking a $20 into three $5s even when a $10 is available, which needlessly drains the $5 supply that a later $10-paying customer will need",
    "forgetting to update the running counts before checking the next customer, or checking availability of a $5 for change to a $10 customer before decrementing it",
    "not handling the very first customer paying with $10 or $20 as an immediate failure"
  ],
  "content": {
    "problemStatement": "Lemonade costs $5 a cup. Customers line up and each pays with a $5,\n$10, or $20 bill, one at a time, in the order given by `bills`. You\nstart with no change on hand and must give each customer the correct\nchange before serving the next one.\n\n**Return true if you can give every customer exact change, or false if\nat some point you cannot.**\n",
    "constraints": [
      "1 <= bills.length <= 10^5",
      "bills[i] is 5, 10, or 20"
    ],
    "notes": [
      "the very first customer pays with 10 or 20 (impossible, no change available yet)",
      "a run of $10 bills that drains your $5 supply",
      "a $20 customer when you have three $5 bills but no $10 (must fall back to three $5s)",
      "all customers pay with exactly $5"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "bills = [5, 5, 5, 10, 20]",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "the first three $5 bills need no change, the $10 is covered by one $5, the $20 is covered by one $10 and one $5"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "bills = [5, 5, 10, 10, 20]",
        "output": "false",
        "expectedOutput": "false",
        "explanation": "after the two $10s you have no $5 bills left, and the $20 customer needs $15 in change"
      }
    ],
