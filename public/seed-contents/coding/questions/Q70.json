  "solution": {
    "code": {
      "C": "",
      "C++": "",
      "Java": "",
      "Python3": "class Solution:\n    def climbStairs(self, n: int) -> int:\n        if n <= 2: return n\n        a, b = 1, 2\n        for _ in range(3, n + 1):\n            a, b = b, a + b\n        return b\n\nif __name__ == '__main__':\n    import sys, json\n    args = json.loads(sys.stdin.readline())\n    n = args[0] if isinstance(args, list) else args\n    print(json.dumps(Solution().climbStairs(n)))\n",
