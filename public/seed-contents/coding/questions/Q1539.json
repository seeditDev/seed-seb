    "C": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint findKthPositive(int* arr, int arrSize, int k) {\n    int left = 0, right = arrSize - 1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        int missing = arr[mid] - (mid + 1);\n        if (missing < k) left = mid + 1;\n        else right = mid - 1;\n    }\n    return right + 1 + k;\n}\nint main(){char line[1000000]; if(!fgets(line,sizeof(line),stdin))return 0; char* p=strchr(line,'[')+1; char* e=strchr(p,']'); int cap=1000,n=0; int* a=malloc(cap*sizeof(int)); char* q=p; while(q<e){char* end; long v=strtol(q,&end,10); if(end==q){q++;continue;} a[n++]=(int)v; q=end;} int k=atoi(e+2); printf(\"%d\\n\",findKthPositive(a,n,k)); free(a); return 0;}\n",
    "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nclass Solution { public: int findKthPositive(vector<int>& arr,int k){ int l=0,r=(int)arr.size()-1; while(l<=r){int m=l+(r-l)/2; int miss=arr[m]-(m+1); if(miss<k) l=m+1; else r=m-1;} return r+1+k; } };\n\nint main(){ string s; getline(cin,s); size_t e=s.find(']'); string body=s.substr(2,e-2); vector<int> arr; string x; stringstream ss(body); while(getline(ss,x,',')) if(!x.empty()) arr.push_back(stoi(x)); size_t comma=s.find(',',e); size_t close=s.rfind(']'); int k=stoi(s.substr(comma+1,close-comma-1)); cout<<Solution().findKthPositive(arr,k)<<\"\\n\"; }\n",
    "Java": "import java.io.*;\nimport java.util.*;\n\nclass Solution {\n    public int findKthPositive(int[] arr, int k) {\n        int left=0, right=arr.length-1;\n        while(left<=right){ int mid=left+(right-left)/2; int missing=arr[mid]-(mid+1); if(missing<k) left=mid+1; else right=mid-1; }\n        return right+1+k;\n    }\n}\n\npublic class Main {\n    public static void main(String[] args)throws Exception{\n        String s=new BufferedReader(new InputStreamReader(System.in)).readLine().trim();\n        int end=s.indexOf(']'); String body=s.substring(2,end);\n        String[] p=body.isEmpty()?new String[0]:body.split(\",\"); int[] arr=new int[p.length];\n        for(int i=0;i<p.length;i++) arr[i]=Integer.parseInt(p[i].trim());\n        int comma=s.indexOf(',',end); int close=s.lastIndexOf(']'); int k=Integer.parseInt(s.substring(comma+1,close).trim());\n        System.out.println(new Solution().findKthPositive(arr,k));\n    }\n}\n",
