  "solution": {
    "notes": [],
    "approach": "Use binary search on the index. For index i, the number of missing positive integers up to arr[i] is arr[i] - (i + 1). Find the first index where this count is at least k; the answer is then k plus the number of array elements before that position.",
    "editorial": {
      "better": {
        "complexity": "O(n) time, O(1) extra space.",
        "description": "Scan the array once and compute arr[i] - (i + 1), the number of missing positives through each element. Once this count reaches k, derive the answer from the previous position."
      },
      "optimal": {
        "complexity": "O(log n) time, O(1) extra space.",
        "description": "Binary search for the first index i with arr[i] - (i + 1) >= k. If right is the last index whose missing count is below k, then exactly k missing values extend from right+1, so the answer is k + right + 1."
      },
      "bruteForce": {
        "complexity": "O(answer) time, O(1) extra space.",
        "description": "Scan positive integers from 1 upward, skipping values present in arr, until k missing values have been counted."
      }
    },
    "timeComplexity": "O(log n)",
    "spaceComplexity": "O(1)",
    "code": {
      "Python3": "import sys, json\n\nclass Solution:\n    def findKthPositive(self, arr, k):\n        left, right = 0, len(arr) - 1\n        while left <= right:\n            mid = left + (right - left) // 2\n            missing = arr[mid] - (mid + 1)\n            if missing < k:\n                left = mid + 1\n            else:\n                right = mid - 1\n        return right + 1 + k"
    }
  },
