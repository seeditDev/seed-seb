  "solution": {
    "approach": "Find second smallest distinct element in array.",
    "timeComplexity": "O(N log N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <stdlib.h>\nint cmp(const void *a, const void *b) {\n    long long diff = *(long long*)a - *(long long*)b;\n    return (diff > 0) - (diff < 0);\n}\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long a[100005];\n    for (int i = 0; i < n; i++) scanf(\"%lld\", &a[i]);\n    qsort(a, n, sizeof(long long), cmp);\n    long long min_v = a[0];\n    for (int i = 1; i < n; i++) {\n        if (a[i] > min_v) { printf(\"%lld\\n\", a[i]); return 0; }\n    }\n    printf(\"%lld\\n\", min_v);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <vector>\n#include <set>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    set<long long> st;\n    for (int i = 0; i < n; i++) { long long x; cin >> x; st.insert(x); }\n    vector<long long> v(st.begin(), st.end());\n    cout << (v.size() > 1 ? v[1] : v[0]) << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\nimport java.util.TreeSet;\nimport java.util.ArrayList;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            TreeSet<Long> set = new TreeSet<>();\n            for (int i = 0; i < n; i++) set.add(sc.nextLong());\n            ArrayList<Long> list = new ArrayList<>(set);\n            System.out.println(list.size() > 1 ? list.get(1) : list.get(0));\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    arr = [int(x) for x in toks[1:n+1]]\n    uniq = sorted(set(arr))\n    print(uniq[1] if len(uniq) > 1 else uniq[0])\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const st = Array.from(new Set(toks.slice(1, n + 1).map(x => BigInt(x))));\n    st.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));\n    console.log((st.length > 1 ? st[1] : st[0]).toString());\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Extract unique elements, sort ascending, and print second element."
  },
