  "slug": "valid-palindrome",
  "title": "Valid Palindrome",
  "difficulty": "Easy",
  "category": "Two pointers",
  "patterns": [
    "two pointers"
  ],
  "lists": [
    "blind-75",
    "grind-75",
    "interview-150"
  ],
  "hints": [
    "do you need to build a whole cleaned copy of the string before you can start comparing?",
    "what if you compared from both ends inward, skipping non-alphanumeric characters as you go?",
    "two pointers, one at each end: advance each one past any character that isn't a letter or digit, then compare",
    "stop as soon as a mismatch is found, or when the pointers meet"
  ],
  "commonMistakes": [
    "forgetting to lowercase before comparing",
    "not skipping punctuation/spaces on both sides before comparing",
    "off-by-one on the loop condition, comparing one extra or one too few pairs"
  ],
  "content": {
    "problemStatement": "You're given a string `s`.\n\n**Ignoring case and skipping any character that isn't a letter or digit, decide whether the remaining characters read the same forwards and backwards.**\n",
    "constraints": [
      "0 <= s.length <= 2 * 10^5",
      "s consists only of printable ASCII characters"
    ],
    "notes": [
      "empty string or a string with no alphanumeric characters (true)",
      "single character (always true)",
      "punctuation and spaces scattered throughout"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"A man, a plan, a canal: Panama\"",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "ignoring punctuation and case, it reads amanaplanacanalpanama both ways"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"race a car\"",
        "output": "false",
        "expectedOutput": "false",
        "explanation": ""
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \" \"",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "no letters or digits at all, so it's trivially a palindrome"
      }
    ],
