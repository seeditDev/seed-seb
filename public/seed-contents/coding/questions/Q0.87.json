  "solution": {
    "approach": "Use nested loops to iterate through rows and columns, printing characters corresponding to the pattern formula.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\nint main() { int n; if(scanf(\"%d\",&n)==1){for(int i=1;i<=n;i++){for(int j=1;j<=i;j++)printf(\"%d\",j);printf(\"\\n\");}for(int i=n-1;i>=1;i--){for(int j=1;j<=i;j++)printf(\"%d\",j);printf(\"\\n\");}}return 0; }",
      "C++": "#include <iostream>\nusing namespace std;\nint main(){int n;if(cin>>n){for(int i=1;i<=n;i++){for(int j=1;j<=i;j++)cout<<j;cout<<\"\\n\";}for(int i=n-1;i>=1;i--){for(int j=1;j<=i;j++)cout<<j;cout<<\"\\n\";}}return 0;}",
      "Java": "import java.util.Scanner;\npublic class Main{public static void main(String[] args){Scanner sc=new Scanner(System.in);if(sc.hasNextInt()){int n=sc.nextInt();for(int i=1;i<=n;i++){StringBuilder sb=new StringBuilder();for(int j=1;j<=i;j++)sb.append(j);System.out.println(sb);}for(int i=n-1;i>=1;i--){StringBuilder sb=new StringBuilder();for(int j=1;j<=i;j++)sb.append(j);System.out.println(sb);}}}}",
      "Python3": "import sys\ndef pattern(n):\n    up = [''.join(str(j) for j in range(1, i + 1)) for i in range(1, n + 1)]\n    down = [''.join(str(j) for j in range(1, i + 1)) for i in range(n - 1, 0, -1)]\n    return '\\n'.join(up + down)\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        print(pattern(int(s)))\nmain()",
      "JavaScript": "const fs = require('fs');\nconst s = fs.readFileSync(0, 'utf-8').trim();\nif (s) { const n = parseInt(s, 10); for(let i=1;i<=n;i++){let l='';for(let j=1;j<=i;j++)l+=j;console.log(l);}for(let i=n-1;i>=1;i--){let l='';for(let j=1;j<=i;j++)l+=j;console.log(l);}}"
    },
