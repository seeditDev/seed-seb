  "solution": {
    "approach": "Count the number of whitespace-delimited words in the input string.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    char w[500]; int cnt = 0;\n    while (scanf(\"%s\", w) == 1) cnt++;\n    printf(\"%d\\n\", cnt);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string w; int cnt = 0;\n    while (cin >> w) cnt++;\n    cout << cnt << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int cnt = 0;\n        while (sc.hasNext()) { sc.next(); cnt++; }\n        System.out.println(cnt);\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    print(len(toks))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/).filter(Boolean);\n    console.log(toks.length);\n}\nmain();\n"
    },
