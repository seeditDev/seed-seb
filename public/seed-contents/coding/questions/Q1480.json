    "C": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic int* parse_int_array(const char* s, int* out_size) {\n    const char* p = strchr(s, '[');\n    if (!p) { *out_size = 0; return NULL; }\n    p++;\n    int cap = 16, n = 0;\n    int* a = (int*)malloc(cap * sizeof(int));\n    while (*p && *p != ']') {\n        while (*p == ' ' || *p == ',') p++;\n        if (*p == ']') break;\n        char* end;\n        long v = strtol(p, &end, 10);\n        if (end == p) { p++; continue; }\n        if (n == cap) { cap *= 2; a = (int*)realloc(a, cap * sizeof(int)); }\n        a[n++] = (int)v;\n        p = end;\n    }\n    *out_size = n;\n    return a;\n}\n\n/**\n * Note: The returned array is malloced; caller should free it.\n */\nint* runningSum(int* nums, int numsSize, int* returnSize) {\n    return NULL;\n}\n\nint main(void) {\n    char line[120000];\n    if (!fgets(line, sizeof(line), stdin)) return 0;\n    int numsSize = 0;\n    int* nums = parse_int_array(line, &numsSize);\n    int returnSize = 0;\n    int* result = runningSum(nums, numsSize, &returnSize);\n\n    putchar('[');\n    for (int i = 0; i < returnSize; ++i) {\n        if (i) putchar(',');\n        printf(\"%d\", result[i]);\n    }\n    puts(\"]\");\n\n    free(nums);\n    free(result);\n    return 0;\n}",
    "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nclass Solution {\npublic:\n    vector<int> runningSum(vector<int>& nums) {\n        return {};\n    }\n};\n\nint main() {\n    string line;\n    getline(cin, line);\n\n    size_t l = line.find('[');\n    size_t r = line.rfind(']');\n    string inner = line.substr(l + 2, r - l - 3);\n\n    vector<int> nums;\n    stringstream ss(inner);\n    string token;\n    while (getline(ss, token, ',')) {\n        if (!token.empty()) nums.push_back(stoi(token));\n    }\n\n    vector<int> result = Solution().runningSum(nums);\n    cout << '[';\n    for (size_t i = 0; i < result.size(); ++i) {\n        if (i) cout << ',';\n        cout << result[i];\n    }\n    cout << \"]\\n\";\n    return 0;\n}",
    "Java": "import java.io.*;\nimport java.util.*;\n\nclass Solution {\n    public int[] runningSum(int[] nums) {\n        return null;\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine().trim();\n        int left = line.indexOf('[');\n        int right = line.lastIndexOf(']');\n        String inner = line.substring(left + 2, right - 1).trim();\n\n        if (inner.isEmpty()) {\n            System.out.println(\"[]\");\n            return;\n        }\n\n        String[] parts = inner.split(\",\");\n        int[] nums = new int[parts.length];\n        for (int i = 0; i < parts.length; i++) {\n            nums[i] = Integer.parseInt(parts[i].trim());\n        }\n\n        int[] result = new Solution().runningSum(nums);\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < result.length; i++) {\n            if (i > 0) sb.append(',');\n            sb.append(result[i]);\n        }\n        sb.append(']');\n        System.out.println(sb);\n    }\n}",
