{
  "id": "satisfiability-of-equations",
  "questionId": "satisfiability-of-equations",
  "slug": "satisfiability-of-equations",
  "title": "Satisfiability of Equality Equations",
  "difficulty": "Medium",
  "category": "Union find",
  "patterns": [
    "union find",
    "connected components"
  ],
  "lists": [],
  "hints": [
    "equality is transitive and symmetric, which is exactly what union-find groups represent",
    "process every equation with isEqual = 1 first, unioning the two variables involved",
    "once all equalities are applied, go through the equations with isEqual = 0 - if any pair of supposedly-unequal variables ends up in the same group, the system is unsatisfiable",
    "if no inequality constraint ever contradicts a group, the assignment is satisfiable"
  ],
  "commonMistakes": [
    "processing equations in the given order instead of doing all equalities first, which can cause you to check an inequality before its contradiction has been unioned in yet",
    "not realizing a self-inequality like a != a is automatically a contradiction, since find(a) always equals find(a)",
    "forgetting to check every inequality constraint and stopping at the first one that currently seems fine"
  ],
  "content": {
    "problemStatement": "You're given a list of equations about integer variables, where each\nequation is a triple `[a, b, isEqual]`. Variable ids are integers between\n0 and 25. If `isEqual` is 1, the equation means variable `a` equals\nvariable `b`. If `isEqual` is 0, it means variable `a` does not equal\nvariable `b`.\n\n**Return true if there is some assignment of values to the variables that satisfies every equation simultaneously, and false otherwise.**\n",
    "constraints": [
      "1 <= equations.length <= 500",
      "each variable id is in [0, 25]",
      "isEqual is 0 or 1"
    ],
    "notes": [
      "a variable claimed not equal to itself (immediately unsatisfiable)",
      "only equality constraints, no inequality constraints at all",
      "only inequality constraints, no equality constraints at all",
      "a long chain of equalities that indirectly contradicts a single inequality"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "equations = [[0,1,1],[1,2,1],[2,0,0]]",
        "output": "false",
        "expectedOutput": "false",
        "explanation": "0 == 1 and 1 == 2 force 0 == 2, which contradicts 2 != 0"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "equations = [[0,1,1],[1,2,1],[2,0,1]]",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "all three variables can simply be equal to each other"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "equations = [[0,1,0]]",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "with no equality constraints at all, two unequal variables is trivially satisfiable"
      }
    ],
