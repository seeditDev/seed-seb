  "title": "Running Sum of 1D Array",
  "difficulty": "Easy",
  "category": "Prefix sum",
  "patterns": [
    "prefix sum"
  ],
  "lists": [],
  "hints": [
    "each running sum only differs from the previous one by a single new element - do you need to recompute the whole sum each time?",
    "keep a running total variable, add the current element to it, and place the result in the output array",
    "you can even build the result in place if the language allows overwriting the input"
  ],
  "commonMistakes": [
    "recomputing the sum from scratch at each index instead of carrying a running total",
    "off-by-one on the starting index of the running total"
  ],
