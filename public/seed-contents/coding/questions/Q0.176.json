  "solution": {
    "approach": "Count the occurrences of prime digits (2, 3, 5, 7) in the given number.",
    "timeComplexity": "O(D)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    int count = 0;\n    for (int i = 0; s[i]; i++) {\n        char c = s[i];\n        if (c == '2' || c == '3' || c == '5' || c == '7') count++;\n    }\n    printf(\"%d\\n\", count);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; if (!(cin >> s)) return 0;\n    int count = 0;\n    for (char c : s) if (c == '2' || c == '3' || c == '5' || c == '7') count++;\n    cout << count << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            int count = 0;\n            for (char c : s.toCharArray()) if (c == '2' || c == '3' || c == '5' || c == '7') count++;\n            System.out.println(count);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    primes = set(\"2357\")\n    print(sum(1 for c in toks[0] if c in primes))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || !toks[0]) return;\n    const primes = new Set([\"2\", \"3\", \"5\", \"7\"]);\n    let count = 0;\n    for (const c of toks[0]) if (primes.has(c)) count++;\n    console.log(count);\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Check each character: if it is in {'2', '3', '5', '7'}, increment count."
  },
