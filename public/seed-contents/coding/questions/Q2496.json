  "solution": {
    "code": {
      "Python3": "# Time:  O(n * l)\n# Space: O(1)\n\n# string\nclass Solution(object):\n    def maximumValue(self, strs):\n        \"\"\"\n        :type strs: List[str]\n        :rtype: int\n        \"\"\"\n        return max(int(s) if s.isdigit() else len(s) for s in strs)"
    },
