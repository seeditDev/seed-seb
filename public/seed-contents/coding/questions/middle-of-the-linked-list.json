        "type": "reg",
        "input": "nums = [1, 2, 3, 4, 5]",
        "output": "[3, 4, 5]",
        "expectedOutput": "[3, 4, 5]",
        "explanation": "5 nodes, middle is index 2 (value 3), return from there onward"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [1, 2, 3, 4, 5, 6]",
