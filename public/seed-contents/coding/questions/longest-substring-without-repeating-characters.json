  "slug": "longest-substring-without-repeating-characters",
  "title": "Longest Substring Without Repeating Characters",
  "difficulty": "Medium",
  "category": "Sliding window",
  "patterns": [
    "sliding window",
    "hash map"
  ],
  "lists": [
    "blind-75",
    "grind-75",
    "interview-150"
  ],
  "hints": [
    "when you hit a repeated character, do you need to restart the window from scratch, or can you shrink it from the left?",
    "if you know the last index each character appeared at, how far do you need to move the left edge?",
    "keep a window [left, right] and a map of char -> last seen index",
    "when char at right was seen before inside the current window, jump left to (last seen index + 1), then update the max window length"
  ],
  "commonMistakes": [
    "moving left backward when the repeated character's last occurrence is outside the current window (should only move left forward, never backward)",
    "off-by-one when computing window length (right - left + 1)",
    "forgetting to update the last-seen index for every character, not just repeats"
  ],
  "content": {
    "problemStatement": "You're given a string.\n\n**Find the length of the longest contiguous stretch of characters\nwithin it that contains no repeated character.**\n",
    "constraints": [
      "0 <= s.length <= 5 * 10^4",
      "s consists of English letters, digits, symbols, and spaces"
    ],
    "notes": [
      "empty string (answer 0)",
      "all characters identical (answer 1)",
      "all characters unique (answer is the full length)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
