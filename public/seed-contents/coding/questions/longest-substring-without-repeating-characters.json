        "type": "reg",
        "input": "s = \"abcabcbb\"",
        "output": "3",
        "expectedOutput": "3",
        "explanation": "the longest repeat-free stretch is \"abc\", length 3"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"bbbbb\"",
