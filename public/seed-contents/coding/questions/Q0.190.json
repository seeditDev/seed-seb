  "solution": {
    "approach": "Convert number string represented in base B to decimal.",
    "timeComplexity": "O(D)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    char s[1005]; long long b;\n    if (scanf(\"%s %lld\", s, &b) != 2) return 0;\n    long long val = 0;\n    for (int i = 0; s[i]; i++) val = val * b + (s[i] - '0');\n    printf(\"%lld\\n\", val);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; long long b; if (!(cin >> s >> b)) return 0;\n    long long val = 0;\n    for (char c : s) val = val * b + (c - '0');\n    cout << val << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next(); int b = sc.nextInt();\n            long val = 0;\n            for (char c : s.toCharArray()) val = val * b + (c - '0');\n            System.out.println(val);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if len(toks) >= 2:\n        s, base = toks[0], int(toks[1])\n        print(int(s, base))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks.length >= 2) {\n        const s = toks[0], base = BigInt(toks[1]);\n        let val = 0n;\n        for (const c of s) val = val * base + BigInt(c);\n        console.log(val.toString());\n    }\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Iterate through digits, multiplying current value by B and adding digit value."
  },
