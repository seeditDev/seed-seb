  "solution": {
    "approach": "Check if array is sorted and circularly rotated.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long a[100005];\n    for (int i = 0; i < n; i++) scanf(\"%lld\", &a[i]);\n    int count = 0;\n    for (int i = 0; i < n; i++) if (a[i] > a[(i + 1) % n]) count++;\n    printf(\"%s\\n\", count <= 1 ? \"Yes\" : \"No\");\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n    int count = 0;\n    for (int i = 0; i < n; i++) if (a[i] > a[(i + 1) % n]) count++;\n    cout << (count <= 1 ? \"Yes\" : \"No\") << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long[] a = new long[n];\n            for (int i = 0; i < n; i++) a[i] = sc.nextLong();\n            int count = 0;\n            for (int i = 0; i < n; i++) if (a[i] > a[(i + 1) % n]) count++;\n            System.out.println(count <= 1 ? \"Yes\" : \"No\");\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    arr = [int(x) for x in toks[1:n+1]]\n    count = sum(1 for i in range(n) if arr[i] > arr[(i + 1) % n])\n    print(\"Yes\" if count <= 1 else \"No\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    let count = 0;\n    for (let i = 1; i <= n; i++) {\n        const curr = BigInt(toks[i]);\n        const next = BigInt(toks[i === n ? 1 : i + 1]);\n        if (curr > next) count++;\n    }\n    console.log(count <= 1 ? \"Yes\" : \"No\");\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Count indices where a[i] > a[(i + 1) % n]. If count <= 1, print Yes, else No."
  },
