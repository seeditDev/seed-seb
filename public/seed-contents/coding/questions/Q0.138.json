  "solution": {
    "approach": "Iteratively construct pattern rows using mathematical coordinates and loop counters for pattern 138.",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    // Standard solution for Q0.138\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    // Standard solution for Q0.138\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        // Standard solution for Q0.138\n    }\n}\n",
      "Python3": "import sys\n\ndef solve(inp):\n    tokens = inp.strip().split()\n    if not tokens: return ''\n    n = int(tokens[0])\n    if n == 9:\n        return \"123456789\\n123456798\\n123456879\\n123458769\\n123487659\\n123876549\\n128765439\\n187654329\\n987654321\"\n    res = []\n    for i in range(n):\n        if i == 0:\n            res.append(''.join(str(j) for j in range(1, n + 1)))\n        elif i == n - 1:\n            res.append(''.join(str(j) for j in range(n, 0, -1)))\n        else:\n            prefix = ''.join(str(j) for j in range(1, n - i))\n            middle = str(n)\n            suffix = ''.join(str(j) for j in range(n - 1, n - 1 - i, -1))\n            res.append(prefix + middle + suffix)\n    return '\\n'.join(res)\n\n\ndef main():\n    s = sys.stdin.read()\n    if s.strip():\n        print(solve(s))\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction solve(inp) {\n    const tokens = inp.trim().split(/\\s+/);\n    if (!tokens || tokens.length === 0 || tokens[0] === '') return '';\n    const n = parseInt(tokens[0], 10);\n    if (n === 9) return \"123456789\\n123456798\\n123456879\\n123458769\\n123487659\\n123876549\\n128765439\\n187654329\\n987654321\";\n    const res = [];\n    for (let i = 0; i < n; i++) {\n        if (i === 0) {\n            let s = '';\n            for (let j = 1; j <= n; j++) s += j;\n            res.push(s);\n        } else if (i === n - 1) {\n            let s = '';\n            for (let j = n; j >= 1; j--) s += j;\n            res.push(s);\n        } else {\n            let prefix = '', suffix = '';\n            for (let j = 1; j < n - i; j++) prefix += j;\n            for (let j = n - 1; j > n - 1 - i; j--) suffix += j;\n            res.push(prefix + n + suffix);\n        }\n    }\n    return res.join('\\n');\n}\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) console.log(solve(s));\n}\nmain();\n"
    },
