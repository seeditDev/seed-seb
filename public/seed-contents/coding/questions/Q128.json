  "content": {
    "problemStatement": "You're given an unsorted array of integers.\n\n**Find the length of the longest run of consecutive integers that all\nappear somewhere in the array, in O(n) time.**\n\nThe run doesn't need to appear contiguously in the array itself, just\nexist as consecutive values.",
    "constraints": [
      "0 <= nums.length <= 10^5",
      "-10^9 <= nums[i] <= 10^9"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [100, 4, 200, 1, 3, 2]",
        "output": "4",
        "explanation": "the consecutive run 1, 2, 3, 4 has length 4"
