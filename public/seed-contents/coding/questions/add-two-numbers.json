{
  "id": "add-two-numbers",
  "questionId": "add-two-numbers",
  "slug": "add-two-numbers",
  "title": "Add Two Numbers",
  "difficulty": "Medium",
  "category": "Linked list",
  "patterns": [
    "linked list",
    "simulation",
    "math"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "since digits are already stored least-significant-first, does that order match how you'd naturally add numbers by hand?",
    "what do you do with a carry when adding two digits by hand, and where does it get applied next?",
    "walk both lists together, adding corresponding digits plus any carry from the previous step, and appending sum % 10 to the result while carrying sum / 10 forward",
    "keep going until both lists are exhausted AND the carry is zero - a final leftover carry needs its own extra digit"
  ],
  "commonMistakes": [
    "stopping as soon as the shorter list runs out instead of continuing until both lists and the carry are exhausted",
    "forgetting to emit an extra digit for a final carry after both lists end",
    "treating the digits as most-significant-first and reversing at the wrong step"
  ],
  "content": {
    "problemStatement": "Two non-negative integers are each stored as a singly linked list, given to you as arrays `l1` and `l2`. Each node holds a single digit, and the digits are stored in reverse order, so the head of the list is the least significant digit.\n\n**Add the two numbers and return the sum as a linked list in the same reversed-digit format.**\n\nThe result should be an array where index 0 is the least significant digit of the sum.\n",
    "constraints": [
      "1 <= l1.length, l2.length <= 100",
      "0 <= l1[i], l2[i] <= 9",
      "it is guaranteed that the list represents a number that does not have leading zeros, except the number 0 itself"
    ],
    "notes": [
      "the two numbers have different lengths",
      "a carry propagates past the last digit of both numbers, growing the result by one digit",
      "both numbers are just [0]"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "l1 = [2, 4, 3], l2 = [5, 6, 4]",
        "output": "[7, 0, 8]",
        "expectedOutput": "[7, 0, 8]",
        "explanation": "l1 represents 342, l2 represents 465, 342 + 465 = 807, stored reversed as [7, 0, 8]"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "l1 = [0], l2 = [0]",
        "output": "[0]",
        "expectedOutput": "[0]",
        "explanation": ""
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "l1 = [9, 9, 9, 9, 9, 9, 9], l2 = [9, 9, 9, 9]",
        "output": "[8, 9, 9, 9, 0, 0, 0, 1]",
        "expectedOutput": "[8, 9, 9, 9, 0, 0, 0, 1]",
        "explanation": "9999999 + 9999 = 10009998, stored reversed with a new leading digit for the carry"
      }
    ],
