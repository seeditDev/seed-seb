  "solution": {
    "notes": [
      "Handles overlapping periodic prefixes without constructing many candidate strings."
    ],
    "approach": "Compute the KMP prefix function. If L is the final longest proper-prefix/suffix length, the minimal candidate period is n-L. The string is made from repeated copies exactly when L > 0 and n % (n-L) == 0.",
    "editorial": {
      "better": {
        "complexity": "O(n) expected search time with O(n) extra string space.",
        "description": "Check whether s occurs inside (s+s) after dropping the first and last characters."
      },
      "optimal": {
        "complexity": "O(n) time and O(n) space.",
        "description": "Use the KMP prefix function and test whether the minimal period divides the total length."
      },
      "bruteForce": {
        "complexity": "O(n^2) time in a straightforward implementation.",
        "description": "Try each proper substring length that divides n and compare the string with repeated copies of that prefix."
      }
    },
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\n#include <stdbool.h>\nbool repeatedSubstringPattern(char*s){int n=(int)strlen(s);if(n<2)return false;int pi[10000]={0},j=0;for(int i=1;i<n;i++){while(j>0&&s[i]!=s[j])j=pi[j-1];if(s[i]==s[j])j++;pi[i]=j;}int p=n-pi[n-1];return pi[n-1]>0&&n%p==0;}",
      "C++": "class Solution{public:bool repeatedSubstringPattern(string s){int n=s.size();if(n<2)return false;vector<int>pi(n);for(int i=1,j=0;i<n;i++){while(j>0&&s[i]!=s[j])j=pi[j-1];if(s[i]==s[j])j++;pi[i]=j;}int p=n-pi[n-1];return pi[n-1]>0&&n%p==0;}};",
      "Java": "class Solution{\n public boolean repeatedSubstringPattern(String s){\n  int n=s.length();if(n<2)return false;int[] pi=new int[n];int j=0;\n  for(int i=1;i<n;i++){while(j>0&&s.charAt(i)!=s.charAt(j))j=pi[j-1];if(s.charAt(i)==s.charAt(j))j++;pi[i]=j;}\n  int p=n-pi[n-1];return pi[n-1]>0&&n%p==0;\n }\n}",
      "Python3": "import sys, json\nclass Solution:\n    def repeatedSubstringPattern(self, s):\n        n=len(s)\n        if n<2:return False\n        pi=[0]*n\n        j=0\n        for i in range(1,n):\n            while j>0 and s[i]!=s[j]: j=pi[j-1]\n            if s[i]==s[j]: j+=1\n            pi[i]=j\n        p=n-pi[-1]\n        return pi[-1]>0 and n%p==0",
      "JavaScript": "'use strict';\nfunction repeatedSubstringPattern(s){\n const n=s.length;if(n<2)return false;\n const pi=new Array(n).fill(0);let j=0;\n for(let i=1;i<n;i++){while(j>0&&s[i]!==s[j])j=pi[j-1];if(s[i]===s[j])j++;pi[i]=j;}\n const p=n-pi[n-1];return pi[n-1]>0&&n%p===0;\n}\nconst s=JSON.parse(require('fs').readFileSync(0,'utf8'))[0];console.log(JSON.stringify(repeatedSubstringPattern(s)));"
    }
  },
