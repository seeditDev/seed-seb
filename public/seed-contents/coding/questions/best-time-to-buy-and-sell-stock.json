  "hints": [
    "for a fixed sell day, which buy day gives the best profit?",
    "as you scan left to right, what's the one number about the past you actually need to remember?",
    "you don't need every past price - just the smallest one so far",
    "track min price seen so far, and at each day compute price - min_so_far, keeping the max"
  ],
  "commonMistakes": [
    "allowing sell day to come before or equal to buy day",
    "returning a negative number instead of 0 when no profitable transaction exists",
    "updating the running max profit before updating min price, or vice versa, in the wrong order"
  ],
  "content": {
    "problemStatement": "You're given a list of daily stock prices, where `prices[i]` is the price on day `i`. You may buy the stock on one day and sell it on a later day, at most once.\n\n**Return the maximum profit you can make, or 0 if no profit is possible.**\n",
    "constraints": [
      "0 <= prices.length <= 10^5",
      "0 <= prices[i] <= 10^4"
    ],
    "notes": [
      "prices strictly decreasing the whole time (answer is 0)",
      "prices strictly increasing the whole time (answer is last - first)",
      "single price in the array"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "prices = [7, 1, 5, 3, 6, 4]",
        "output": "5",
        "expectedOutput": "5",
        "explanation": "buy on day 1 (price 1), sell on day 4 (price 6), profit = 6 - 1 = 5"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "prices = [7, 6, 4, 3, 1]",
        "output": "0",
        "expectedOutput": "0",
        "explanation": "prices only fall, so no transaction is profitable"
      }
