{
  "id": "decode-xored-array",
  "questionId": "decode-xored-array",
  "slug": "decode-xored-array",
  "title": "Decode XORed Array",
  "difficulty": "Easy",
  "category": "Bit manipulation",
  "patterns": [
    "bit manipulation",
    "xor"
  ],
  "lists": [],
  "hints": [
    "you know encoded[i] = original[i] XOR original[i+1] - if you already know original[i], can you recover original[i+1]?",
    "XOR is its own inverse: if a XOR b == c, then a XOR c == b",
    "so original[i+1] = original[i] XOR encoded[i]",
    "start with original[0] = first, then walk forward through encoded, computing each next value from the previous one"
  ],
  "commonMistakes": [
    "trying to XOR all of encoded together instead of unwinding it one step at a time",
    "off-by-one errors between encoded's length and original's length (original always has one more element)",
    "forgetting to include first itself as original[0] in the output"
  ],
  "content": {
    "problemStatement": "There's a hidden array of non-negative integers, `original`. You're given\n`encoded`, where encoded[i] = original[i] XOR original[i+1] for every\nvalid index, and you're given original[0] directly as `first`.\n\n**Reconstruct and return the full `original` array.**\n",
    "constraints": [
      "1 <= encoded.length <= 10^4",
      "0 <= encoded[i] <= 10^5",
      "0 <= first <= 2^31 - 1",
      "encoded.length == original.length - 1"
    ],
    "notes": [
      "encoded has exactly one element",
      "first is 0",
      "encoded contains a 0 (consecutive elements of original are equal there)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
