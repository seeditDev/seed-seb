  "solution": {
    "approach": "Filter out all vowels (both lowercase and uppercase) from the input string.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint is_vowel(char c) {\n    return strchr(\"aeiouAEIOU\", c) != NULL;\n}\nint main() {\n    char s[1000]; if (!fgets(s, sizeof(s), stdin)) return 0;\n    int len = strlen(s);\n    while (len > 0 && (s[len-1] == '\\n' || s[len-1] == '\\r')) s[--len] = '\\0';\n    for (int i = 0; i < len; i++) if (!is_vowel(s[i])) putchar(s[i]);\n    putchar('\\n');\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nbool is_vowel(char c) {\n    return string(\"aeiouAEIOU\").find(c) != string::npos;\n}\nint main() {\n    string s; if (!getline(cin, s)) return 0;\n    for (char c : s) if (!is_vowel(c)) cout << c;\n    cout << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLine()) {\n            String s = sc.nextLine();\n            System.out.println(s.replaceAll(\"[aeiouAEIOU]\", \"\"));\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    s = sys.stdin.read().strip()\n    print(\"\".join(c for c in s if c not in \"aeiouAEIOU\"))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const s = fs.readFileSync(0, \"utf-8\").trim();\n    console.log(s.replace(/[aeiouAEIOU]/g, \"\"));\n}\nmain();\n"
    },
