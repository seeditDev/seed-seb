{
  "id": "baseball-game",
  "questionId": "baseball-game",
  "slug": "baseball-game",
  "title": "Baseball Game",
  "difficulty": "Easy",
  "category": "Stack",
  "patterns": [
    "stack"
  ],
  "lists": [],
  "hints": [
    "every operation depends only on the most recently recorded scores - what data structure tracks 'the last few things that happened' naturally?",
    "split ops on spaces first, then process each token in order using a stack of recorded scores",
    "for \"+\" you need the top two stack values without removing them permanently (push their sum); for \"D\" you need just the top value doubled; for \"C\" you pop and discard",
    "at the end, sum whatever remains on the stack"
  ],
  "commonMistakes": [
    "forgetting that \"C\" removes the score permanently rather than just marking it invalid, which changes what \"+\" and \"D\" see afterward",
    "off-by-one errors reading the top two elements for \"+\" (using the wrong two, or popping when you shouldn't)",
    "not parsing negative integer tokens correctly (treating the leading '-' as an unknown operator)"
  ],
  "content": {
    "problemStatement": "You're keeping score for an unusual baseball game. You're given a space-delimited sequence of operation tokens, each one of:\n\n- an integer - record a new score of that many points\n- \"+\" - record a new score equal to the sum of the previous two scores\n- \"D\" - record a new score equal to double the previous score\n- \"C\" - invalidate and remove the most recently recorded score, as if it never happened\n\n**Process the tokens in order and return the sum of all scores remaining at the end.**\n",
    "constraints": [
      "1 <= number of tokens in ops <= 1000",
      "-3 * 10^4 <= each integer token's value <= 3 * 10^4",
      "the answer and every intermediate sum fit in a 32-bit signed integer",
      "there are always enough prior scores available for every \"+\", \"D\", or \"C\" token"
    ],
    "notes": [
      "a single integer token with no operations",
      "\"C\" immediately after a \"D\" or \"+\" (cancels the computed score, not an original one)",
      "negative integer scores"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "ops = \"5 2 C D +\"",
        "output": "30",
        "expectedOutput": "30",
        "explanation": "record 5, record 2, cancel the 2 (scores: [5]), double the last (D -> 10, scores: [5,10]), sum of last two (+ -> 15, scores: [5,10,15]); total = 5+10+15 = 30"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "ops = \"5 -2 4 C D 9 + +\"",
        "output": "27",
        "expectedOutput": "27",
        "explanation": "scores build to [5,-2,4], C removes 4 -> [5,-2], D doubles -2 -> [5,-2,-4], 9 -> [5,-2,-4,9], + sums last two (-4+9=5) -> [5,-2,-4,9,5], + again (9+5=14) -> [5,-2,-4,9,5,14]; total = 5-2-4+9+5+14 = 27"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "ops = \"1\"",
        "output": "1",
        "expectedOutput": "1",
        "explanation": ""
      }
    ],
