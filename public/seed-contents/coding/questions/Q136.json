  "content": {
    "problemStatement": "You're given a list of integers where every number appears exactly twice\nexcept for one number, which appears exactly once.\n\n**Return that lone number.**",
    "constraints": [
      "1 <= nums.length <= 3 * 10^4",
      "-2^31 <= nums[i] <= 2^31 - 1",
      "each element in nums appears exactly twice, except for one element which appears exactly once"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [4, 1, 2, 1, 2]",
        "output": "4",
        "explanation": "1 and 2 each appear twice, 4 appears once"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [2, 2, 1]",
        "output": "1",
        "explanation": ""
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "nums = [1]",
        "output": "1",
        "explanation": "a single-element list has no pair, so the one element is the answer"
      }
    ],
    "notes": []
  },
