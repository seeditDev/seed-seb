  "solution": {
    "approach": "Find smallest positive integer (>= 1) missing from array.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    char present[100005] = {0};\n    for (int i = 0; i < n; i++) {\n        long long x; scanf(\"%lld\", &x);\n        if (x > 0 && x <= 100000) present[x] = 1;\n    }\n    for (int c = 1; c <= 100001; c++) {\n        if (!present[c]) { printf(\"%d\\n\", c); return 0; }\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <unordered_set>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    unordered_set<long long> st;\n    for (int i = 0; i < n; i++) { long long x; cin >> x; st.insert(x); }\n    long long c = 1;\n    while (st.count(c)) c++;\n    cout << c << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\nimport java.util.HashSet;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            HashSet<Long> st = new HashSet<>();\n            for (int i = 0; i < n; i++) st.add(sc.nextLong());\n            long c = 1;\n            while (st.contains(c)) c++;\n            System.out.println(c);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    st = set(int(x) for x in toks[1:n+1])\n    c = 1\n    while c in st: c += 1\n    print(c)\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const st = new Set(toks.slice(1, n + 1));\n    let c = 1;\n    while (st.has(c.toString())) c++;\n    console.log(c);\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Store positive elements in a hash set, check 1, 2, 3... until missing integer is found."
