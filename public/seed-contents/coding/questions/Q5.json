  "solution": {
    "code": {
      "Python3": "class Solution:\n    def longestPalindrome(self, s: str) -> str:\n        if not s: return \"\"\n        start, max_l = 0, 1\n        def expand(l, r):\n            while l >= 0 and r < len(s) and s[l] == s[r]:\n                l -= 1\n                r += 1\n            return l + 1, r - 1\n        for i in range(len(s)):\n            l1, r1 = expand(i, i)\n            if r1 - l1 + 1 > max_l:\n                start, max_l = l1, r1 - l1 + 1\n            l2, r2 = expand(i, i + 1)\n            if r2 - l2 + 1 > max_l:\n                start, max_l = l2, r2 - l2 + 1\n        return s[start:start+max_l]\n\nif __name__ == '__main__':\n    import sys, json\n    args = json.loads(sys.stdin.readline())\n    s = args[0] if isinstance(args, list) else args\n    print(json.dumps(Solution().longestPalindrome(s)))\n",
