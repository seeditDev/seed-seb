{
  "id": "earliest-moment-everyone-friends",
  "questionId": "earliest-moment-everyone-friends",
  "slug": "earliest-moment-everyone-friends",
  "title": "The Earliest Moment When Everyone Becomes Friends",
  "difficulty": "Medium",
  "category": "Union find",
  "patterns": [
    "union find",
    "connected components"
  ],
  "lists": [],
  "hints": [
    "sort the logs by timestamp first, since order matters and the input isn't sorted",
    "keep a running count of connected components, starting at n",
    "process logs in chronological order, unioning the two people in each one and decrementing the count only when the union actually merges two different groups",
    "the moment the count hits 1, that log's timestamp is your answer - stop there and return it",
    "if you finish every log and the count never reached 1, return -1"
  ],
  "commonMistakes": [
    "processing logs in their given order instead of sorting by timestamp first",
    "returning the timestamp of the last log processed instead of the first one where the count actually reaches 1",
    "not short-circuiting as soon as the group becomes fully connected, and instead scanning every remaining log"
  ],
  "content": {
    "problemStatement": "There are `n` people, labeled 0 to n-1, and a list of friendship logs,\nwhere each log is a triple `[timestamp, a, b]` meaning person `a` and\nperson `b` became friends at that timestamp. The logs are not necessarily\ngiven in chronological order.\n\n**Return the earliest timestamp at which every person is connected to every other person through some chain of friendships, or -1 if that never happens.**\n\nFriendship is transitive: a friend of your friend counts as connected too, for the purpose of this problem.\n",
    "constraints": [
      "2 <= n <= 100000",
      "0 <= logs.length <= 100000",
      "logs are not sorted by timestamp"
    ],
    "notes": [
      "logs given completely out of chronological order",
      "the group never fully connects even after all logs",
      "exactly two people with a single log connecting them",
      "extra logs after the group already became fully connected"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "logs = [[20190101,0,1],[20190104,3,4],[20190107,2,3],[20190211,1,5],[20190224,2,4],[20190301,0,3],[20190312,1,2],[20190322,4,5]], n = 6",
        "output": "20190301",
        "expectedOutput": "20190301",
        "explanation": "processing logs in chronological order, the whole group first becomes fully connected at this timestamp"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "logs = [[1,0,1],[2,2,3]], n = 4",
        "output": "-1",
        "expectedOutput": "-1",
        "explanation": "people {0,1} and {2,3} never merge into one group"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "logs = [[100,0,1]], n = 2",
        "output": "100",
        "expectedOutput": "100",
        "explanation": "the only two people become friends at timestamp 100"
      }
    ],
