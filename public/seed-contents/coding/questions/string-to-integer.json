{
  "id": "string-to-integer",
  "questionId": "string-to-integer",
  "slug": "string-to-integer",
  "title": "String to Integer (atoi)",
  "difficulty": "Medium",
  "category": "Two pointers",
  "patterns": [
    "strings",
    "simulation"
  ],
  "lists": [
    "grind-75"
  ],
  "hints": [
    "walk through the string with one index, in the exact order the spec describes: whitespace first, then an optional sign, then digits",
    "stop consuming digits the moment you hit a non-digit character, and simply ignore everything after that, don't treat it as an error",
    "build up the numeric value one digit at a time (value = value * 10 + digit) rather than slicing and using a builtin parser, so you can catch overflow as it happens instead of after the fact",
    "check for overflow before it happens: if continuing to multiply by 10 and add a digit would exceed INT_MAX (or go below INT_MIN once negative), clamp immediately and stop",
    "the only two ways to return 0 are an empty digit run (nothing but whitespace, only a sign, or garbage right away) - everything else produces some valid clamped number"
  ],
  "commonMistakes": [
    "using the language's built-in integer parser directly on a substring and letting it throw or silently misbehave on overflow instead of clamping to the 32-bit range",
    "accepting more than one sign character or a sign appearing after digits have already started",
    "not stopping at the first non-digit character and instead trying to also parse things like a following decimal point or exponent",
    "computing the full big-integer value first and clamping only at the very end, which overflows the language's native integer type for very long digit runs",
    "forgetting the case where whitespace or a lone sign is followed by no digits at all, which must return 0"
  ],
  "content": {
    "problemStatement": "Implement a function that mimics the behavior of the C-style atoi\nfunction: it converts a string to a 32-bit signed integer.\n\n**Skip any leading whitespace, then optionally consume a single '+' or '-' sign, then consume as many consecutive digits as possible to form the number's magnitude, then ignore all remaining characters and return the resulting value.**\n\nIf there are no digits to consume, the conversion fails and you should return 0. If the resulting number is outside the 32-bit signed integer range [-2147483648, 2147483647], clamp it to that range.\n",
    "constraints": [
      "0 <= s.length <= 200",
      "s consists of English letters, digits, ' ', '+', '-', and '.'",
      "the result must be clamped to the 32-bit signed integer range [-2147483648, 2147483647]"
    ],
    "notes": [
      "a string with no digits at all (return 0)",
      "a number that overflows the 32-bit signed range in either direction (clamp it)",
      "a sign character with no digits following it (return 0)",
      "leading zeros before the significant digits",
      "an empty string or a string of only whitespace"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"42\"",
        "output": "42",
        "expectedOutput": "42",
        "explanation": ""
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"   -42\"",
        "output": "-42",
        "expectedOutput": "-42",
        "explanation": "leading whitespace is skipped, then the minus sign and digits are read"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"4193 with words\"",
        "output": "4193",
        "expectedOutput": "4193",
        "explanation": "digit reading stops at the first non-digit character, and everything after is ignored"
      }
    ],
