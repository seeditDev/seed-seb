{
  "id": "number-of-connected-components",
  "questionId": "number-of-connected-components",
  "slug": "number-of-connected-components",
  "title": "Number of Connected Components",
  "difficulty": "Easy",
  "category": "Graphs",
  "patterns": [
    "graph dfs/bfs",
    "connectivity"
  ],
  "lists": [
    "blind-75"
  ],
  "hints": [
    "build an adjacency list from the edges first",
    "loop over every node from 0 to n-1; whenever you find one that hasn't been visited yet, that's the start of a brand new component",
    "run DFS or BFS from that node to mark every node in its component as visited",
    "count how many times you had to start a fresh traversal"
  ],
  "commonMistakes": [
    "forgetting nodes with no edges still count as their own component",
    "only adding edges in one direction since the graph is undirected",
    "not iterating over all n nodes, missing isolated ones that never appear in the edge list"
  ],
  "content": {
    "problemStatement": "You're given an undirected graph with n nodes labeled 0 to n-1, described by a list of `edges` where each edge is `[u, v]`.\n\n**Return the number of separate connected components in the graph.**\n",
    "constraints": [
      "1 <= n <= 2000",
      "0 <= edges.length <= n * (n - 1) / 2",
      "0 <= edges[i][0], edges[i][1] < n",
      "there are no self-loops or repeated edges"
    ],
    "notes": [
      "no edges at all",
      "single node graph",
      "graph that is fully connected in one component",
      "graph with several isolated nodes mixed with connected clusters"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "n = 5, edges = [[0,1],[1,2],[3,4]]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "nodes 0,1,2 form one component and nodes 3,4 form another"
      },
      {
        "id": "sample_2",
