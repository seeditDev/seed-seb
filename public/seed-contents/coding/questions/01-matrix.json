{
  "id": "01-matrix",
  "questionId": "01-matrix",
  "slug": "01-matrix",
  "title": "01 Matrix",
  "difficulty": "Medium",
  "category": "Graphs",
  "patterns": [
    "graph dfs/bfs",
    "multi-source bfs",
    "grid traversal"
  ],
  "lists": [
    "grind-75"
  ],
  "hints": [
    "instead of searching outward from each 1 looking for the nearest 0, search outward from ALL the 0s at once toward the 1s",
    "put every 0 cell into a queue at distance 0, then run BFS level by level",
    "each time BFS reaches a new cell through a neighbor, its distance is one more than the neighbor's distance; only visit a cell once, the first time BFS reaches it gives its minimum distance",
    "fill in the answer grid as you go, so no per-cell repeated searching is needed"
  ],
  "commonMistakes": [
    "running a separate BFS from each 1 cell instead of a single multi-source BFS from all 0 cells, which is far slower",
    "not initializing all 0 cells as sources before starting BFS, causing some searches to miss shorter paths",
    "overwriting a cell's distance after it's already been visited, when the first BFS visit is always the shortest"
  ],
  "content": {
    "problemStatement": "You're given a grid of 0s and 1s.\n\n**For each cell, find the distance to the nearest 0, and return a grid of the same size containing these distances.**\n\nDistance is measured as the minimum number of horizontal or vertical steps needed to reach any cell containing 0.\n",
    "constraints": [
      "1 <= grid.length, grid[i].length <= 10^4",
      "1 <= grid.length * grid[i].length <= 10^4",
      "grid[i][j] is 0 or 1",
      "there is at least one 0 in grid"
    ],
    "notes": [
      "grid entirely made of 0s",
      "single cell grid containing 0",
      "a 1 cell surrounded by other 1s, requiring a longer search for the nearest 0",
      "multiple 0s where different 1 cells are closest to different 0s"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "grid = [[0,0,0],[0,1,0],[0,0,0]]",
        "output": "[[0,0,0],[0,1,0],[0,0,0]]",
        "expectedOutput": "[[0,0,0],[0,1,0],[0,0,0]]",
        "explanation": "the single 1 in the center has four adjacent 0s, so its distance is 1"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "grid = [[0,0,0],[0,1,0],[1,1,1]]",
        "output": "[[0,0,0],[0,1,0],[1,2,1]]",
        "expectedOutput": "[[0,0,0],[0,1,0],[1,2,1]]",
        "explanation": "the center 1 is distance 1 from a 0 above it; the bottom-middle 1 is distance 2 away since its nearest 0 is two steps up"
      },
      {
