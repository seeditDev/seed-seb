{
  "id": "h-index",
  "questionId": "h-index",
  "slug": "h-index",
  "title": "H-Index",
  "difficulty": "Medium",
  "category": "Greedy",
  "patterns": [
    "sorting",
    "counting sort",
    "greedy"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "if you sort the citation counts, at each position in the sorted array you know exactly how many papers have at least that many remaining citations",
    "sort citations in descending order - at position i (0-indexed), there are i+1 papers with citation count >= citations[i], since everything before it is at least as large",
    "walk the sorted array and find the largest i+1 such that citations[i] >= i+1 - that value is the h-index",
    "as soon as citations[i] < i+1, no larger h is possible from this point on, since citations only get smaller - you can stop and return i",
    "if you sorted ascending instead, you can do the same check by comparing against n - i instead of i + 1, just adjust the indexing"
  ],
  "commonMistakes": [
    "sorting ascending and using the wrong index formula (n - i vs i + 1), producing an off-by-one h-index",
    "returning the citation count itself instead of the count of qualifying papers",
    "not handling the case where no paper has any citations, which should correctly yield 0, not crash on an empty check",
    "using strict greater-than instead of greater-than-or-equal when comparing citations[i] against the candidate h"
  ],
  "content": {
    "problemStatement": "You're given a list of citation counts for a researcher's papers, one\nnumber per paper, in no particular order.\n\n**Compute and return the researcher's h-index, the largest number h such that the researcher has published at least h papers that have each been cited at least h times.**\n",
    "constraints": [
      "1 <= number of papers <= 5000",
      "0 <= citations[i] <= 1000",
      "citations is given in no particular order"
    ],
    "notes": [
      "every paper has 0 citations (h-index is 0)",
      "every paper is cited at least n times, where n is the paper count (h-index caps at n)",
      "a single paper",
      "all papers have the same citation count"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "citations = [3, 0, 6, 1, 5]",
        "output": "3",
        "expectedOutput": "3",
        "explanation": "3 papers have at least 3 citations each (6, 5, 3), and the 4th-highest paper only has 1 citation, so h=4 doesn't work, but h=3 does"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "citations = [1, 3, 1]",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "at least 1 paper has at least 1 citation, but not 2 papers with at least 2 citations each"
      },
      {
