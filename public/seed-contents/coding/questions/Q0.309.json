  "solution": {
    "approach": "Print N lines where row i has prefix 1..(N-i-1) and suffix N down to (N-i).",
    "timeComplexity": "O(N^2)",
    "spaceComplexity": "O(N^2)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    for (int i = 0; i < n; i++) {\n        if (i == 0) {\n            for (int x = 1; x <= n; x++) printf(\"%d\", x);\n        } else {\n            for (int x = 1; x < n - i; x++) printf(\"%d\", x);\n            for (int x = n; x >= n - i; x--) printf(\"%d\", x);\n        }\n        putchar('\\n');\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; if (cin >> n) {\n        for (int i = 0; i < n; i++) {\n            if (i == 0) {\n                for (int x = 1; x <= n; x++) cout << x;\n            } else {\n                for (int x = 1; x < n - i; x++) cout << x;\n                for (int x = n; x >= n - i; x--) cout << x;\n            }\n            cout << \"\\n\";\n        }\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            for (int i = 0; i < n; i++) {\n                StringBuilder sb = new StringBuilder();\n                if (i == 0) {\n                    for (int x = 1; x <= n; x++) sb.append(x);\n                } else {\n                    for (int x = 1; x < n - i; x++) sb.append(x);\n                    for (int x = n; x >= n - i; x--) sb.append(x);\n                }\n                System.out.println(sb.toString());\n            }\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks:\n        n = int(toks[0])\n        for i in range(n):\n            if i == 0:\n                prefix = \"\".join(str(x) for x in range(1, n + 1))\n                suffix = \"\"\n            else:\n                prefix = \"\".join(str(x) for x in range(1, n - i))\n                suffix = \"\".join(str(x) for x in range(n, n - i - 1, -1))\n            print(prefix + suffix)\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks[0]) {\n        const n = parseInt(toks[0], 10);\n        for (let i = 0; i < n; i++) {\n            let line = \"\";\n            if (i === 0) {\n                for (let x = 1; x <= n; x++) line += x;\n            } else {\n                for (let x = 1; x < n - i; x++) line += x;\n                for (let x = n; x >= n - i; x--) line += x;\n            }\n            console.log(line);\n        }\n    }\n}\nmain();\n"
    },
