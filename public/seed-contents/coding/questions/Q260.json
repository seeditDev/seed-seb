  "content": {
    "problemStatement": "You're given a list of integers where exactly two numbers appear exactly\nonce and every other number appears exactly twice.\n\n**Return the two once-only numbers, sorted in ascending order.**",
    "constraints": [
      "2 <= nums.length <= 3 * 10^4",
      "-2^31 <= nums[i] <= 2^31 - 1",
      "each element in nums appears exactly twice, except two elements that each appear exactly once"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
