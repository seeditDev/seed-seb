  "content": {
    "problemStatement": "You're given an array of integers representing the heights of bars in a\nhistogram, each bar one unit wide and placed side by side.\n\n**Return the area of the largest rectangle that can be formed using\nonly contiguous bars, where the rectangle's height is limited by the\nshortest bar it spans.**",
    "constraints": [
      "1 <= heights.length <= 10^5",
      "0 <= heights[i] <= 10^4"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "heights = [2, 1, 5, 6, 2, 3]",
        "output": "10",
        "explanation": "bars at indices 2 and 3 (heights 5 and 6) form a rectangle of height 5 and width 2, area 10"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "heights = [2, 4]",
        "output": "4",
        "explanation": "either a single bar of height 4 and width 1 (area 4), or both bars at height 2 and width 2 (also area 4)"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "heights = [1, 1, 1, 1]",
        "output": "4",
        "explanation": "all four bars together form a rectangle of height 1 and width 4"
      }
    ],
    "notes": []
  },
