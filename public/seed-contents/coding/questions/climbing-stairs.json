  "commonMistakes": [
    "off-by-one on base cases (ways(1) vs ways(0))",
    "not recognizing the recurrence is identical to Fibonacci and re-deriving it from scratch inefficiently",
    "memoizing recursively but still paying O(n) stack depth when O(1) space was achievable"
  ],
  "content": {
    "problemStatement": "You're climbing a staircase with `n` steps. On each move you can climb either 1 step or 2 steps.\n\n**Return the number of distinct sequences of moves that get you from the bottom to the top.**\n",
    "constraints": [
      "1 <= n <= 45"
    ],
    "notes": [
      "n = 1 (1 way)",
      "n = 2 (2 ways)",
      "larger n where naive recursion becomes very slow"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
