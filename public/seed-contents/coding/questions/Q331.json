  "solution": {
    "notes": [
      "The slot-count invariant checks structural validity directly and never builds the tree.",
      "The final slot count must be exactly zero after processing every token."
    ],
    "approach": "Validate the preorder stream without reconstructing the tree. Start with one available child slot for the root. Each token consumes one slot; a non-null node then adds two new slots, while '#' adds none. If the number of available slots ever becomes negative, the serialization is invalid. The serialization is valid only if no slots remain after all tokens are processed.",
    "editorial": {
      "better": {
        "complexity": "O(n) time and O(1) auxiliary space.",
        "description": "Track the number of currently available child slots instead of storing each pending position individually. A non-null node changes the slot count by +1 overall, while '#' changes it by -1. Stop immediately if it becomes negative."
      },
      "optimal": {
        "complexity": "O(n) time and O(1) auxiliary space.",
        "description": "Use the slot-count invariant directly: start with one slot, consume one for every token, and add two whenever the token is non-null. The serialization is valid exactly when the slot count reaches zero at the end without ever becoming negative."
      },
      "bruteForce": {
        "complexity": "O(n) time and O(n) auxiliary space.",
        "description": "Parse the tokens and simulate the preorder tree with an explicit stack of pending child positions. Every token fills one pending position; non-null nodes push two child positions. This is straightforward but stores O(n) pending state."
      }
    },
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "code": {
      "Python3": "class Solution:\n    def isValidSerialization(self, preorder: str) -> bool:\n        slots = 1\n        for token in preorder.split(','):\n            slots -= 1\n            if slots < 0:\n                return False\n            if token != '#':\n                slots += 2\n        return slots == 0",
      "C": "#include <stdio.h>\n#include <string.h>\n#include <stdbool.h>\n\nbool isValidSerialization(const char* preorder) {\n    int slots = 1;\n    const char* start = preorder;\n    const char* p = preorder;\n\n    while (1) {\n        int len = 0;\n        while (p[len] != ',' && p[len] != '\\0') len++;\n\n        slots--;\n        if (slots < 0) return false;\n\n        if (!(len == 1 && start[0] == '#')) {\n            slots += 2;\n        }\n\n        if (p[len] == '\\0') break;\n        p += len + 1;\n        start = p;\n    }\n\n    return slots == 0;\n}",
      "C++": "class Solution {\npublic:\n    bool isValidSerialization(string preorder) {\n        int slots = 1;\n        string token;\n        stringstream ss(preorder);\n        while (getline(ss, token, ',')) {\n            --slots;\n            if (slots < 0) return false;\n            if (token != \"#\") ++slots, ++slots;\n        }\n        return slots == 0;\n    }\n};",
      "Java": "class Solution {\n    public boolean isValidSerialization(String preorder) {\n        int slots = 1;\n        String[] tokens = preorder.split(\",\");\n        for (String token : tokens) {\n            slots--;\n            if (slots < 0) return false;\n            if (!token.equals(\"#\")) slots += 2;\n        }\n        return slots == 0;\n    }\n}",
      "JavaScript": "process.stdin.on('data', data => {\n    const args = JSON.parse(data.toString().trim());\n    const preorder = args[0];\n\n    function isValidSerialization(preorder) {\n        let slots = 1;\n        for (const token of preorder.split(',')) {\n            slots--;\n            if (slots < 0) return false;\n            if (token !== '#') slots += 2;\n        }\n        return slots === 0;\n    }\n\n    console.log(JSON.stringify(isValidSerialization(preorder)));\n});"
    }
  },
