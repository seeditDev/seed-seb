  "solution": {
    "approach": "Print the digits of the input number separated by a space.",
    "timeComplexity": "O(D)",
    "spaceComplexity": "O(D)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    for (int i = 0; s[i]; i++) {\n        if (i > 0) putchar(' ');\n        putchar(s[i]);\n    }\n    putchar('\\n');\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s; if (!(cin >> s)) return 0;\n    for (size_t i = 0; i < s.length(); i++) {\n        if (i > 0) cout << \" \";\n        cout << s[i];\n    }\n    cout << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            StringBuilder sb = new StringBuilder();\n            for (int i = 0; i < s.length(); i++) {\n                if (i > 0) sb.append(\" \");\n                sb.append(s.charAt(i));\n            }\n            System.out.println(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks: print(\" \".join(toks[0]))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) console.log(toks[0].split(\"\").join(\" \"));\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Join the characters of the number string with a single space."
  },
