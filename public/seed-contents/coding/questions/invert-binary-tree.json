        "input": "tree = [4, 2, 7, 1, 3, 6, 9]",
        "output": "[4, 7, 2, 9, 6, 3, 1]",
        "expectedOutput": "[4, 7, 2, 9, 6, 3, 1]",
        "explanation": "at every node the left and right children swap places, recursively"
      },
