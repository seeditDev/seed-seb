  "lists": [],
  "hints": [
    "the number of rooms needed at any moment equals the number of meetings currently in progress at that moment - so what's the peak concurrency over time?",
    "split the intervals into two sorted lists: all start times and all end times",
    "walk through time using two pointers over the sorted starts and sorted ends: whenever the next start happens before the next end, a new room is needed (increment a counter); whenever the next end happens first, a room frees up (decrement the counter)",
    "track the maximum value the room counter reaches during this sweep - that's the answer. tie-break: if a start time equals an end time, process the end first since that meeting has already vacated the room"
  ],
  "commonMistakes": [
    "processing a start and an end that occur at the same time in the wrong order, incorrectly requiring an extra room for meetings that just touch at an endpoint",
    "using a heap of end times but forgetting to sort start times first, which breaks the sweep",
    "returning the count of overlapping pairs instead of the maximum concurrent meetings at any single point in time"
  ],
  "content": {
    "problemStatement": "You're given a list of meeting time `intervals`, each represented as\n`[start, end]`.\n\n**Return the minimum number of meeting rooms required so that every meeting can be scheduled without any two overlapping meetings sharing the same room.**\n",
    "constraints": [
      "each interval is [start, end] with start <= end",
      "the input is not guaranteed to be sorted",
      "the list may be empty"
    ],
    "notes": [
      "empty list of meetings (answer 0)",
      "no meetings overlap at all (answer 1, or 0 if the list is empty)",
      "all meetings overlap at one common point (answer equals the number of meetings)",
      "meetings that only touch at an endpoint (should not require an extra room)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
