  "solution": {
    "approach": "Find median of two merged sorted arrays of equal size N.",
    "timeComplexity": "O(N log N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <stdlib.h>\nint cmp(const void *a, const void *b) {\n    long long diff = *(long long*)a - *(long long*)b;\n    return (diff > 0) - (diff < 0);\n}\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long a[200005];\n    for (int i = 0; i < 2 * n; i++) scanf(\"%lld\", &a[i]);\n    qsort(a, 2 * n, sizeof(long long), cmp);\n    long long sum = a[n - 1] + a[n];\n    if (sum % 2 == 0) printf(\"%lld\\n\", sum / 2);\n    else printf(\"%.1f\\n\", (double)sum / 2.0);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    vector<long long> a(2 * n);\n    for (int i = 0; i < 2 * n; i++) cin >> a[i];\n    sort(a.begin(), a.end());\n    long long sum = a[n - 1] + a[n];\n    if (sum % 2 == 0) cout << (sum / 2) << \"\\n\";\n    else cout << ((double)sum / 2.0) << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\nimport java.util.Arrays;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long[] a = new long[2 * n];\n            for (int i = 0; i < 2 * n; i++) a[i] = sc.nextLong();\n            Arrays.sort(a);\n            long sum = a[n - 1] + a[n];\n            if (sum % 2 == 0) System.out.println(sum / 2);\n            else System.out.println((double)sum / 2.0);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    merged = sorted(int(x) for x in toks[1:2*n+1])\n    m1, m2 = merged[n - 1], merged[n]\n    if (m1 + m2) % 2 == 0: print((m1 + m2) // 2)\n    else: print((m1 + m2) / 2)\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const merged = [];\n    for (let i = 1; i <= 2 * n; i++) merged.push(BigInt(toks[i]));\n    merged.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));\n    const sum = merged[n - 1] + merged[n];\n    if (sum % 2n === 0n) console.log((sum / 2n).toString());\n    else console.log((Number(sum) / 2).toString());\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Combine both arrays, sort, and compute average of middle two elements (m1 + m2) / 2."
  },
