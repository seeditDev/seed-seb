  "lists": [],
  "hints": [
    "if a value has already appeared c times before the current position, how many NEW good pairs does the current occurrence create by itself?",
    "exactly c new pairs - one with each of the c times that value was seen before",
    "keep a hash map of value -> count seen so far. for each number, add its current count to your running answer, then increment its count in the map",
    "this avoids ever comparing pairs directly - you're just accumulating how many partners each new occurrence has among everything already seen"
  ],
  "commonMistakes": [
    "counting each pair twice by not enforcing i < j (e.g. double-counting via nested loops without the ordering constraint)",
    "incrementing the count in the map before adding it to the answer, which off-by-ones the pair count",
    "using n choose 2 on the total frequency of each value correctly, but making an arithmetic mistake in that formula if that approach is used instead"
  ],
  "content": {
    "problemStatement": "You're given an array of integers `nums`. A pair of indices (i, j) is \"good\" if `nums[i]` equals `nums[j]` and i is less than j.\n\n**Count how many good pairs exist.**\n",
    "constraints": [
      "1 <= nums.length <= 100",
      "-100 <= nums[i] <= 100",
      "the same value may repeat any number of times in nums"
    ],
    "notes": [
      "no repeated values at all (answer 0)",
      "every element is the same value",
      "a single element (no pairs possible)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
