  "content": {
    "problemStatement": "You're given a list of integers where every number appears exactly three\ntimes except for one number, which appears exactly once.\n\n**Return that lone number.**",
    "constraints": [
      "1 <= nums.length <= 3 * 10^4",
      "-2^31 <= nums[i] <= 2^31 - 1",
      "each element in nums appears exactly three times, except for one element which appears exactly once"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
