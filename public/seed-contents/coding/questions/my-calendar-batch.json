        "type": "reg",
        "input": "bookings = [[10,20],[15,25],[20,30]]",
        "output": "1",
        "expectedOutput": "1",
        "explanation": "[10,20] is accepted; [15,25] overlaps it and is rejected; [20,30] doesn't overlap [10,20] (half-open, they only touch at 20) so it's accepted"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "bookings = [[0,10],[10,20],[20,30]]",
        "output": "0",
        "expectedOutput": "0",
        "explanation": "half-open intervals that only touch at an endpoint never overlap, so all three are accepted"
