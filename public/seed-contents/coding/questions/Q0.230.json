  "solution": {
    "approach": "Count the number of odd and even elements in the array.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    int odd = 0, even = 0;\n    for (int i = 0; i < n; i++) {\n        long long x; scanf(\"%lld\", &x);\n        if (x % 2 != 0) odd++; else even++;\n    }\n    printf(\"%d %d\\n\", odd, even);\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    int odd = 0, even = 0;\n    for (int i = 0; i < n; i++) {\n        long long x; cin >> x;\n        if (x % 2 != 0) odd++; else even++;\n    }\n    cout << odd << \" \" << even << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            int odd = 0, even = 0;\n            for (int i = 0; i < n; i++) {\n                long x = sc.nextLong();\n                if (x % 2 != 0) odd++; else even++;\n            }\n            System.out.println(odd + \" \" + even);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    arr = [int(x) for x in toks[1:n+1]]\n    odd = sum(1 for x in arr if x % 2 != 0)\n    even = sum(1 for x in arr if x % 2 == 0)\n    print(f\"{odd} {even}\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    let odd = 0, even = 0;\n    for (let i = 1; i <= n; i++) {\n        if (BigInt(toks[i]) % 2n !== 0n) odd++; else even++;\n    }\n    console.log(`${odd} ${even}`);\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Iterate through elements, incrementing odd count if element % 2 != 0 and even count otherwise."
  },
