        "type": "reg",
        "input": "n = 4, edges = [[1, 0], [1, 2], [1, 3]]",
        "output": "[1]",
        "expectedOutput": "[1]",
        "explanation": "node 1 is the center of this star shape; rooting anywhere else gives a taller tree"
      },
      {
