{
  "id": "longest-increasing-path-in-matrix",
  "questionId": "longest-increasing-path-in-matrix",
  "slug": "longest-increasing-path-in-matrix",
  "title": "Longest Increasing Path in a Matrix",
  "difficulty": "Hard",
  "category": "Topological sort",
  "patterns": [
    "topological sort",
    "dag",
    "memoized dfs",
    "dynamic programming"
  ],
  "lists": [],
  "hints": [
    "if you draw a directed edge from every cell to each strictly-larger neighbor, what kind of graph do you get - could it ever contain a cycle?",
    "since values only increase along any edge, this graph is always a DAG - the longest path techniques you'd use on any DAG apply here",
    "use DFS from each cell, but memoize the answer per cell (the longest increasing path starting there) so you never recompute the same cell's answer twice",
    "a cell's answer is 1 plus the best answer among its strictly-larger neighbors (or just 1 if it has none) - this is the same topological-order DP idea, just computed lazily via memoized DFS instead of an explicit queue",
    "the final answer is the maximum memoized value across every cell"
  ],
  "commonMistakes": [
    "recomputing the DFS from scratch for every starting cell without memoization, causing exponential blowup on larger grids",
    "allowing diagonal moves, or allowing a move to an equal (not strictly greater) neighbor",
    "forgetting to take the maximum over all cells as the final answer, instead of only checking paths starting from cell (0, 0)"
  ],
  "content": {
    "problemStatement": "You're given a matrix of integers. Starting from any cell, you may move\nto an adjacent cell (up, down, left, or right, not diagonally) if and\nonly if that cell's value is strictly greater than the current cell's\nvalue. You may not revisit a cell.\n\n**Return the length (in number of cells) of the longest such strictly\nincreasing path you can build anywhere in the matrix.**\n",
    "constraints": [
      "1 <= rows, cols <= 200",
      "matrix values fit in a 32-bit signed integer",
      "movement is only up, down, left, or right, one cell at a time"
    ],
    "notes": [
      "a single cell matrix - the answer is always 1",
      "a matrix where every value is equal - no move is ever strictly increasing, so the answer is 1",
      "a single row or single column matrix",
      "the longest path doesn't necessarily start at a corner or at the matrix's minimum value"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "matrix = [[9,9,4],[6,6,8],[2,1,1]]",
        "output": "4",
        "expectedOutput": "4",
        "explanation": "the path 1 -> 2 -> 6 -> 9 (bottom-middle up through the left column) has length 4"
      },
      {
        "id": "sample_2",
