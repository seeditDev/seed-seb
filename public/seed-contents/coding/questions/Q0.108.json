      "Python3": "import sys\n\ndef solve(inp):\n    tokens = inp.strip().split()\n    if not tokens: return ''\n    n = int(tokens[0])\n    res = []\n    c = 1\n    for i in range(1, n + 1):\n        row = [str(c + j) for j in range(n)]\n        if i % 2 == 0: row.reverse()\n        res.append('*'.join(row))\n        c += n\n    return '\\n'.join(res)\n\n\ndef main():\n    s = sys.stdin.read()\n    if s.strip():\n        print(solve(s))\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\nfunction solve(inp) {\n    const tokens = inp.trim().split(/\\s+/);\n    if (!tokens || tokens.length === 0 || tokens[0] === '') return '';\n    const n = parseInt(tokens[0], 10);\n    const res = [];\n    let c = 1;\n    for (let i = 1; i <= n; i++) {\n        const row = [];\n        for (let j = 0; j < n; j++) row.push(c + j);\n        if (i % 2 === 0) row.reverse();\n        res.push(row.join('*'));\n        c += n;\n    }\n    return res.join('\\n');\n}\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) console.log(solve(s));\n}\nmain();\n"
