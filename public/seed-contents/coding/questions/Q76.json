  "solution": {
    "code": {
      "Python3": "from collections import Counter\n\nclass Solution:\n    def minWindow(self, s: str, t: str) -> str:\n        if not s or not t: return \"\"\n        need = Counter(t)\n        missing = len(t)\n        start, end = 0, 0\n        min_len = float('inf')\n        head = 0\n        while end < len(s):\n            if need[s[end]] > 0:\n                missing -= 1\n            need[s[end]] -= 1\n            end += 1\n            while missing == 0:\n                if end - start < min_len:\n                    min_len = end - start\n                    head = start\n                need[s[start]] += 1\n                if need[s[start]] > 0:\n                    missing += 1\n                start += 1\n        return \"\" if min_len == float('inf') else s[head:head+min_len]\n\nif __name__ == '__main__':\n    import sys, json\n    args = json.loads(sys.stdin.readline())\n    print(json.dumps(Solution().minWindow(args[0], args[1])))\n",
      "C": "",
      "C++": "",
      "Java": "",
      "JavaScript": ""
    },
    "approach": "Sliding window with two pointers and frequency counts to find the minimum window substring.",
