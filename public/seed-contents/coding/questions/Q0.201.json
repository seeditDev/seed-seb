  "solution": {
    "approach": "Check if second number is a circular shift of the first number.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s1[200], s2[200], double_s1[400];\n    if (scanf(\"%s %s\", s1, s2) != 2) return 0;\n    if (strlen(s1) != strlen(s2)) { printf(\"No\\n\"); return 0; }\n    strcpy(double_s1, s1); strcat(double_s1, s1);\n    if (strstr(double_s1, s2) != NULL) printf(\"Yes\\n\");\n    else printf(\"No\\n\");\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s1, s2; if (!(cin >> s1 >> s2)) return 0;\n    if (s1.length() == s2.length() && (s1 + s1).find(s2) != string::npos) cout << \"Yes\\n\";\n    else cout << \"No\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s1 = sc.next(), s2 = sc.next();\n            if (s1.length() == s2.length() && (s1 + s1).contains(s2)) System.out.println(\"Yes\");\n            else System.out.println(\"No\");\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if len(toks) >= 2:\n        s1, s2 = toks[0], toks[1]\n        print(\"Yes\" if len(s1) == len(s2) and s2 in (s1 + s1) else \"No\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks.length >= 2) {\n        const s1 = toks[0], s2 = toks[1];\n        console.log(s1.length === s2.length && (s1 + s1).includes(s2) ? \"Yes\" : \"No\");\n    }\n}\nmain();\n"
    },
