  "solution": {
    "approach": "Check if the target character is present in the input string.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1000], ch[10];\n    if (fgets(s, sizeof(s), stdin) && fgets(ch, sizeof(ch), stdin)) {\n        int l = strlen(s);\n        while (l > 0 && (s[l-1] == '\\n' || s[l-1] == '\\r')) s[--l] = '\\0';\n        char target = ch[0];\n        puts(strchr(s, target) ? \"Present\" : \"Not Present\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s, ch;\n    if (getline(cin, s) && getline(cin, ch)) {\n        cout << (s.find(ch[0]) != string::npos ? \"Present\" : \"Not Present\") << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLine()) {\n            String s = sc.nextLine();\n            if (sc.hasNextLine()) {\n                String ch = sc.nextLine();\n                System.out.println(s.contains(ch) ? \"Present\" : \"Not Present\");\n            }\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    lines = [l.strip() for l in sys.stdin.read().splitlines() if l.strip()]\n    if len(lines) >= 2:\n        print(\"Present\" if lines[1] in lines[0] else \"Not Present\")\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const lines = fs.readFileSync(0, \"utf-8\").split(/\\r?\\n/).map(l => l.trim()).filter(Boolean);\n    if (lines.length >= 2) {\n        console.log(lines[0].includes(lines[1]) ? \"Present\" : \"Not Present\");\n    }\n}\nmain();\n"
    },
