{
  "id": "number-of-provinces",
  "questionId": "number-of-provinces",
  "slug": "number-of-provinces",
  "title": "Number of Provinces",
  "difficulty": "Medium",
  "category": "Graphs",
  "patterns": [
    "graph dfs/bfs",
    "connectivity",
    "adjacency matrix"
  ],
  "lists": [],
  "hints": [
    "row i of the matrix is exactly the adjacency list of city i - isConnected[i][j] = 1 means there's an edge",
    "loop over every city; whenever you find one that hasn't been visited yet, that's a new province",
    "run DFS or BFS from that city using the matrix rows to find neighbors, marking every reachable city visited",
    "count how many times you had to start a fresh traversal"
  ],
  "commonMistakes": [
    "confusing direct connections with province membership - two cities can be in the same province without a direct edge",
    "not skipping the self-connection isConnected[i][i] correctly (it's harmless but shouldn't cause infinite loops)",
    "treating the matrix as a general grid and checking wrong neighbors instead of reading full rows"
  ],
  "content": {
    "problemStatement": "There are n cities. You're given an n x n adjacency matrix `isConnected` where `isConnected[i][j] = 1` if city i and city j are directly connected, and 0 otherwise. The matrix is symmetric, and `isConnected[i][i] = 1` for every i. A province is a group of cities that are directly or indirectly connected.\n\n**Return the total number of provinces.**\n",
    "constraints": [
      "1 <= n <= 200",
      "isConnected[i][i] = 1 for all i",
      "isConnected is symmetric"
    ],
    "notes": [
      "no city connected to any other (n separate provinces)",
      "all cities mutually connected (a single province)",
      "single city",
      "a chain of connections where indirect connectivity matters (a-b, b-c but not a-c directly)"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "isConnected = [[1,1,0],[1,1,0],[0,0,1]]",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "cities 0 and 1 are directly connected forming one province, city 2 is its own province"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "isConnected = [[1,0,0],[0,1,0],[0,0,1]]",
        "output": "3",
        "expectedOutput": "3",
        "explanation": "no city is connected to any other, so each is its own province"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "isConnected = [[1,1,1],[1,1,1],[1,1,1]]",
        "output": "1",
