  "solution": {
    "approach": "Compute sum of factorials of each digit (Krishnamurthy / Strong number component).",
    "timeComplexity": "O(D)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    long long facts[] = {1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880};\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    long long sum = 0;\n    for (int i = 0; s[i]; i++) sum += facts[s[i] - '0'];\n    printf(\"%lld\\n\", sum);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    long long facts[] = {1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880};\n    string s; if (!(cin >> s)) return 0;\n    long long sum = 0;\n    for (char c : s) sum += facts[c - '0'];\n    cout << sum << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        long[] facts = {1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880};\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            long sum = 0;\n            for (char c : s.toCharArray()) sum += facts[c - '0'];\n            System.out.println(sum);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    facts = [1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880]\n    print(sum(facts[int(c)] for c in toks[0]))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || !toks[0]) return;\n    const facts = [1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880];\n    let sum = 0;\n    for (const c of toks[0]) sum += facts[parseInt(c, 10)];\n    console.log(sum);\n}\nmain();\n"
    },
