  "solution": {
    "approach": "Left-rotate string by n % len(s) positions.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    int n; char s[1000];\n    if (scanf(\"%d %s\", &n, s) == 2) {\n        int len = strlen(s);\n        if (len == 0) return 0;\n        n %= len;\n        printf(\"%s\", s + n);\n        for (int i = 0; i < n; i++) putchar(s[i]);\n        putchar('\\n');\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    int n; string s;\n    if (cin >> n >> s) {\n        if (!s.empty()) {\n            n %= s.length();\n            cout << s.substr(n) + s.substr(0, n) << \"\\n\";\n        }\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            if (sc.hasNext()) {\n                String s = sc.next();\n                n %= s.length();\n                System.out.println(s.substring(n) + s.substring(0, n));\n            }\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    lines = [l.strip() for l in sys.stdin.read().splitlines() if l.strip()]\n    if len(lines) >= 2:\n        n = int(lines[0])\n        s = lines[1]\n        n %= len(s)\n        print(s[n:] + s[:n])\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const lines = fs.readFileSync(0, \"utf-8\").split(/\\r?\\n/).map(l => l.trim()).filter(Boolean);\n    if (lines.length >= 2) {\n        let n = parseInt(lines[0], 10);\n        const s = lines[1];\n        n %= s.length;\n        console.log(s.slice(n) + s.slice(0, n));\n    }\n}\nmain();\n"
    },
