  "solution": {
    "approach": "Swap each adjacent pair of characters in string S.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    char s[1005]; if (scanf(\"%s\", s) != 1) return 0;\n    int len = strlen(s);\n    for (int i = 0; i + 1 < len; i += 2) {\n        char tmp = s[i]; s[i] = s[i+1]; s[i+1] = tmp;\n    }\n    printf(\"%s\\n\", s);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\n#include <algorithm>\nusing namespace std;\nint main() {\n    string s; if (!(cin >> s)) return 0;\n    for (size_t i = 0; i + 1 < s.length(); i += 2) swap(s[i], s[i+1]);\n    cout << s << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            char[] s = sc.next().toCharArray();\n            for (int i = 0; i + 1 < s.length; i += 2) {\n                char tmp = s[i]; s[i] = s[i+1]; s[i+1] = tmp;\n            }\n            System.out.println(new String(s));\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if toks:\n        s = list(toks[0])\n        for i in range(0, len(s) - 1, 2): s[i], s[i+1] = s[i+1], s[i]\n        print(\"\".join(s))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (toks && toks[0]) {\n        const s = toks[0].split(\"\");\n        for (let i = 0; i + 1 < s.length; i += 2) {\n            const tmp = s[i]; s[i] = s[i+1]; s[i+1] = tmp;\n        }\n        console.log(s.join(\"\"));\n    }\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "For i = 0, 2, 4, ..., swap S[i] and S[i+1]."
  },
