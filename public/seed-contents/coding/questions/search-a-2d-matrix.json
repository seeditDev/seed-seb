{
  "id": "search-a-2d-matrix",
  "questionId": "search-a-2d-matrix",
  "slug": "search-a-2d-matrix",
  "title": "Search a 2D Matrix",
  "difficulty": "Medium",
  "category": "Binary search",
  "patterns": [
    "binary search"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "because rows follow each other in sorted order end to end, the whole grid behaves like a single sorted array of rows*cols elements",
    "you don't need to physically flatten it - if you know the number of columns, any flat index i maps to row i / cols and column i % cols",
    "run a standard binary search over flat indices from 0 to rows*cols - 1, converting to (row, col) each time you need to read a value",
    "compare the value at that (row, col) to target and shrink the flat-index range exactly like a normal binary search"
  ],
  "commonMistakes": [
    "binary searching row by row (like the row-sorted-only variant) instead of treating the grid as one sorted sequence, missing the extra structure this problem guarantees",
    "getting the row/col conversion backwards (row = i % cols, col = i / cols instead of the reverse)",
    "off-by-one on the flat index bounds, using rows*cols instead of rows*cols - 1 as the max valid index"
  ],
  "content": {
    "problemStatement": "You're given a 2D grid of integers with two properties: each row is\nsorted in ascending order, and the first element of every row is\ngreater than the last element of the row before it. Read row by row,\nleft to right, the values form one long sorted sequence.\n\n**Given a target value, determine whether it exists anywhere in the grid.**\n",
    "constraints": [
      "1 <= rows, cols <= 100",
      "-10^4 <= matrix[i][j], target <= 10^4",
      "each row is sorted in ascending order",
      "the first integer of each row is greater than the last integer of the previous row"
    ],
    "notes": [
      "target smaller than the very first element",
      "target larger than the very last element",
      "matrix with a single row or a single column"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "matrix = [[1,3,5,7],[10,11,16,20],[23,30,34,60]], target = 3",
        "output": "true",
        "expectedOutput": "true",
        "explanation": "3 is in the first row"
      },
      {
        "id": "sample_2",
        "type": "reg",
