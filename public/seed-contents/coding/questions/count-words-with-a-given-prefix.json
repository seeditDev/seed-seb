{
  "id": "count-words-with-a-given-prefix",
  "questionId": "count-words-with-a-given-prefix",
  "slug": "count-words-with-a-given-prefix",
  "title": "Count Words With a Given Prefix",
  "difficulty": "Easy",
  "category": "Trie",
  "patterns": [
    "trie",
    "string"
  ],
  "lists": [],
  "hints": [
    "checking 'starts with' for every word independently repeats the same prefix comparison work over and over - what if the words that share a prefix also shared the work of checking it?",
    "insert every word into a trie, and while inserting, increment a counter stored at each node representing how many inserted words pass through that node",
    "to answer the query, walk the trie one character at a time following pref; if you fall off the trie (a needed character has no child) the count is 0",
    "if you successfully walk the full length of pref, the counter stored at that final node is exactly your answer"
  ],
  "commonMistakes": [
    "using substring equality instead of a true 'starts with' check, e.g. comparing full string equality",
    "off-by-one errors when pref is longer than the word being checked (should just not match, not crash)",
    "forgetting that a word equal to pref itself should still be counted"
  ],
  "content": {
    "problemStatement": "You're given a space-delimited string of lowercase `words`, and a separate\nprefix string, `pref`.\n\n**Count how many of the words start with `pref` exactly.**\n",
    "constraints": [
      "1 <= number of words <= 1000",
      "1 <= each word's length <= 20",
      "1 <= pref.length <= 20",
      "words and pref consist only of lowercase English letters"
    ],
    "notes": [
      "pref is longer than some words in the list (those words can't match)",
      "pref equals an entire word exactly (that word still counts)",
      "no word in the list starts with pref"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "words = \"pay attention practice attend\", pref = \"at\"",
        "output": "2",
        "expectedOutput": "2",
        "explanation": "\"attention\" and \"attend\" both start with \"at\""
      },
      {
        "id": "sample_2",
