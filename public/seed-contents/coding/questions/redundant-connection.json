{
  "id": "redundant-connection",
  "questionId": "redundant-connection",
  "slug": "redundant-connection",
  "title": "Redundant Connection",
  "difficulty": "Easy",
  "category": "Union find",
  "patterns": [
    "union find",
    "cycle detection"
  ],
  "lists": [],
  "hints": [
    "process the edges in the given order and union each pair's endpoints",
    "since the input is a tree plus exactly one extra edge, there is exactly one point where a union would connect two nodes that are already in the same component",
    "the very first edge where find(u) == find(v) before you union them is the answer - since only one such edge exists, it is automatically both the first and last one encountered",
    "use path compression so this stays fast even for the maximum input size"
  ],
  "commonMistakes": [
    "unioning the edge that closes the cycle anyway before checking, which hides the detection",
    "forgetting nodes are 1-indexed here, sizing the union-find array off by one",
    "assuming you must scan all edges after finding the cycle-closing one - you can return as soon as you find it"
  ],
  "content": {
    "problemStatement": "A graph started out as a tree with `n` nodes, labeled 1 to `n`, connected\nby `n`-1 edges. One extra edge was then added, connecting two nodes that\nwere already connected, which created exactly one cycle. You're given the\nlist of `n` edges in the order they were added (each edge is a pair\n[u, v]).\n\n**Return the edge that can be removed to turn the graph back into a tree.**\n\nIf more than one edge could be removed to achieve this, return the one that appears last in the input list.\n",
    "constraints": [
      "n == edges.length, 3 <= n <= 1000",
      "nodes are labeled 1 to n",
      "the input describes a tree plus exactly one extra edge"
    ],
    "notes": [
      "the smallest possible input, a triangle of 3 nodes and 3 edges",
      "the redundant edge is the very last one listed",
      "the redundant edge closes a cycle spanning every node in the graph"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "edges = [[1,2],[1,3],[2,3]]",
        "output": "[2,3]",
        "expectedOutput": "[2,3]",
        "explanation": "1-2 and 1-3 already connect all three nodes; 2-3 closes the cycle"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "edges = [[1,2],[2,3],[3,4],[1,4],[1,5]]",
        "output": "[1,4]",
        "expectedOutput": "[1,4]",
        "explanation": "1-2-3-4 already forms a path; adding 1-4 closes it into a cycle"
      },
      {
