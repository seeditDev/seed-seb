  "hints": [
    "sorting works but does more work than necessary - do you actually need order?",
    "what do you really need to compare between the two strings?",
    "what if you counted how many times each character appears in each string?",
    "try one frequency map: increment for each char in s, decrement for each char in t, then check all counts are zero"
  ],
  "commonMistakes": [
    "not checking length first, wasting work comparing strings that can't possibly match",
    "using two separate frequency maps instead of one increment/decrement map (works, but discuss the tradeoff)"
  ],
  "content": {
    "problemStatement": "You're given two strings, `s` and `t`.\n\n**Determine whether `t` is an anagram of `s`, meaning `t` can be formed by rearranging all the letters of `s`, using each letter exactly as many times as it appears in `s`.**\n",
    "constraints": [
      "0 <= s.length, t.length <= 5 * 10^4",
      "s and t consist of lowercase English letters"
    ],
    "notes": [
      "strings of different lengths (always false)",
      "empty strings (true)",
      "repeated characters with different counts (e.g. 'aab' vs 'abb')"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
