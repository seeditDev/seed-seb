{
  "id": "merge-k-sorted-lists",
  "questionId": "merge-k-sorted-lists",
  "slug": "merge-k-sorted-lists",
  "title": "Merge K Sorted Lists",
  "difficulty": "Hard",
  "category": "Linked list",
  "patterns": [
    "linked list",
    "heap",
    "divide and conquer",
    "merge"
  ],
  "lists": [
    "blind-75",
    "grind-75",
    "interview-150"
  ],
  "hints": [
    "merging two sorted lists is easy with two pointers - how do you generalize 'compare the two fronts' to k lists?",
    "what data structure gives you the smallest of k candidates in O(log k) time, and lets you swap one out efficiently?",
    "put the front element of each non-empty list into a min-heap (tagged with which list it came from), repeatedly pop the smallest, append it to the result, and push the next element from that same list if one exists",
    "alternatively, merge the lists two at a time in pairs, then merge the results in pairs again, repeating until one list remains - this halves the number of lists each round"
  ],
  "commonMistakes": [
    "merging the lists one at a time into a running result (O(k) merges of growing size), which is correct but much slower than heap or pairwise merging",
    "forgetting to skip or correctly handle empty rows in lists",
    "pushing a value without also remembering which list (and position) it came from, making it impossible to fetch that list's next element"
  ],
  "content": {
    "problemStatement": "You're given `lists`, an array of k singly linked lists, each represented\nas an array of its node values in order (rows may have different\nlengths, and some rows may be empty). Every individual list is already\nsorted in non-decreasing order.\n\n**Merge all of them into one sorted list and return its values in order.**\n",
    "constraints": [
      "0 <= lists.length <= 10^4",
      "0 <= lists[i].length <= 500",
      "-10^4 <= lists[i][j] <= 10^4",
      "each lists[i] is sorted in non-decreasing order"
    ],
    "notes": [
      "lists is empty (no rows at all)",
      "lists contains only empty rows",
      "a mix of empty and non-empty rows",
      "a single row"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "lists = [[1, 4, 5], [1, 3, 4], [2, 6]]",
        "output": "[1, 1, 2, 3, 4, 4, 5, 6]",
        "expectedOutput": "[1, 1, 2, 3, 4, 4, 5, 6]",
        "explanation": "merging all three sorted lists together, keeping everything sorted"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "lists = []",
        "output": "[]",
        "expectedOutput": "[]",
        "explanation": "no lists at all"
      },
