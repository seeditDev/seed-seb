  "content": {
    "problemStatement": "You're given a string `s`.\n\n**Return the index of the first character that doesn't repeat anywhere else in the string, or -1 if every character repeats.**",
    "constraints": [
      "0 <= s.length <= 10^5",
      "s consists of only lowercase English letters"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "sampleTestCases": [
