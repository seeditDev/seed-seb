{
  "id": "remove-duplicate-letters",
  "questionId": "remove-duplicate-letters",
  "slug": "remove-duplicate-letters",
  "title": "Remove Duplicate Letters",
  "difficulty": "Medium",
  "category": "Monotonic stack",
  "patterns": [
    "monotonic stack",
    "greedy",
    "string"
  ],
  "lists": [],
  "hints": [
    "precompute the last index at which every letter appears in s. why is that useful? it tells you whether, if you skip a letter now, you'll ever get another chance to include it",
    "walk through s, building a stack of chosen letters, and also track which letters are currently on the stack so you don't add duplicates",
    "before pushing a new letter, while the top of the stack is a letter that is bigger than the new one AND that top letter still occurs again later in s (check its last-seen index against your current position), pop it - removing it now, and re-adding it later, only makes the result smaller",
    "if the current letter is already on the stack, skip it entirely (don't push a duplicate); otherwise push it and mark it as currently included"
  ],
  "commonMistakes": [
    "popping a letter from the stack even though it never reappears later in the string, permanently losing that letter",
    "forgetting to skip a letter that's already present in the stack, which would add a duplicate",
    "comparing letters directly without first checking whether the top of the stack still has a later occurrence to fall back on"
  ],
  "content": {
    "problemStatement": "You're given a string `s` of lowercase letters.\n\n**Build a result string that contains each distinct letter of `s` exactly once, choosing the lexicographically smallest such string.**\n\nThe result must be obtainable from `s` by only deleting characters (never reordering them), so the relative order of the letters you keep must match their relative order in `s`.\n",
    "constraints": [
      "s consists only of lowercase English letters",
      "1 <= s.length",
      "the result must be a valid subsequence of s (order-preserving deletion only)"
    ],
    "notes": [
      "a letter's only remaining occurrence is 'blocked' by needing to keep an earlier, larger letter that never reappears",
      "all characters in s are the same letter repeated",
      "s already has each letter appearing exactly once"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"bcabc\"",
        "output": "\"abc\"",
        "expectedOutput": "\"abc\"",
        "explanation": "the distinct letters are a, b, c; the smallest valid order obtainable by deletion alone is abc"
      },
      {
