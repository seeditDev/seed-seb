{
  "id": "palindromic-substrings",
  "questionId": "palindromic-substrings",
  "slug": "palindromic-substrings",
  "title": "Palindromic Substrings",
  "difficulty": "Medium",
  "category": "Two pointers",
  "patterns": [
    "two pointers",
    "strings",
    "dynamic programming"
  ],
  "lists": [
    "blind-75"
  ],
  "hints": [
    "instead of checking every substring, try every possible center (2n-1 of them, including between-character centers) and expand outward",
    "for each center, every successful expansion step (where the two sides still match) represents one more valid palindromic substring found",
    "so for a given center, the number of palindromes centered there equals the number of steps you can expand before the two sides mismatch or go out of bounds, including the zero-expansion base case",
    "sum the count of successful expansions across all 2n-1 centers to get the total"
  ],
  "commonMistakes": [
    "only counting odd-length palindromes and forgetting the n-1 even-length centers between characters",
    "counting distinct palindromic substrings (deduplicating by text) instead of counting every valid start/end position pair",
    "off-by-one errors that miss the single-character base case at each center"
  ],
  "content": {
    "problemStatement": "You're given a string `s`.\n\n**Count how many substrings of `s` are palindromes.**\n\nSubstrings are counted by position, not by distinct text, so if the same sequence of characters appears as a palindrome starting at two different indices, both count separately. A single character always counts as a palindrome of length 1.\n",
    "constraints": [
      "1 <= s.length <= 1000",
      "s consists of lowercase English letters only",
      "substrings are counted by starting/ending position, so repeated identical substrings each count"
    ],
    "notes": [
      "a string of all the same character (maximizes the count)",
      "a string with no repeated characters at all (count equals the length)",
      "a single character string"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "s = \"abc\"",
        "output": "3",
        "expectedOutput": "3",
        "explanation": "the only palindromic substrings are \"a\", \"b\", and \"c\""
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "s = \"aaa\"",
        "output": "6",
        "expectedOutput": "6",
        "explanation": "\"a\", \"a\", \"a\" (3 single letters), \"aa\", \"aa\" (2 overlapping pairs), and \"aaa\" itself"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "s = \"aba\"",
        "output": "4",
        "expectedOutput": "4",
        "explanation": "\"a\", \"b\", \"a\" (3 single letters) plus \"aba\" itself"
      }
    ],
