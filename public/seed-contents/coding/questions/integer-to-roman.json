{
  "id": "integer-to-roman",
  "questionId": "integer-to-roman",
  "slug": "integer-to-roman",
  "title": "Integer to Roman",
  "difficulty": "Medium",
  "category": "Greedy",
  "patterns": [
    "greedy",
    "simulation"
  ],
  "lists": [
    "interview-150"
  ],
  "hints": [
    "list out all thirteen values that matter, including the six subtractive ones: 1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1, paired with their symbols M, CM, D, CD, C, XC, L, XL, X, IX, V, IV, I",
    "walk that list from largest to smallest - for each value, while num is still at least that value, append the matching symbol and subtract the value from num",
    "because the list already includes the subtractive pairs like CM and XL as single entries, you never have to special-case detecting them separately",
    "once num reaches 0 you're done, no need to keep checking smaller values"
  ],
  "commonMistakes": [
    "only handling the seven base symbols and forgetting the six subtractive cases (IV, IX, XL, XC, CD, CM)",
    "writing four repeated symbols instead of using subtractive notation, e.g. IIII instead of IV",
    "processing values in the wrong order (not strictly largest to smallest), producing an out-of-order result",
    "off-by-one in the while loop, either skipping a value that still fits or looping forever because num was never actually decremented"
  ],
  "content": {
    "problemStatement": "Roman numerals use seven symbols (I, V, X, L, C, D, M) worth 1, 5, 10, 50,\n100, 500, and 1000. Normally symbols are written largest to smallest and\ntheir values added, but six specific cases use subtractive notation\ninstead of writing a symbol four times in a row: IV (4), IX (9), XL (40),\nXC (90), CD (400), and CM (900).\n\n**Given an integer `num`, return its roman numeral representation.**\n",
    "constraints": [
      "1 <= num <= 3999"
    ],
    "notes": [
      "num = 1 (smallest possible input, single symbol)",
      "num = 3999 (largest possible input, longest representation)",
      "num requires multiple subtractive pairs back to back, e.g. 944 = CMXLIV",
      "num is a round number like 1000 or 500 that maps to a single symbol"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "num = 3",
        "output": "\"III\"",
        "expectedOutput": "\"III\"",
        "explanation": "three ones added together"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "num = 58",
        "output": "\"LVIII\"",
        "expectedOutput": "\"LVIII\"",
        "explanation": "50 + 5 + 1 + 1 + 1 = L + V + I + I + I"
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "num = 1994",
        "output": "\"MCMXCIV\"",
        "expectedOutput": "\"MCMXCIV\"",
        "explanation": "1000 + 900 + 90 + 4 = M + CM + XC + IV"
      }
    ],
