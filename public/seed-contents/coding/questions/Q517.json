  "title": "Super Washing Machines Problem",
  "content": {
    "notes": [
      "The total number of dresses must be divisible by n for an equal distribution to be possible.",
      "Let target be the required average number of dresses per machine.",
      "When scanning left to right, the cumulative imbalance is the net number of dresses that must cross the boundary of the processed prefix.",
      "The minimum number of moves is the maximum of the positive local surplus and the absolute cumulative imbalance.",
      "Use integer arithmetic; the total number of dresses is at most 10^9."
    ],
    "constraints": [
      "n == machines.length",
      "1 <= n <= 10^4",
      "0 <= machines[i] <= 10^5"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
