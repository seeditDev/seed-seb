  "solution": {
    "approach": "Compute sum of factorials: 1! + 2! + ... + n!.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int n;\n    if (scanf(\"%d\", &n) == 1) {\n        long long sum = 0, fact = 1;\n        for (int i = 1; i <= n; i++) {\n            fact *= i;\n            sum += fact;\n        }\n        printf(\"%lld\\n\", sum);\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int n;\n    if (cin >> n) {\n        long long sum = 0, fact = 1;\n        for (int i = 1; i <= n; i++) {\n            fact *= i;\n            sum += fact;\n        }\n        cout << sum << \"\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long sum = 0, fact = 1;\n            for (int i = 1; i <= n; i++) {\n                fact *= i;\n                sum += fact;\n            }\n            System.out.println(sum);\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        n = int(s)\n        total = 0\n        fact = 1\n        for i in range(1, n + 1):\n            fact *= i\n            total += fact\n        print(total)\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const n = parseInt(s, 10);\n        let sum = 0n, fact = 1n;\n        for (let i = 1n; i <= BigInt(n); i++) {\n            fact *= i;\n            sum += fact;\n        }\n        console.log(sum.toString());\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Maintain the current factorial in each loop iteration and add it to total sum."
  },
