  "solution": {
    "approach": "Replace first element with R1 and last element with R2.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long a[100005];\n    for (int i = 0; i < n; i++) scanf(\"%lld\", &a[i]);\n    long long r1, r2; scanf(\"%lld %lld\", &r1, &r2);\n    a[0] = r1; a[n - 1] = r2;\n    for (int i = 0; i < n; i++) {\n        if (i > 0) putchar(' ');\n        printf(\"%lld\", a[i]);\n    }\n    printf(\"\\n\");\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n    long long r1, r2; cin >> r1 >> r2;\n    a.front() = r1; a.back() = r2;\n    for (int i = 0; i < n; i++) {\n        if (i > 0) cout << \" \";\n        cout << a[i];\n    }\n    cout << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long[] a = new long[n];\n            for (int i = 0; i < n; i++) a[i] = sc.nextLong();\n            long r1 = sc.nextLong(), r2 = sc.nextLong();\n            a[0] = r1; a[n - 1] = r2;\n            StringBuilder sb = new StringBuilder();\n            for (int i = 0; i < n; i++) {\n                if (i > 0) sb.append(\" \");\n                sb.append(a[i]);\n            }\n            System.out.println(sb.toString());\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    arr = toks[1:n+1]\n    r1, r2 = toks[n+1], toks[n+2]\n    arr[0] = r1; arr[-1] = r2\n    print(\" \".join(arr))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const arr = toks.slice(1, n + 1);\n    arr[0] = toks[n + 1];\n    arr[n - 1] = toks[n + 2];\n    console.log(arr.join(\" \"));\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Assign a[0] = R1 and a[n-1] = R2, then print array space-separated."
  },
