{
  "id": "capacity-to-ship-packages-within-d-days",
  "questionId": "capacity-to-ship-packages-within-d-days",
  "slug": "capacity-to-ship-packages-within-d-days",
  "title": "Capacity to Ship Packages Within D Days",
  "difficulty": "Medium",
  "category": "Binary search",
  "patterns": [
    "binary search",
    "binary search on answer"
  ],
  "lists": [],
  "hints": [
    "the search isn't over the weights array - it's over possible capacities. what's the smallest capacity that could ever work, and the largest that's ever necessary?",
    "capacity can't be smaller than the heaviest single package (that package has to fit on some day alone if needed), and never needs to exceed the sum of all weights (ship everything in one day)",
    "as capacity increases, the number of days needed to ship everything only decreases or stays the same - that's the monotonic property binary search needs",
    "for a candidate capacity, greedily pack packages onto the current day until the next one would exceed capacity, then start a new day; count days used and compare to the limit"
  ],
  "commonMistakes": [
    "setting the lower bound of the capacity search to 1 instead of the maximum single package weight, wasting search steps or even producing an infeasible capacity",
    "greedily computing days needed incorrectly, e.g. allowing a single day's load to exceed capacity",
    "forgetting that packages must ship in order, and trying to sort or rearrange them to reduce the answer"
  ],
  "content": {
    "problemStatement": "A conveyor belt has packages that must be shipped from port to port in the given order, over exactly `days` days. Each day, the ship loads consecutive packages (starting right after where the previous day left off) onto the ship, up to a fixed weight capacity that can never be exceeded on any single day.\n\n**Given the package weights and the number of days, return the minimum ship capacity that still allows every package to be shipped within `days` days.**\n",
    "constraints": [
      "1 <= days <= weights.length <= 5 * 10^4",
      "1 <= weights[i] <= 500",
      "packages must ship in the given order, never reordered",
      "each day's load is a contiguous run of packages not exceeding the chosen capacity"
    ],
    "notes": [
      "days equals the number of packages (each package ships alone, capacity must cover the heaviest one)",
      "days = 1 (capacity must cover the sum of all weights)",
      "a single package"
    ],
    "inputFormat": "Arguments passed into solution function",
    "outputFormat": "Return output matching method signature",
