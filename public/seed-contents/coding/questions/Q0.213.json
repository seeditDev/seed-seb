  "solution": {
    "approach": "Count number of elements in array strictly less than K.",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n; if (scanf(\"%d\", &n) != 1) return 0;\n    long long a[100005];\n    for (int i = 0; i < n; i++) scanf(\"%lld\", &a[i]);\n    long long k; scanf(\"%lld\", &k);\n    int count = 0;\n    for (int i = 0; i < n; i++) if (a[i] < k) count++;\n    printf(\"%d\\n\", count);\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int n; if (!(cin >> n)) return 0;\n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n    long long k; cin >> k;\n    int count = 0;\n    for (long long x : a) if (x < k) count++;\n    cout << count << \"\\n\";\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long[] a = new long[n];\n            for (int i = 0; i < n; i++) a[i] = sc.nextLong();\n            long k = sc.nextLong();\n            int count = 0;\n            for (long x : a) if (x < k) count++;\n            System.out.println(count);\n        }\n    }\n}\n",
      "Python3": "import sys\ndef main():\n    toks = sys.stdin.read().split()\n    if not toks: return\n    n = int(toks[0])\n    arr = [int(x) for x in toks[1:n+1]]\n    k = int(toks[n+1])\n    print(sum(1 for x in arr if x < k))\nif __name__ == \"__main__\": main()\n",
      "JavaScript": "const fs = require(\"fs\");\nfunction main() {\n    const toks = fs.readFileSync(0, \"utf-8\").trim().split(/\\s+/);\n    if (!toks || toks.length === 0 || toks[0] === \"\") return;\n    const n = parseInt(toks[0], 10);\n    const k = BigInt(toks[n + 1]);\n    let count = 0;\n    for (let i = 1; i <= n; i++) if (BigInt(toks[i]) < k) count++;\n    console.log(count);\n}\nmain();\n"
    },
    "notes": "Ensure standard I/O format handling.",
    "editorial": "Iterate through N elements, counting those strictly less than threshold K."
  },
