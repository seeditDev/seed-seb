  "solution": {
    "approach": "FizzBuzz style branching: divisible by 3 and 5 -> HiHello, by 3 -> Hi, by 5 -> Hello.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int n;\n    if (scanf(\"%d\", &n) == 1) {\n        if (n % 15 == 0) printf(\"HiHello\\n\");\n        else if (n % 3 == 0) printf(\"Hi\\n\");\n        else if (n % 5 == 0) printf(\"Hello\\n\");\n    }\n    return 0;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int n;\n    if (cin >> n) {\n        if (n % 15 == 0) cout << \"HiHello\\n\";\n        else if (n % 3 == 0) cout << \"Hi\\n\";\n        else if (n % 5 == 0) cout << \"Hello\\n\";\n    }\n    return 0;\n}\n",
      "Java": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            if (n % 15 == 0) System.out.println(\"HiHello\");\n            else if (n % 3 == 0) System.out.println(\"Hi\");\n            else if (n % 5 == 0) System.out.println(\"Hello\");\n        }\n    }\n}\n",
      "Python3": "import sys\n\ndef main():\n    s = sys.stdin.read().strip()\n    if s:\n        n = int(s)\n        if n % 15 == 0: print(\"HiHello\")\n        elif n % 3 == 0: print(\"Hi\")\n        elif n % 5 == 0: print(\"Hello\")\n\nif __name__ == '__main__':\n    main()\n",
      "JavaScript": "const fs = require('fs');\n\nfunction main() {\n    const s = fs.readFileSync(0, 'utf-8').trim();\n    if (s.length > 0) {\n        const n = parseInt(s, 10);\n        if (n % 15 === 0) console.log(\"HiHello\");\n        else if (n % 3 === 0) console.log(\"Hi\");\n        else if (n % 5 === 0) console.log(\"Hello\");\n    }\n}\n\nmain();\n"
    },
    "notes": "Ensure edge case and standard I/O format handling.",
    "editorial": "Check divisibility by 15 first for 'HiHello', then by 3 for 'Hi', then by 5 for 'Hello'."
  },
