  "content": {
    "problemStatement": "You're given a string.\n\n**Return it reversed.**\n\nDo not use a built-in reverse function or slicing trick, the point is to do the swapping yourself with two pointers.",
    "constraints": [
      "0 <= s.length <= 10^5",
      "s consists of printable ASCII characters"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
